---
import "../styles/global.css";
const {
  title = "Eric Martin — Sales Leadership & Business Development",
  description = "Eric Martin brings customer understanding, commercial ownership, and operational experience to sales leadership and business development.",
  type = "website",
  noindex = false
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const navigation = [
  { href: "/work", label: "Sales & growth", active: path.startsWith("/work") },
  { href: "/abs-tooling", label: "ABS Console", active: path === "/abs-tooling" },
  { href: "/technical-projects", label: "Projects", active: path.startsWith("/technical-projects") || path === "/eden" },
  { href: "/about", label: "About", active: ["/about", "/skills"].includes(path) || path.startsWith("/blog") },
  { href: "/resume", label: "Resume", active: path === "/resume" }
];
const moreWork = [
  { href: "/work", label: "Sales & growth results" },
  { href: "/abs-tooling", label: "ABS Console" },
  { href: "/technical-projects", label: "Projects & engineering" },
  { href: "/skills", label: "Skills & capabilities" },
  { href: "/resume", label: "Resume" },
  { href: "/blog", label: "Insights" }
];
const aboutLinks = [
  { href: "/about", label: "My background", detail: "Experience, principles, and life outside work" },
  { href: "/skills", label: "Skills & capabilities", detail: "Sales, operations, and hands-on engineering" },
  { href: "/blog", label: "Insights", detail: "Notes on building and growing a business" }
];
const isContact = path === "/contact";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#152e27" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="author" content="Eric Martin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Eric Martin" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="flex min-h-screen flex-col text-ink">
    <a href="#main-content" class="focus-ring sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:text-ink">Skip to content</a>
    <header class="site-header">
      <div class="page-container header-row">
        <a href="/" class="wordmark" aria-label="Eric Martin home">
          <span class="wordmark-symbol" aria-hidden="true">em.</span>
          <span><span class="wordmark-name">Eric Martin</span><span class="wordmark-caption">Sales leadership · Business development</span></span>
        </a>
        <nav aria-label="Main navigation" class="desktop-nav">
          {navigation.map((item) => item.href === "/about" ? (
            <details class="nav-disclosure" data-nav-disclosure>
              <summary class:list={["nav-link", item.active && "nav-link-active"]}>About <span class="menu-chevron" aria-hidden="true">⌄</span></summary>
              <div class="nav-dropdown">
                {aboutLinks.map((link) => <a href={link.href} aria-current={path === link.href ? "page" : path.startsWith(`${link.href}/`) ? "location" : undefined}><span>{link.label}</span><small>{link.detail}</small></a>)}
              </div>
            </details>
          ) : <a href={item.href} class="nav-link" aria-current={item.active ? (path === item.href ? "page" : "location") : undefined}>{item.label}</a>)}
        </nav>
        <a href="/contact" class="button-primary desktop-contact" aria-current={isContact ? "page" : undefined}>Let's talk <span aria-hidden="true">↗</span></a>
        <details class="mobile-menu" data-nav-disclosure>
          <summary>Menu <span class="menu-icon" aria-hidden="true"><span></span><span></span></span></summary>
          <nav aria-label="Mobile navigation">
            <p class="eyebrow mobile-nav-label">Explore the work</p>
            {navigation.map((item) => <a href={item.href} class="nav-link" aria-current={path === item.href ? "page" : item.active && item.href !== "/about" ? "location" : undefined}>{item.label}<span aria-hidden="true">→</span></a>)}
            <div class="mobile-nav-secondary">
              {aboutLinks.slice(1).map((item) => <a class="nav-link" href={item.href} aria-current={path === item.href ? "page" : path.startsWith(`${item.href}/`) ? "location" : undefined}>{item.label}<span aria-hidden="true">→</span></a>)}
            </div>
            <a class="button-primary mt-2" href="/contact" aria-current={isContact ? "page" : undefined}>Let's talk <span aria-hidden="true">↗</span></a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main-content" tabindex="-1" class="flex-1 outline-none"><slot /></main>
    <footer class="site-footer section-dark">
      <div class="page-container">
        {!isContact && <div class="footer-top">
          <div class="max-w-2xl">
            <p class="eyebrow">The next conversation</p>
            <h2 class="mt-4 text-3xl font-medium leading-tight tracking-tight text-white sm:text-4xl">Need someone who can win the work<br class="hidden sm:block" /> and see it through?</h2>
          </div>
          <a class="button-primary shrink-0" href="/contact">Discuss a leadership role <span aria-hidden="true">↗</span></a>
        </div>}
        <div class="footer-grid">
          <div>
            <a href="/" class="text-xl font-semibold tracking-tight text-white">Eric Martin<span class="text-mint">.</span></a>
            <p class="mt-4 max-w-xs text-sm leading-relaxed">Sales and business development, grounded in field operations and hands-on engineering.</p>
          </div>
          <nav aria-label="More work">
            <h2 class="eyebrow">Explore</h2>
            <ul class="mt-4 grid gap-2 text-sm">
              {moreWork.map((item) => <li><a class="inline-flex py-1" href={item.href}>{item.label}</a></li>)}
            </ul>
          </nav>
          <div>
            <h2 class="eyebrow">Connect</h2>
            <ul class="mt-4 grid gap-3 text-sm">
              <li><a class="break-all" href="mailto:ericm93.2023@outlook.com">ericm93.2023@outlook.com</a></li>
              <li><a href="tel:+13162149102">(316) 214-9102</a></li>
              <li><a href="https://www.linkedin.com/in/eric-m-53b374174/">LinkedIn ↗</a></li>
              <li><a href="/about">A little more about me →</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-meta"><p>© {new Date().getFullYear()} Eric Martin</p><a href="#main-content">Back to top <span aria-hidden="true">↑</span></a></div>
      </div>
    </footer>
    <script>
      const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-nav-disclosure]'));
      const closeMenu = (menu: HTMLDetailsElement, restoreFocus = false) => {
        menu.open = false;
        if (restoreFocus) menu.querySelector('summary')?.focus();
      };
      menus.forEach((menu) => {
        menu.addEventListener('toggle', () => {
          if (menu.open) menus.filter((other) => other !== menu).forEach((other) => closeMenu(other));
        });
        menu.addEventListener('focusout', (event) => {
          if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) closeMenu(menu);
        });
        menu.addEventListener('click', (event) => {
          if (event.target instanceof Element && event.target.closest('a')) closeMenu(menu);
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') menus.filter((menu) => menu.open).forEach((menu) => closeMenu(menu, true));
      });
      document.addEventListener('click', (event) => {
        if (event.target instanceof Node) {
          const target = event.target;
          menus.filter((menu) => menu.open && !menu.contains(target)).forEach((menu) => closeMenu(menu));
        }
      });
      matchMedia('(max-width: 1099px)').addEventListener('change', () => menus.forEach((menu) => closeMenu(menu, menu.contains(document.activeElement))));
    </script>
  </body>
</html>
