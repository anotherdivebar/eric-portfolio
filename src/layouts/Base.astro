---
import "../styles/global.css";

const {
  title = "Eric Martin - Revenue Operations and Strategic Systems",
  description =
    "Revenue operations and strategic systems leader. Customer acquisition, pipeline visibility, workflow design, internal tooling, forecasting, and practical operator-facing systems."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
  </head>
  <body class="text-ink">
    <a
      href="#main-content"
      class="focus-ring sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:text-ink"
    >
      Skip to content
    </a>
    <header class="sticky top-0 z-20 border-b border-white/60 bg-white/80 backdrop-blur-xl shadow-[0_10px_30px_rgba(15,23,42,0.08)]">
      <div class="page-container flex items-center justify-between gap-6 py-4">
        <a href="/" class="focus-ring text-lg font-semibold tracking-wide">Eric Martin</a>
        <nav class="hidden flex-wrap gap-4 text-sm text-muted md:flex">
          <a href="/technical-projects" class="focus-ring hover:text-ink">Projects</a>
          <a href="/skills" class="focus-ring hover:text-ink">Skills</a>
          <a href="/resume" class="focus-ring hover:text-ink">Resume</a>
          <a href="/eden" class="focus-ring hover:text-ink">Eden</a>
          <a href="/about" class="focus-ring hover:text-ink">About</a>
          <a href="/contact" class="focus-ring hover:text-ink">Contact</a>
        </nav>
        <div class="flex items-center gap-4">
          <a
            class="focus-ring hidden text-sm font-semibold text-muted transition hover:text-ink md:inline-flex"
            href="tel:+13162508333"
          >
            (316) 250-8333
          </a>
          <a
            href="/contact"
            class="focus-ring inline-flex items-center justify-center rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white transition hover:bg-accent-dark"
          >
            Let's Talk
          </a>
        </div>
      </div>
      <div class="border-t border-border md:hidden">
        <div class="page-container flex flex-wrap items-center gap-4 py-2 text-sm text-muted">
          <a href="/technical-projects" class="focus-ring hover:text-ink">Projects</a>
          <a href="/skills" class="focus-ring hover:text-ink">Skills</a>
          <a href="/resume" class="focus-ring hover:text-ink">Resume</a>
          <a href="/eden" class="focus-ring hover:text-ink">Eden</a>
          <a href="/about" class="focus-ring hover:text-ink">About</a>
          <a href="/contact" class="focus-ring hover:text-ink">Contact</a>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="mt-8 border-t border-white/10 bg-[#0b1320] py-8 text-sm text-slate-300">
      <div class="page-container flex flex-wrap items-center justify-between gap-4">
        <p>(c) 2026 Eric Martin. Building revenue systems that turn strategy into execution.</p>
        <div class="flex flex-wrap items-center gap-4 text-sm">
          <a class="focus-ring hover:text-white" href="mailto:ericm93.2023@outlook.com">
            ericm93.2023@outlook.com
          </a>
          <a class="focus-ring hover:text-white" href="tel:+13162508333">
            (316) 250-8333
          </a>
          <a class="focus-ring hover:text-white" href="https://www.linkedin.com/in/eric-m-53b374174/">
            LinkedIn
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
