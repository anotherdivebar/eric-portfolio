---
import Base from "../../layouts/Base.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("case-studies");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<"case-studies">;
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const sections = headings.filter((heading) => heading.depth === 2);
const isCaseStudy = ["kansas-electric", "program-delivery-at-scale"].includes(entry.slug);
---

<Base title={`${entry.data.title} - Eric Martin`} description={entry.data.summary}>
  <section class="pb-10 pt-10 sm:pt-14">
    <div class="page-container">
      <a href="/work" class="focus-ring inline-flex text-sm font-semibold text-accent hover:text-accent-dark">← All work & approaches</a>
      <div class="mt-6 max-w-4xl">
        <p class="eyebrow">{isCaseStudy ? "Case study" : "Operating approach"} / {entry.data.category}</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">{entry.data.title}</h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">{entry.data.summary}</p>
      </div>
      <div class="surface-muted mt-7 p-6 sm:p-8">
        <h2 class="eyebrow">{isCaseStudy ? "Commercial context" : "What this approach supports"}</h2>
        <p class="mt-3 max-w-4xl text-lg font-semibold leading-relaxed text-ink">{entry.data.impact}</p>
        <dl class="mt-6 grid gap-6 border-t border-border pt-5 md:grid-cols-2">
          <div><dt class="text-sm font-semibold text-ink">Scope</dt><dd class="mt-2 text-sm leading-relaxed text-muted">{entry.data.scope}</dd></div>
          <div><dt class="text-sm font-semibold text-ink">{isCaseStudy ? "My ownership" : "Responsibilities"}</dt><dd class="mt-2 text-sm leading-relaxed text-muted">{entry.data.ownership}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <div class:list={["page-container grid items-start gap-8 pb-16", sections.length > 0 && "lg:grid-cols-[210px_minmax(0,1fr)] lg:gap-12"]}>
    {sections.length > 0 && (
      <aside class="rounded-2xl border border-border bg-white p-5 lg:sticky lg:top-28 lg:max-h-[calc(100vh-9rem)] lg:overflow-y-auto">
        <p id="work-contents" class="eyebrow">On this page</p>
        <nav aria-labelledby="work-contents" class="mt-4 flex flex-wrap gap-x-5 gap-y-3 lg:flex-col">
          {sections.map((heading) => (
            <a class="focus-ring text-sm leading-relaxed text-muted transition hover:text-accent" href={`#${heading.slug}`}>{heading.text}</a>
          ))}
        </nav>
      </aside>
    )}
    <div class="min-w-0">
      <article class="work-story prose max-w-none">
        <Content />
      </article>
      <div class="surface-muted mt-12 p-6 sm:p-8">
        <h2 class="text-xl font-semibold text-ink">{isCaseStudy ? "More connected systems" : "See the software behind the approach"}</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">ABS Tooling brings prospect research, delivery planning, finance, and reviewable automation into one workspace. Explore the implementation and its current rollout boundaries.</p>
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-3">
          <a href="/abs-tooling" class="focus-ring text-sm font-semibold text-accent hover:text-accent-dark">Explore ABS Tooling →</a>
          <a href="/contact" class="focus-ring text-sm font-semibold text-accent hover:text-accent-dark">Talk about a similar challenge →</a>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .work-story :global(h2) {
    scroll-margin-top: 11rem;
  }
  .work-story :global(h2:first-child) {
    margin-top: 0;
  }
</style>
