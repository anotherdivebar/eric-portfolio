---
import Base from "../../layouts/Base.astro";
import PageContents from "../../components/PageContents.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("case-studies");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<"case-studies">;
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const sections = headings.filter((heading) => heading.depth === 2);
const resultsAnchors: Record<string, string> = {
  "kansas-electric": "commercial-results-and-system-outcomes",
  "program-delivery-at-scale": "business-context"
};
const resultsAnchor = resultsAnchors[entry.slug];
---

<Base title={`${entry.data.title} | Eric Martin`} description={entry.data.summary}>
  <section class="page-heading">
    <div class="page-container">
      <a href="/work" class="text-link">← Sales & growth results</a>
      <div class="mt-10 max-w-4xl sm:mt-12">
        <p class="eyebrow">{entry.data.category}</p>
        <h1 class="page-title mt-5">{entry.data.title}</h1>
        {resultsAnchor ? (
          <div id={resultsAnchor}>
            <p class="page-intro mt-7">{entry.data.impact}</p>
            <p class="mt-5 text-sm leading-relaxed text-muted">{entry.data.ownership} · {entry.data.scope}</p>
          </div>
        ) : (
          <p class="page-intro mt-7">{entry.data.summary}</p>
        )}
      </div>
    </div>
  </section>

  <div class:list={["page-container grid items-start gap-10 pb-16 sm:pb-24", sections.length > 0 && "lg:grid-cols-[210px_minmax(0,1fr)] lg:gap-16"]}>
    {sections.length > 0 && (
      <aside class="lg:sticky lg:top-28">
        <PageContents headings={sections} />
      </aside>
    )}
    <div class="min-w-0">
      <article class="work-story prose max-w-none">
        <Content />
      </article>
      <nav aria-label="Related portfolio pages" class="mt-14 flex flex-wrap gap-x-6 gap-y-3 border-t border-border pt-5">
        <a href="/contact" class="text-link">Contact Eric</a>
        {resultsAnchor && <a href="/abs-tooling" class="text-link">Explore ABS Console</a>}
      </nav>
    </div>
  </div>
</Base>

<style>
  .work-story :global([id]) { scroll-margin-top: 9rem; }
  .work-story :global(h2) {
    margin-top: 2.75rem;
    padding-top: 2rem;
    border-top: 1px solid #d9dfd7;
  }
  .work-story :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
</style>
