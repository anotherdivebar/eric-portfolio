---
import Base from "../../layouts/Base.astro";
import PageContents from "../../components/PageContents.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("case-studies");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<"case-studies">;
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const sections = headings.filter((heading) => heading.depth === 2);
const isCaseStudy = ["kansas-electric", "program-delivery-at-scale"].includes(entry.slug);
---

<Base title={`${entry.data.title} | Eric Martin`} description={entry.data.summary}>
  <section class="page-heading">
    <div class="page-container">
      <a href="/work" class="text-link">← Sales & growth results</a>
      <div class="mt-10 max-w-4xl sm:mt-12">
        <p class="eyebrow">{entry.data.category}</p>
        <h1 class="page-title mt-5">{entry.data.title}</h1>
        <p class="page-intro mt-7">{entry.data.summary}</p>
      </div>
      <div class="mt-10 grid gap-8 border-y border-border py-8 md:grid-cols-[1.15fr_0.85fr] md:gap-12 sm:mt-12 sm:py-10">
        <div>
          <h2 class="eyebrow">{isCaseStudy ? "Results & my contribution" : "What it helps the team do"}</h2>
          <p class="mt-4 text-xl font-medium leading-relaxed text-ink sm:text-2xl">{entry.data.impact}</p>
        </div>
        <dl class="grid gap-6">
          <div><dt class="eyebrow">Scope</dt><dd class="mt-3 text-sm leading-relaxed text-muted">{entry.data.scope}</dd></div>
          <div><dt class="eyebrow">{isCaseStudy ? "My role" : "Responsibilities"}</dt><dd class="mt-3 text-sm leading-relaxed text-muted">{entry.data.ownership}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <div class:list={["page-container grid items-start gap-10 pb-16 sm:pb-24", sections.length > 0 && "lg:grid-cols-[210px_minmax(0,1fr)] lg:gap-16"]}>
    {sections.length > 0 && (
      <aside class="lg:sticky lg:top-28">
        <PageContents headings={sections} />
      </aside>
    )}
    <div class="min-w-0">
      <article class="work-story prose max-w-none">
        <Content />
      </article>
      <div class="surface-muted mt-14 p-7 sm:p-9">
        <h2 class="mt-4 text-2xl font-semibold text-ink">{isCaseStudy ? "Get in touch" : "How this works in ABS Console"}</h2>
        <p class="mt-4 leading-relaxed text-muted">{isCaseStudy ? "If you’re hiring for sales or business development, I’d like to hear about your customers and the work you want to win." : "The Console case study shows how I connect prospect research, sales, job planning, and billing. It also covers what the current release supports."}</p>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
          <a href="/contact" class="text-link">Contact Eric <span aria-hidden="true">↗</span></a>
          <a href="/abs-tooling" class="text-link">Explore ABS Console <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .work-story :global(h2) {
    scroll-margin-top: 9rem;
    margin-top: 2.75rem;
    padding-top: 2rem;
    border-top: 1px solid #d9dfd7;
  }
  .work-story :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
</style>
