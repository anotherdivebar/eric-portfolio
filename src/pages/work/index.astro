---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const caseStudies = (await getCollection("case-studies")).sort(
  (a, b) => a.data.order - b.data.order
);
const kansasElectric = caseStudies.find((study) => study.slug === "kansas-electric");
const programDelivery = caseStudies.find((study) => study.slug === "program-delivery-at-scale");
const operatingExamples = caseStudies.filter((study) => !["kansas-electric", "program-delivery-at-scale"].includes(study.slug));
---

<Base title="Work & Case Studies - Eric Martin" description="Explore Eric Martin’s ABS Tooling and Kansas Electric builds, plus short writeups on revenue operations, automation, and program delivery.">
  <section class="py-12 sm:py-16">
    <div class="page-container">
      <div class="max-w-3xl">
        <p class="eyebrow mb-3">Work / systems and operations</p>
        <h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">From business problem to working system.</h1>
        <p class="mt-5 text-lg leading-relaxed text-muted">The detailed builds show the software, workflows, and decisions behind the work. The shorter operating writeups describe how I approach ownership, handoffs, and delivery.</p>
      </div>

      <section class="mt-10" aria-labelledby="case-studies-heading">
        <h2 id="case-studies-heading" class="text-2xl font-semibold text-ink">Inside the builds</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          <article class="section-dark flex flex-col rounded-2xl border border-slate-800 p-6 text-white sm:p-8">
            <p class="eyebrow">Atlas-Beren Systems / featured build</p>
            <h3 class="mt-3 text-2xl font-semibold">ABS Tooling</h3>
            <p class="mt-4 flex-1 leading-relaxed text-slate-300">Prospect research, outreach, project delivery, finance, and connected operations in the Atlas-Beren Console. A detailed look at workflows, architecture, screenshots, and rollout boundaries.</p>
            <a class="focus-ring mt-6 inline-flex font-semibold text-white underline decoration-white/40 underline-offset-4 hover:decoration-white" href="/abs-tooling">Explore ABS Tooling →</a>
          </article>
          {kansasElectric && (
            <article class="surface flex flex-col p-6 sm:p-8">
              <p class="eyebrow">Kansas Electric / commercial systems</p>
              <h3 class="mt-3 text-2xl font-semibold text-ink">{kansasElectric.data.title}</h3>
              <p class="mt-4 leading-relaxed text-muted">{kansasElectric.data.summary}</p>
              <p class="mt-4 flex-1 text-sm leading-relaxed text-ink">{kansasElectric.data.impact}</p>
              <a class="focus-ring mt-6 inline-flex font-semibold text-accent hover:text-accent-dark" href="/work/kansas-electric">Explore Kansas Electric →</a>
            </article>
          )}
        </div>
      </section>

      {programDelivery && (
        <article class="surface-muted mt-8 p-6 sm:p-8">
          <p class="eyebrow">Vale Field Services / July 2019–October 2024</p>
          <h2 class="mt-3 text-2xl font-semibold">{programDelivery.data.title}</h2>
          <p class="mt-3 max-w-3xl leading-relaxed text-muted">{programDelivery.data.summary}</p>
          <a class="focus-ring mt-5 inline-flex text-sm font-semibold text-accent hover:text-accent-dark" href="/work/program-delivery-at-scale">Read about national program delivery →</a>
        </article>
      )}

      <section class="mt-12" aria-labelledby="operating-heading">
        <h2 id="operating-heading" class="text-2xl font-semibold text-ink">Operating approaches</h2>
        <p class="mt-3 max-w-3xl text-muted">Short writeups on the structure behind revenue and delivery work: what needs to be clear, what should be automated, and where a team needs visibility.</p>
        <div class="mt-6 grid gap-5 md:grid-cols-2">
          {operatingExamples.map((study) => (
            <article class="surface flex flex-col p-6">
              <p class="eyebrow">{study.data.category}</p>
              <h3 class="mt-3 text-xl font-semibold text-ink">{study.data.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{study.data.summary}</p>
              <a class="focus-ring mt-5 inline-flex text-sm font-semibold text-accent hover:text-accent-dark" href={`/work/${study.slug}`} aria-label={`Read ${study.data.title}`}>Read the approach →</a>
            </article>
          ))}
        </div>
      </section>

      <div class="mt-10 flex flex-wrap gap-x-6 gap-y-3 border-t border-border pt-7">
        <a class="focus-ring text-sm font-semibold text-accent hover:text-accent-dark" href="/technical-projects">Browse all projects →</a>
        <a class="focus-ring text-sm font-semibold text-accent hover:text-accent-dark" href="/resume">Read my professional background →</a>
      </div>
    </div>
  </section>
</Base>
