---
import Base from "../../layouts/Base.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import { getCollection } from "astro:content";

const caseStudies = (await getCollection("case-studies")).sort((a, b) => a.data.order - b.data.order);
const results = {
  "kansas-electric": {
    years: "2024–2025",
    value: "$2M",
    context: "in new work I closed in my first 60 days",
    description: "I took over sales from project managers. A relationship I’d built at Vale helped me win Walmart emergency lighting and relay work in the Midwest and Southeast.",
    link: "Read the Kansas Electric case study",
  },
  "program-delivery-at-scale": {
    years: "2019–2024",
    value: "$4M",
    context: "in annual revenue at a company I helped grow",
    description: "I was Vale’s first employee. I started in the field and went on to lead operations for a 35-person company installing technology in hundreds of restaurants.",
    link: "Read the Vale case study",
  },
};
const commercialStories = caseStudies.flatMap((study) => {
  const result = results[study.slug as keyof typeof results];
  return result ? [{ study, result }] : [];
});
const operatingExamples = caseStudies.filter((study) => !(study.slug in results));
---

<Base title="Sales & Growth Results | Eric Martin" description="Eric Martin’s work in sales and business development at Kansas Electric, operational growth at Vale Field Services, and product development at Atlas-Beren Systems.">
  <div class="page-container">
    <header class="work-intro">
      <h1 class="page-title">Sales and<br /><em>field operations.</em></h1>
    </header>

    <section id="case-studies-heading" class="result-spread" aria-label="Commercial results and case studies">
      {commercialStories.map(({ study, result }) => (
        <article class:list={["result", study.slug === "kansas-electric" && "result-ink"]}>
          <header class="result-meta">
            <h2>{study.data.title}</h2>
            <span>{result.years}</span>
          </header>
          <p class="result-value"><span class="sr-only">Approximately </span><span class="approx" aria-hidden="true">~</span>{result.value}</p>
          <p class="result-context">{result.context}</p>
          <div class="result-detail">
            <p>{result.description}</p>
            <a class="story-link" href={`/work/${study.slug}`}>{result.link}</a>
          </div>
        </article>
      ))}
    </section>

    <article class="founder">
      <div class="founder-copy">
        <p class="eyebrow">Founder, Atlas-Beren Systems · Since January 2026</p>
        <h2 class="section-title">Building ABS Console</h2>
        <p>I built the sales pipeline shown here for trade and field-service businesses. A manager can open a submitted forecast and compare it with the deals the team went on to win.</p>
        <a href="/abs-tooling" class="button-secondary">Explore ABS Console</a>
      </div>
      <figure class="founder-figure">
        <div class="pipeline-preview">
          <OptimizedImage src="/assets/abs-console/sales-pipeline.png" width="1265" height="1523" alt="The ABS Console sales pipeline showing sample opportunities, forecast controls, and deal stages" sizes="(max-width: 760px) 86vw, (max-width: 1264px) 45vw, 540px" />
        </div>
        <figcaption>ABS Console <span>Sales pipeline · Demo workspace</span></figcaption>
      </figure>
    </article>

    <section class="operating section-space" aria-labelledby="operating-heading">
      <div>
        <h2 id="operating-heading" class="section-title">Sales forecasts and lead routing</h2>
      </div>
      <div>
        {operatingExamples.map((study) => (
          <article class="approach">
            <p class="eyebrow">{study.data.category}</p>
            <h3 class="mt-2 text-2xl font-semibold"><a class="focus-ring underline decoration-border underline-offset-4 hover:text-accent" href={`/work/${study.slug}`}>{study.data.title}</a></h3>
            <p class="mt-3 leading-relaxed text-muted">{study.data.summary}</p>
          </article>
        ))}
      </div>
    </section>

    <nav class="work-next" aria-label="Related portfolio pages">
      <a class="text-link" href="/technical-projects">Browse all projects</a>
      <a class="text-link" href="/resume">View my resume</a>
    </nav>
  </div>
</Base>

<style>
  .work-intro { padding-block: clamp(3rem, 6.5vw, 6rem) clamp(2.5rem, 5vw, 4.5rem); }
  .page-title em { color: var(--accent); }
  .result-spread { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: hidden; border-radius: 1rem; }
  .result { --result-ink: #153834; --result-muted: #385c56; --result-rule: #aacac0; display: flex; flex-direction: column; padding: clamp(1.5rem, 3.9vw, 3.7rem); background: #d7eee5; color: var(--result-ink); }
  .result-ink { --result-ink: #f0faf7; --result-muted: #bdd5d0; --result-rule: #395752; background: var(--night); }
  .result-meta { display: flex; align-items: baseline; justify-content: space-between; gap: 1.25rem; }
  .result-meta h2 { font-size: clamp(1.12rem, 1.65vw, 1.5rem); font-weight: 600; }
  .result-meta > span { flex: none; font-family: ui-monospace, monospace; font-size: .81rem; color: var(--result-muted); }
  .result-value { margin-top: clamp(2rem, 5vw, 4rem); font-size: clamp(4.6rem, 9vw, 8rem); font-weight: 500; letter-spacing: -.09em; line-height: .92; }
  .result-ink .result-value { color: var(--mint); }
  .approx { display: inline-block; margin-right: .08em; font-family: Georgia, serif; font-weight: 400; font-size: .56em; vertical-align: .16em; }
  .result-context { max-width: 29ch; margin-block: .9rem 1.8rem; font-size: clamp(1.05rem, 1.55vw, 1.3rem); line-height: 1.42; }
  .result-detail { margin-top: auto; padding-top: 1.35rem; border-top: 1px solid var(--result-rule); }
  .result-detail p { max-width: 48ch; color: var(--result-muted); line-height: 1.65; }
  .story-link { display: inline-flex; align-items: center; min-height: 44px; margin-top: .8rem; font-size: .92rem; font-weight: 600; text-decoration: underline; text-decoration-color: var(--result-rule); text-underline-offset: .35em; }
  .story-link:hover { text-decoration-color: currentColor; }
  .result-ink a:focus-visible { outline-color: var(--mint); }
  .founder { display: grid; grid-template-columns: 1fr 1.06fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; margin-block: clamp(3.25rem, 6.5vw, 6.5rem) 0; }
  .founder-copy h2 { margin-block: .8rem 1rem; }
  .founder-copy > p:not(.eyebrow) { max-width: 54ch; color: var(--muted); line-height: 1.72; }
  .founder-copy a { margin-top: 1.5rem; }
  .pipeline-preview { aspect-ratio: 1.75; overflow: hidden; padding: 6% 7% 0; border-radius: .85rem; border: 1px solid var(--line); background: #dceae7; }
  .pipeline-preview :global(img) { display: block; width: 100%; height: auto; border: 1px solid #aabbb6; border-radius: .5rem; box-shadow: 0 .7rem 2rem #0e31342b; }
  .founder-figure figcaption { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .25rem 1rem; padding-top: .6rem; font-size: .8rem; font-weight: 600; color: var(--ink); }
  .founder-figure figcaption span { font-weight: 400; color: var(--muted); }
  .operating { display: grid; grid-template-columns: .82fr 1fr; gap: clamp(2rem, 9vw, 9rem); align-items: start; }
  .approach { border-top: 1px solid var(--line); padding-block: 1.35rem; }
  .work-next { display: flex; flex-wrap: wrap; gap: .75rem 2rem; padding-block: 1.4rem; border-top: 1px solid var(--line); }
  @media (max-width: 760px) {
    .result-spread, .founder, .operating { grid-template-columns: 1fr; }
    .result { padding: clamp(1.5rem, 6vw, 2.5rem); }
    .result-context { max-width: 35ch; }
    .founder-figure { max-width: 36rem; }
  }
</style>
