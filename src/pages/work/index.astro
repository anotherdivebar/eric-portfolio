---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const caseStudies = (await getCollection("case-studies")).sort(
  (a, b) => a.data.order - b.data.order
);
const kansasElectric = caseStudies.find((study) => study.slug === "kansas-electric");
const programDelivery = caseStudies.find((study) => study.slug === "program-delivery-at-scale");
const operatingExamples = caseStudies.filter((study) => !["kansas-electric", "program-delivery-at-scale"].includes(study.slug));
---

<Base title="Sales & Growth Results - Eric Martin" description="Eric Martin's sales leadership and founder experience: approximately $2M closed in 60 days at Kansas Electric, growth at Vale Field Services, and ABS Console at Atlas-Beren Systems.">
  <section class="page-heading">
    <div class="page-container">
      <div class="max-w-4xl">
        <p class="eyebrow">Sales & growth results</p>
        <h1 class="page-title mt-5">Win the relationship. Deliver the value. Build on it.</h1>
        <p class="page-intro mt-7">I lead sales by connecting customer needs to work the business can deliver. From building a sales function to founding Atlas-Beren Systems, my work connects relationships, revenue, and the ability to follow through.</p>
      </div>

      <section class="mt-14 sm:mt-20" aria-labelledby="case-studies-heading">
        <h2 id="case-studies-heading" class="eyebrow">Commercial results, with the story behind them</h2>
        <div class="mt-6 grid gap-5 md:grid-cols-2">
          {kansasElectric && (
            <article class="section-dark result-card flex flex-col rounded-xl p-7 text-white sm:p-10">
              <p class="text-sm font-semibold text-white/80">Kansas Electric · 2024–2025</p>
              <p class="result-number mt-8">~$2M</p>
              <p class="mt-3 text-sm text-white/70">in new work closed in my first 60 days</p>
              <div class="mb-7 mt-8 h-px bg-white/15"></div>
              <h3 class="text-2xl font-semibold">{kansasElectric.data.title}</h3>
              <p class="mt-4 flex-1 leading-relaxed text-white/70">Built a dedicated sales and marketing function. Won a Walmart engagement through established relationships, owned the customer relationship, and oversaw delivery through the project managers.</p>
              <a class="focus-ring mt-7 inline-flex items-center justify-between gap-4 text-sm font-semibold text-white" href="/work/kansas-electric">Read the sales & growth story <span aria-hidden="true">↗</span></a>
            </article>
          )}
          {programDelivery && (
            <article class="surface result-card flex flex-col p-7 sm:p-10">
              <p class="text-sm font-semibold text-accent">Vale Field Services · 2019–2024</p>
              <p class="result-number mt-8 text-accent">~$4M</p>
              <p class="mt-3 text-sm text-muted">in annual revenue at a company I helped grow</p>
              <div class="mb-7 mt-8 h-px bg-border"></div>
              <h3 class="text-2xl font-semibold text-ink">{programDelivery.data.title}</h3>
              <p class="mt-4 flex-1 leading-relaxed text-muted">Joined as employee one, doing field work and building customer relationships. Grew into leading operations for 35 employees and technology rollouts across hundreds of restaurant locations.</p>
              <a class="text-link mt-7 justify-between" href="/work/program-delivery-at-scale">Read the growth & delivery story <span aria-hidden="true">↗</span></a>
            </article>
          )}
        </div>
      </section>

      <article class="surface-muted mt-5 grid items-center gap-7 p-7 sm:p-10 lg:grid-cols-[1fr_auto] lg:gap-12">
        <div>
          <p class="text-sm font-semibold text-accent">Founder, Atlas-Beren Systems · 2026–Present</p>
          <h2 class="mt-4 text-2xl font-semibold sm:text-3xl">Founded ABS. Built the Console.</h2>
          <p class="mt-4 max-w-3xl leading-relaxed text-muted">I founded Atlas-Beren Systems in January 2026 and built ABS Console for trade and field-service businesses. Its seven modules connect the work from finding a prospect through sales, project delivery, and finance. I own the product direction, design, and full-stack engineering.</p>
        </div>
        <a class="button-secondary" href="/abs-tooling">Explore the platform <span aria-hidden="true">↗</span></a>
      </article>

      <section class="section-space" aria-labelledby="operating-heading">
        <p class="eyebrow">Behind the results</p>
        <h2 id="operating-heading" class="mt-4 text-3xl font-semibold text-ink sm:text-4xl">Operating approaches</h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-muted">Short writeups on the structure behind revenue and delivery work: what needs to be clear, what should be automated, and where a team needs visibility.</p>
        <div class="mt-9 grid gap-x-12 gap-y-9 md:grid-cols-2">
          {operatingExamples.map((study) => (
            <article class="flex flex-col border-t border-border pt-6">
              <p class="eyebrow">{study.data.category}</p>
              <h3 class="mt-3 text-xl font-semibold text-ink">{study.data.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{study.data.summary}</p>
              <a class="text-link mt-5" href={`/work/${study.slug}`} aria-label={`Read ${study.data.title}`}>Read the approach <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </section>

      <div class="flex flex-wrap gap-x-6 gap-y-3 border-t border-border pt-7">
        <a class="text-link" href="/technical-projects">Browse all projects <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/resume">Read my professional background <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .result-number { font-size: clamp(3.5rem, 8vw, 5rem); font-weight: 500; letter-spacing: -0.065em; line-height: 1; font-variant-numeric: tabular-nums; }
  .result-card { transition: border-color 180ms ease; }
  .result-card:hover { border-color: #9ebaa7; }
</style>
