---
import Base from "../layouts/Base.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import PageContents from "../components/PageContents.astro";
import AbsWorkflow from "../components/AbsWorkflow.astro";
import { getEntry } from "astro:content";
import { modules, stackGroups, platformCapabilities, integrationNote, productEvidenceNote } from "../data/abs-console";
const project = await getEntry("technical-projects", "atlas-beren-console");
if (!project) throw new Error("ABS Console case study is missing.");
const { Content, headings } = await project.render();
const labels: Record<string, string> = { crm: "CRM & sales", prospecting: "Prospect Finding", marketing: "Marketing", financial: "Financial", projects: "Projects", operations: "Operations & CMMS", automation: "Automation" };
const flows: Record<string, string[]> = {
  crm: ["Understand the account", "Assign the next follow-up", "Link the delivery project"],
  prospecting: ["Discover relevant businesses", "Check the business against source records", "Bring context into CRM"],
  marketing: ["Review search visibility", "Plan campaigns and content", "Connect spend to job results"],
  financial: ["Link invoices and costs", "Check margins and payment dates", "Review the accounting handoff"],
  projects: ["Translate scope into tasks", "Coordinate people & changes", "Carry progress into billing"],
  operations: ["Get the estimate approved", "Assign a crew and materials", "Record costs and bill the job"],
  automation: ["Explain the trigger", "Review and execute the steps", "Review the run or retry a failed step"]
};
const images: Record<string, { src: string; height: number; alt: string }> = {
  crm: { src: "/assets/abs-console/sales-pipeline.png", height: 1523, alt: "ABS Console sales pipeline with sample opportunities, follow-up queues, and forecast controls" },
  operations: { src: "/assets/abs-console/operations-dashboard.png", height: 1991, alt: "ABS Console demo operations workspace connecting estimates, field work, maintenance, and financial activity" }
};
---
<Base title="ABS Console | Product and Engineering by Eric Martin" description="Eric Martin built ABS Console to connect sales, field jobs, and billing for trade and field-service businesses. One customer record links estimates, jobs, and invoices.">
  <section class="page-container abs-hero" aria-labelledby="abs-title">
    <a href="/technical-projects" class="text-link">All projects</a>
    <div class="abs-heading-grid">
      <div>
        <h1 id="abs-title">ABS <em>Console.</em></h1>
        <p class="abs-deck">Sales, field work, and billing in one place.</p>
        <p class="abs-intro">I founded Atlas-Beren Systems and built ABS Console for trade and field-service businesses. It keeps the customer’s approved estimate with the job, so the crew can see what was promised and the office can see what to bill.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="button-primary" href="#customer-journey">Follow the workflow</a>
          <a class="button-secondary" href="#modules">Explore the modules</a>
        </div>
      </div>
      <figure class="product-stage">
        <a class="product-frame" href="/assets/abs-console/today-desktop.png" aria-label="View full-size ABS Console workspace screenshot">
          <OptimizedImage src="/assets/abs-console/today-desktop.png" alt="ABS Console Today view with daily priorities and navigation for sales, delivery, and finance" width="1265" height="1189" sizes="(max-width: 800px) calc(100vw - 70px), (max-width: 1264px) 48vw, 590px" loading="eager" fetchpriority="high" />
        </a>
        <figcaption><span>Demo workspace · October 28, 2026</span><a href="/assets/abs-console/today-desktop.png">View full size</a></figcaption>
      </figure>
    </div>
    <dl class="abs-facts"><div><dt>Founder · 2026–Present</dt><dd>Atlas-Beren Systems<br />Product direction, design & full-stack engineering</dd></div><div><dt>Built for</dt><dd>Trade contractors, field-service businesses, and project teams</dd></div><div><dt>Product overview</dt><dd>October 2026 · Seven connected modules<br /><a href="#full-stack" class="text-link">See the technology</a></dd></div></dl>
    <nav class="section-nav mt-8" aria-label="ABS Console sections"><a href="#problem">The problem</a><a href="#customer-journey">Workflow</a><a href="#modules">Modules</a><a href="#full-stack">Technology</a><a href="#engineering">Engineering</a><a href="#delivery-and-boundaries">Current scope</a></nav>
  </section>

  <section id="problem" class="page-container section-space" aria-labelledby="problem-heading">
    <div class="problem-heading" id="the-business-problem"><h2 id="problem-heading" class="section-title">What did we promise<br />the customer?</h2><p>When an estimate lives in one tool, the crew schedule in another, and costs in a spreadsheet, someone has to piece together the answer before work can start or an invoice can go out.</p></div>
    <div class="problem-grid">
      <article><h3>The crew needs the agreed scope.</h3><p>Once the job is done, finance needs the completion record and costs to prepare the bill.</p></article>
      <article><h3>One customer record links the work.</h3><p>I linked research, sales opportunities, estimates, projects, field jobs, and invoices to the same customer. Each team can open the original record as work changes hands.</p></article>
      <article><h3>Trace the estimate through billing.</h3><p>An accepted estimate creates a linked job. An owner can open that job to compare the invoice with recorded costs and see which costs are still missing.</p></article>
    </div>
    <p class="image-note">The screens on this page use fictional customer and job records.</p>
  </section>

  <AbsWorkflow />

  <section id="modules" class="module-section" aria-labelledby="modules-heading">
    <div class="page-container section-space">
      <div class="module-section-heading"><h2 id="modules-heading" class="section-title">The seven modules</h2><p>CRM and Prospect Finding share the Sales workspace.</p></div>
      <div class="module-explorer" data-module-explorer>
        <div class="module-selector" role="tablist" aria-label="ABS Console modules" aria-orientation="vertical" hidden>
          {modules.map((module) => <button type="button" id={`tab-${module.id}`} role="tab" aria-controls={module.id} aria-selected="false" tabindex="-1" data-module-target={module.id}><span>{labels[module.id]}</span><span class="module-arrow" aria-hidden="true">↗</span></button>)}
        </div>
        <div class="module-panels">
          {modules.map((module) => (
            <section id={module.id} class="module-panel" data-module-panel>
              <h3>{module.title}</h3><p class="module-description">{module.description}</p>
              <div class="module-detail-grid">
                <div><h4>Capabilities</h4><ul class="module-capabilities">{module.capabilities.map((item) => <li><span aria-hidden="true">↗</span>{item}</li>)}</ul></div>
                <aside class="module-connection"><h4>Workflow</h4><ol>{flows[module.id].map((step, stepIndex) => <li><span aria-hidden="true">0{stepIndex + 1}</span>{step}</li>)}</ol><p>{module.connection}</p></aside>
              </div>
              {images[module.id] && <figure class="module-screenshot"><a href={images[module.id].src} aria-label={`View full-size ${labels[module.id]} screenshot`}><OptimizedImage src={images[module.id].src} alt={images[module.id].alt} width="1265" height={images[module.id].height} sizes="(max-width: 700px) calc(100vw - 90px), 850px" /></a><figcaption>{labels[module.id]} · Sample records <a href={images[module.id].src}>View full size ↗</a></figcaption></figure>}
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-space page-container" aria-labelledby="shared-heading">
    <div class="max-w-3xl"><h2 id="shared-heading" class="section-title">Tools that work<br />across modules.</h2></div>
    <div class="shared-grid">{platformCapabilities.map((capability) => <article><h3>{capability.title}</h3><p>{capability.description}</p></article>)}</div>
    <div class="mobile-product-note"><OptimizedImage src="/assets/abs-console/today-mobile.png" alt="ABS Console demo Today view on a mobile screen" width="375" height="1859" sizes="200px" /><div><h3>A daily view for the field.</h3><p>The Today view puts priorities on a phone. Crews can record work offline, and customers can check quotes, appointments, and bills through their own portal.</p><a class="text-link" href="/assets/abs-console/today-mobile.png">See the mobile workspace ↗</a></div></div>
  </section>

  <section id="full-stack" class="section-dark" aria-labelledby="stack-heading">
    <div class="section-space page-container">
      <h2 id="stack-heading" class="section-title">How I built<br />ABS Console.</h2>
      <div class="stack-grid">{stackGroups.map((group) => <article><h3>{group.title}</h3><ul aria-label={`${group.title} technologies`}>{group.technologies.map((technology) => <li>{technology}</li>)}</ul><p>{group.purpose}</p></article>)}</div>
      <div class="integration-row"><h3>Connected services</h3><p>Zoho Mail · Gmail & Google Calendar · Outlook & Microsoft Calendar · QuickBooks Online · Xero · Stripe · Hunter</p></div>
      <p class="integration-note">{integrationNote}</p>
    </div>
  </section>

  <section id="engineering" class="section-space page-container" aria-labelledby="engineering-heading">
    <div class="engineering-grid"><div class="engineering-title"><h2 id="engineering-heading" class="section-title">Engineering decisions</h2><div class="mt-7 engineering-contents"><PageContents headings={headings.filter((heading) => heading.depth === 2)} label="Engineering details" /></div></div><article class="prose min-w-0"><Content /></article></div>
    <div class="evidence-note"><p>{productEvidenceNote}</p><a class="text-link" href="/technical-projects">Explore more projects ↗</a></div>
  </section>
</Base>
<script>
  const explorer = document.querySelector<HTMLElement>('[data-module-explorer]');
  if (explorer) {
    const tabs = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-module-target]'));
    const panels = Array.from(explorer.querySelectorAll<HTMLElement>('[data-module-panel]'));
    const selectModule = (id: string, focus = false) => {
      const selected = tabs.find((tab) => tab.dataset.moduleTarget === id);
      if (!selected) return;
      tabs.forEach((tab) => { const active = tab === selected; tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; });
      panels.forEach((panel) => { panel.hidden = panel.id !== id; panel.setAttribute('role', 'tabpanel'); panel.setAttribute('aria-labelledby', `tab-${panel.id}`); panel.tabIndex = 0; });
      if (focus) selected.focus();
    };
    explorer.querySelector<HTMLElement>('[role="tablist"]')!.hidden = false;
    explorer.classList.add('is-enhanced');
    const initialId = location.hash.slice(1);
    const hasInitialModule = tabs.some((tab) => tab.dataset.moduleTarget === initialId);
    selectModule(hasInitialModule ? initialId : tabs[0].dataset.moduleTarget!);
    if (hasInitialModule) document.getElementById(initialId)?.scrollIntoView({ block: 'start', behavior: 'instant' });
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        selectModule(tab.dataset.moduleTarget!);
        history.replaceState(null, '', `#${tab.dataset.moduleTarget}`);
      });
      tab.addEventListener('keydown', (event) => {
        let target = index;
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight') target = (index + 1) % tabs.length;
        else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') target = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') target = 0;
        else if (event.key === 'End') target = tabs.length - 1;
        else return;
        event.preventDefault(); selectModule(tabs[target].dataset.moduleTarget!, true);
        history.replaceState(null, '', `#${tabs[target].dataset.moduleTarget}`);
      });
    });
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      const id = link.hash.slice(1);
      if (!tabs.some((tab) => tab.dataset.moduleTarget === id)) return;
      link.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        selectModule(id);
      });
    });
    window.addEventListener('hashchange', () => {
      const id = location.hash.slice(1);
      if (tabs.some((tab) => tab.dataset.moduleTarget === id)) {
        selectModule(id);
        document.getElementById(id)?.scrollIntoView({ block: 'start' });
      }
    });
  }
</script>
<style>
  #problem { scroll-margin-top: 100px; }
  .problem-heading { max-width: 800px; }
  .problem-heading > p:last-child { margin-top: 24px; color: #5d6a63; line-height: 1.8; font-size: 1.05rem; }
  .problem-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 32px; }
  .problem-grid article { padding: 28px; border: 1px solid #dce3dc; border-radius: 16px; background: #edf1e9; }
  .problem-grid h3 { font-size: 1.35rem; line-height: 1.3; }
  .problem-grid p { margin-top: 14px; color: #5d6a63; font-size: .9rem; line-height: 1.8; }
  @media (max-width: 800px) { .problem-grid { grid-template-columns: 1fr; } }

  .abs-hero { padding-top: clamp(1.4rem, 3vw, 3rem); }
  .abs-heading-grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); align-items: center; gap: clamp(1.75rem, 4vw, 4rem); margin-top: clamp(1.3rem, 2.8vw, 2.75rem); }
  #abs-title { font-family: var(--display); font-size: clamp(3.7rem, 7.5vw, 7rem); font-weight: 400; line-height: .98; letter-spacing: -.035em; }
  #abs-title em { color: var(--accent); }
  .abs-deck { margin-top: 1.15rem; font-weight: 550; font-size: clamp(1.2rem, 1.8vw, 1.55rem); line-height: 1.35; letter-spacing: -.035em; }
  .abs-intro { margin-top: .8rem; max-width: 52ch; color: var(--muted); line-height: 1.7; }
  .abs-facts { display: grid; grid-template-columns: 1.15fr 1fr 1fr; gap: 30px; margin-top: clamp(2rem, 4vw, 3rem); padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .abs-facts dt { font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .abs-facts dd { margin-top: .5rem; font-size: .92rem; line-height: 1.6; }
  .product-stage { min-width: 0; padding: clamp(.85rem, 2.5vw, 2.25rem) clamp(.85rem, 2.5vw, 2.25rem) 0; border-radius: 1rem; background: linear-gradient(145deg, #275354, var(--night) 82%); }
  .product-frame { display: block; aspect-ratio: 1.53; overflow: hidden; border: 1px solid #829e99; border-radius: .55rem; box-shadow: 0 .8rem 2rem #07191d4d; }
  .product-frame :global(img) { display: block; width: 100%; height: auto; }
  .product-stage figcaption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .15rem 1rem; padding-block: .35rem; color: #d4e3de; font-size: .8rem; }
  .product-stage figcaption a { display: inline-flex; align-items: center; min-height: 40px; color: var(--mint); font-weight: 600; }
  .product-stage a:focus-visible { outline-color: var(--mint); }
  @media (max-width: 800px) {
    .abs-heading-grid { grid-template-columns: 1fr; gap: 1.75rem; }
    .product-frame { aspect-ratio: 1.7; }
  }
  figcaption a { text-decoration: underline; text-underline-offset: 4px; }
  .image-note { margin-top: 14px; font-size: .7rem; color: #5d6a63; }
  .module-section { background: #edf1e9; border-block: 1px solid #dce3dc; }
  .module-section-heading { display: grid; grid-template-columns: 1.2fr 1fr; align-items: end; gap: 60px; }
  .module-section-heading > p { font-size: .95rem; line-height: 1.8; color: #5d6a63; }
  .module-explorer { margin-top: 40px; }
  .module-explorer.is-enhanced { display: grid; grid-template-columns: 230px minmax(0,1fr); gap: 26px; align-items: start; }
  .module-selector { display: grid; gap: 6px; position: sticky; top: 112px; }
  .module-selector button { display: flex; align-items: center; gap: 12px; padding: 16px 14px; min-height: 54px; border: 1px solid transparent; border-radius: 9px; text-align: left; color: #5d6a63; font-size: .83rem; transition: background .15s; }
  .module-selector button:hover { background: #e1e9dc; }
  .module-selector button[aria-selected="true"] { background: #152e27; color: #fff; border-color: #152e27; }
  .module-arrow { margin-left: auto; color: #ccebb8; opacity: 0; }
  [aria-selected="true"] .module-arrow { opacity: 1; }
  .module-panel { background: #fff; border: 1px solid #dce3dc; border-radius: 18px; padding: clamp(24px,3vw,38px); margin-bottom: 20px; min-width: 0; }
  .module-panel > h3 { font-size: clamp(1.8rem,3vw,2.4rem); line-height: 1.15; font-weight: 550; }
  .module-description { color: #5d6a63; font-size: .94rem; line-height: 1.8; margin-top: 16px; max-width: 65ch; }
  .module-detail-grid { display: grid; grid-template-columns: 1.2fr .85fr; gap: 26px; margin-top: 28px; align-items: start; }
  h4 { font-size: .8rem; font-weight: 650; }
  .module-capabilities { margin-top: 18px; display: grid; gap: 15px; }
  .module-capabilities li { display: flex; gap: 10px; font-size: .82rem; line-height: 1.7; color: #5d6a63; }
  .module-capabilities li > span { color: #176958; flex-shrink: 0; }
  .module-connection { background: #f3f6ee; padding: 22px; border-radius: 12px; }
  .module-connection ol { display: grid; gap: 16px; margin-top: 18px; }
  .module-connection li { display: flex; gap: 10px; font-size: .78rem; font-weight: 550; line-height: 1.6; }
  .module-connection li span { font-size: .62rem; color: #176958; padding-top: 2px; }
  .module-connection > p:last-child { border-top: 1px solid #dce3dc; margin-top: 20px; padding-top: 16px; color: #5d6a63; font-size: .75rem; line-height: 1.7; }
  .module-screenshot { margin-top: 32px; border: 1px solid #dce3dc; border-radius: 10px; overflow: hidden; }
  .module-screenshot > a { display: block; max-height: 400px; overflow: hidden; }
  .module-screenshot :global(img) { width: 100%; height: auto; display: block; }
  .module-screenshot figcaption { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; padding: 13px 16px; font-size: .66rem; color: #5d6a63; border-top: 1px solid #dce3dc; }
  .shared-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 30px 45px; margin-top: 40px; }
  .shared-grid article { padding-top: 24px; border-top: 1px solid #cfd9cf; }
  .shared-grid h3 { font-size: 1.3rem; font-weight: 550; }
  .shared-grid p { font-size: .9rem; line-height: 1.8; margin-top: 14px; color: #5d6a63; }
  .mobile-product-note { display: grid; grid-template-columns: 200px 1fr; gap: 70px; align-items: center; margin-top: 56px; padding: 40px 70px 0; border-radius: 20px; background: #e6edde; max-height: 430px; overflow: hidden; }
  .mobile-product-note :global(img) { width: 200px; align-self: start; border: 6px solid #152e27; border-radius: 26px; }
  .mobile-product-note > div { align-self: start; padding-block: 20px 40px; }
  .mobile-product-note h3 { font-size: 2.1rem; line-height: 1.15; font-weight: 550; }
  .mobile-product-note p:not(.eyebrow) { margin-block: 18px; max-width: 480px; color: #5d6a63; font-size: .9rem; line-height: 1.8; }
  .stack-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 36px; margin-top: 48px; }
  .stack-grid article { border-top: 1px solid #496052; padding-top: 22px; }
  .stack-grid h3 { font-size: 1.15rem; font-weight: 550; }
  .stack-grid ul { display: flex; flex-wrap: wrap; gap: 7px; margin-block: 20px; }
  .stack-grid li { padding: 5px 9px; border: 1px solid #496052; border-radius: 5px; font-size: .65rem; color: #d8e5d9; }
  .stack-grid article > p:last-child { color: #bdcec4; font-size: .8rem; line-height: 1.8; }
  .integration-row { display: grid; grid-template-columns: 1fr 3fr; gap: 25px; margin-top: 42px; padding-top: 26px; border-top: 1px solid #496052; }
  .integration-row h3 { font-size: .85rem; font-weight: 550; }
  .integration-row p { color: #d8e5d9; font-size: .82rem; line-height: 1.8; }
  .integration-note { margin-top: 20px; font-size: .73rem; line-height: 1.8; color: #aebfb3; }
  .engineering-grid { display: grid; grid-template-columns: .85fr 1.6fr; gap: 80px; align-items: start; }
  .engineering-title { position: sticky; top: 118px; }
  .engineering-contents :global(.contents-nav) { max-height: 45vh; }
  @media (max-width: 1023px) { .engineering-grid { grid-template-columns: 1fr; } .engineering-title { position: static; } .engineering-contents :global(.contents-nav) { max-height: none; } }

  .evidence-note { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 24px; border-top: 1px solid #dce3dc; margin-top: 40px; padding-top: 25px; }
  .evidence-note > p { max-width: 700px; font-size: .75rem; color: #5d6a63; line-height: 1.8; }
  @media (max-width: 1023px) { .module-explorer.is-enhanced { grid-template-columns: 190px minmax(0,1fr); gap: 18px; } .module-detail-grid { grid-template-columns: 1fr; } .module-connection ol { grid-template-columns: repeat(3,1fr); gap: 10px; } .module-connection li { flex-direction: column; } .stack-grid { grid-template-columns: repeat(2,1fr); } .engineering-grid { gap: 40px; } .mobile-product-note { gap: 40px; padding-inline: 40px; } }
  @media (max-width: 700px) { .module-section-heading, .engineering-grid { grid-template-columns: 1fr; gap: 28px; } .abs-facts { grid-template-columns: 1fr; gap: 20px; margin-top: 32px; } .module-explorer.is-enhanced { display: block; } .module-selector { position: static; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 6px; margin-bottom: 20px; } .module-selector button { font-size: .75rem; padding: 12px 10px; gap: 8px; } .module-arrow { display: none; } .module-panel { padding: 24px; } .module-connection ol { grid-template-columns: 1fr; } .module-connection li { flex-direction: row; } .shared-grid { grid-template-columns: 1fr; } .mobile-product-note { grid-template-columns: 110px 1fr; gap: 22px; padding: 24px 24px 0; max-height: 450px; } .mobile-product-note :global(img) { width: 110px; border-width: 4px; border-radius: 18px; } .mobile-product-note > div { padding-top: 0; } .mobile-product-note h3 { font-size: 1.4rem; } .mobile-product-note p:not(.eyebrow) { font-size: .8rem; } .mobile-product-note .text-link { font-size: .73rem; } .stack-grid { gap: 30px 24px; } .integration-row { grid-template-columns: 1fr; gap: 12px; } .engineering-title { position: static; } }
  @media (max-width: 420px) { .stack-grid { grid-template-columns: 1fr; } .mobile-product-note { grid-template-columns: 1fr; max-height: none; padding: 24px; } .mobile-product-note :global(img) { display: none; } .mobile-product-note > div { padding-bottom: 0; } }
</style>
