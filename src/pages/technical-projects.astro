---
import Base from "../layouts/Base.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("technical-projects")).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((project) => project.data.order < 3);
const briefs = projects.filter((project) => project.data.order >= 3);
const showcase: Record<string, { stack: string[]; image: string; alt: string; width: number; height: number }> = {
  "atlas-beren-console": {
    stack: ["Next.js", "TypeScript", "PostgreSQL"],
    image: "/assets/abs-console/today-desktop.png",
    alt: "ABS Console Today dashboard showing the daily workspace, priorities, and business module navigation",
    width: 1265,
    height: 1189,
  },
  "atlas-beren-website": {
    stack: ["React", "TypeScript", "Framer Motion"],
    image: "/assets/atlas-beren-website/home.png",
    alt: "Atlas-Beren website home page with an interactive example of a service estimate",
    width: 1440,
    height: 6389,
  },
};
const projectHref = (project: typeof projects[number]) => project.data.detailUrl ?? `/technical-projects/${project.slug}`;
---

<Base title="Software Projects | Eric Martin" description="Eric Martin’s ABS Console, contractor demos, lead routing service, sales reports, and field capacity dashboard.">
  <div class="page-container">
    <header class="projects-intro">
      <h1 class="page-title">Software for sales<br />and <em>field operations.</em></h1>
      <nav class="project-index" aria-label="On this page">
        <a href="#featured-builds">Atlas-Beren projects</a>
        <a href="#system-briefs">Internal tools</a>
      </nav>
    </header>

    <section id="featured-builds" aria-labelledby="featured-heading">
      <h2 id="featured-heading" class="sr-only">Atlas-Beren projects</h2>
      <div class="featured-builds">
        {featured.map((project) => {
          const visual = showcase[project.slug];
          const isConsole = project.slug === "atlas-beren-console";
          return (
            <article id={project.slug} class:list={["build", isConsole && "console-build"]}>
              <div class="build-copy">
                <h3>{project.data.title}</h3>
                <p class="build-description">{project.data.summary}</p>
                <ul class="build-stack" aria-label="Selected technologies">
                  {(visual?.stack ?? project.data.stack.slice(0, 3)).map((item) => (<li>{item}</li>))}
                </ul>
                <a class="build-link" href={projectHref(project)}>{isConsole ? "Inside ABS Console" : "How the contractor demos work"}</a>
              </div>
              {visual && (
                <a class="build-stage" href={projectHref(project)} aria-label={`Explore ${project.data.title}`}>
                  <div class="build-display">
                    <OptimizedImage src={visual.image} alt={visual.alt} width={visual.width} height={visual.height} loading={isConsole ? "eager" : "lazy"} sizes="(max-width: 820px) 82vw, (max-width: 1264px) 43vw, 520px" />
                  </div>
                  {isConsole && (
                    <div class="build-phone">
                      <OptimizedImage src="/assets/abs-console/today-mobile.png" width="375" height="1859" sizes="155px" alt="The same ABS Console Today workspace on mobile" />
                    </div>
                  )}
                </a>
              )}
            </article>
          );
        })}
      </div>
    </section>

    <section id="system-briefs" class="section-space" aria-labelledby="briefs-heading">
      <h2 id="briefs-heading" class="section-title">Internal sales and field tools</h2>
      <div class="briefs">
        {briefs.map((project) => (
          <article id={project.slug} class="brief">
            <h3>{project.data.title}</h3>
            <p>{project.data.summary}</p>
            <a href={projectHref(project)} class="text-link" aria-label={`Read the ${project.data.title} brief`}>Read the brief</a>
          </article>
        ))}
      </div>
    </section>

    <div class="related">
      <article>
        <h2>Sales and field delivery</h2>
        <a class="text-link" href="/work">Kansas Electric and Vale Field Services</a>
      </article>
      <article>
        <h2>Eden</h2>
        <a class="text-link" href="/eden">Engineering a multiplayer game</a>
      </article>
    </div>
  </div>
</Base>

<style>
  .projects-intro { display: grid; grid-template-columns: 1.65fr 1fr; align-items: end; gap: clamp(1.5rem, 5vw, 5rem); padding-block: clamp(3rem, 6.5vw, 6rem) clamp(2.5rem, 5vw, 4.5rem); }
  .page-title em { color: var(--accent); }
  .project-index { display: flex; flex-wrap: wrap; justify-self: end; gap: 0 1.4rem; }
  .project-index a { display: inline-flex; align-items: center; min-height: 42px; color: var(--accent); font-size: .9rem; font-weight: 600; text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: .35em; }
  .project-index a:hover { text-decoration-color: currentColor; }
  .featured-builds { display: grid; gap: clamp(1rem, 2.3vw, 2rem); }
  .build { display: grid; grid-template-columns: 1fr 1.12fr; grid-template-areas: "picture copy"; min-width: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 1rem; background: #fff; }
  .console-build { grid-template-columns: .92fr 1.15fr; grid-template-areas: "copy picture"; border-color: #173238; background: var(--night); color: #f0faf7; }
  .build-copy { grid-area: copy; min-width: 0; padding: clamp(1.7rem, 4.4vw, 4.25rem); align-self: center; }
  .build-copy h3 { font-size: clamp(2rem, 3.6vw, 3.5rem); font-weight: 550; letter-spacing: -.055em; line-height: 1.03; }
  .build-copy .build-description { margin-top: 1.2rem; color: var(--muted); line-height: 1.65; }
  .console-build .build-description { color: #c7dbd8; }
  .build-stack { display: flex; flex-wrap: wrap; gap: .35rem .65rem; margin-top: 1.35rem; color: var(--muted); }
  .build-stack li { font-size: .82rem; }
  .build-stack li + li::before { content: "·"; margin-right: .65rem; }
  .console-build .build-stack { color: #b6cfcc; }
  .build-link { display: inline-flex; align-items: center; min-height: 44px; margin-top: 1.35rem; font-size: .92rem; font-weight: 600; color: var(--accent); text-decoration: underline; text-underline-offset: .35em; }
  .console-build .build-link { color: #a4ead4; }
  .console-build .build-link:focus-visible { outline-color: #a4ead4; }
  .build-stage { grid-area: picture; overflow: hidden; isolation: isolate; position: relative; min-height: 18rem; background: #e0e7e4; }
  .build-stage:focus-visible { outline: 3px solid var(--accent); outline-offset: -5px; }
  .console-build .build-stage:focus-visible { outline-color: var(--mint); }
  .build-display, .build-phone { position: absolute; overflow: hidden; border-radius: .6rem .6rem 0 0; border: 1px solid #b4bcb8; box-shadow: 0 1rem 2rem #152b3240; }
  .build-display { inset: 13% 6% -1px; }
  .build-stage :global(img) { display: block; width: 100%; height: auto; }
  .console-build .build-stage { background: linear-gradient(130deg, #285057, #3e716b 57%, #82b5a0); }
  .console-build .build-display { inset: 11% 13% -1px 5%; border-color: #486565; }
  .build-phone { right: 4%; top: 31%; width: 24%; aspect-ratio: 9 / 18.5; border: clamp(3px, .38vw, 6px) solid #10272c; border-radius: clamp(.7rem, 1.6vw, 1.5rem); background: #f5f9f7; }
  .brief p { color: var(--muted); line-height: 1.65; }
  .briefs { margin-top: clamp(1.8rem, 4vw, 3.5rem); border-bottom: 1px solid var(--line); }
  .brief { display: grid; grid-template-columns: 1fr 1.35fr auto; gap: 2.2rem; align-items: center; padding-block: 1.6rem; border-top: 1px solid var(--line); }
  .brief h3, .related h2 { font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.2; font-weight: 600; }
  .brief a { justify-self: start; }
  .related { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.5rem, 5vw, 4rem); padding: clamp(1.5rem, 4vw, 3.25rem); background: #e9efec; border-radius: 1rem; }
  .related article { display: flex; flex-direction: column; align-items: flex-start; }
  .related a { margin-top: .55rem; }
  @media (max-width: 820px) {
    .projects-intro { grid-template-columns: 1fr; gap: 1.4rem; }
    .project-index { justify-self: start; }
    .build, .console-build { grid-template-columns: 1fr; grid-template-areas: "picture" "copy"; }
    .build-stage { min-height: 0; aspect-ratio: 1.9; }
    .build-phone { max-width: 26%; }
    .build-copy { padding: clamp(1.5rem, 5vw, 2.6rem); }
    .brief { grid-template-columns: 1fr 1.35fr; gap: .6rem 1.5rem; }
    .brief a { grid-column: 2; }
  }
  @media (max-width: 575px) {
    .brief, .related { grid-template-columns: 1fr; }
    .brief a { grid-column: auto; }
    .related article + article { border-top: 1px solid var(--line); padding-top: 1.5rem; }
  }
</style>
