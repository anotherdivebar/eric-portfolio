---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("technical-projects")).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((project) => project.data.order < 3);
const briefs = projects.filter((project) => project.data.order >= 3);
const labels: Record<string, string> = {
  "atlas-beren-console": "Connected business platform",
  "freight-flow-ai": "Freight sales workspace",
  "leak-lens": "Interactive product demo"
};
const visuals: Record<string, { src: string; alt: string; width: number; height: number }> = {
  "atlas-beren-console": { src: "/assets/atlas-beren/workspace-overview.png", alt: "ABS Console workspace with sales, marketing, finance, and delivery modules", width: 1264, height: 625 },
  "freight-flow-ai": { src: "/assets/freightflow/finder-overview.png", alt: "FreightFlow shipper discovery and account research workspace", width: 1024, height: 512 }
};
const projectHref = (project: typeof projects[number]) => project.data.detailUrl ?? `/technical-projects/${project.slug}`;
---

<Base title="Projects and Systems - Eric Martin" description="Explore Eric Martin’s software builds: ABS Tooling, FreightFlow AI, LeakLens, and systems for routing, reporting, and field operations.">
  <section class="py-12 sm:py-16">
    <div class="page-container">
      <div class="section-dark rounded-[32px] px-6 py-9 text-white sm:px-10 sm:py-12">
        <p class="eyebrow">Selected builds / product and engineering</p>
        <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">Projects and systems</h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-300">A closer look at the software behind the workflow: the problem, the decisions, the interface, and the boundaries of each build.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="focus-ring rounded-lg bg-white px-4 py-3 text-sm font-semibold text-ink" href="#featured-builds">Explore the builds ↓</a>
          <a class="focus-ring rounded-lg border border-white/25 px-4 py-3 text-sm font-semibold text-white hover:bg-white/10" href="/work">Business experience & case studies →</a>
        </div>
      </div>

      <section id="featured-builds" aria-labelledby="featured-heading" class="mt-12">
        <div class="mb-6">
          <p class="eyebrow">Inside the products</p>
          <h2 id="featured-heading" class="mt-2 text-2xl font-semibold">Featured builds</h2>
        </div>
        <div class="grid gap-6 lg:grid-cols-2">
          {featured.map((project) => (
            <article id={project.slug} class:list={["surface overflow-hidden", project.slug === "atlas-beren-console" && "lg:col-span-2 lg:grid lg:grid-cols-2"]}>
              {visuals[project.slug] && (
                <a href={projectHref(project)} class="focus-ring flex items-center border-b border-border bg-panel p-4" aria-label={`Explore ${project.data.title}`}>
                  <img src={visuals[project.slug].src} alt={visuals[project.slug].alt} width={visuals[project.slug].width} height={visuals[project.slug].height} class="aspect-[2/1] w-full rounded-lg border border-border object-contain" loading="lazy" decoding="async" />
                </a>
              )}
              <div class="flex flex-col p-6 sm:p-8">
                <p class="eyebrow">{labels[project.slug]}</p>
                <h3 class="mt-2 text-2xl font-semibold">{project.data.title}</h3>
                <p class="mt-3 leading-relaxed text-muted">{project.data.summary}</p>
                {project.slug === "leak-lens" && <p class="mt-4 rounded-lg bg-panel p-3 text-sm text-muted">Demonstration environment with mocked connectors and API data. It illustrates the product workflow.</p>}
                <ul aria-label="Selected technologies" class="mt-5 flex flex-wrap gap-2">
                  {project.data.stack.slice(0, 3).map((item) => (<li class="rounded-md border border-border px-2.5 py-1 text-xs text-muted">{item}</li>))}
                </ul>
                <a href={projectHref(project)} class="focus-ring mt-6 inline-flex self-start text-sm font-semibold text-accent hover:text-accent-dark">{project.slug === "atlas-beren-console" ? "Explore the ABS Tooling case study" : "Read the project breakdown"} <span aria-hidden="true" class="ml-2">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section aria-labelledby="briefs-heading" class="mt-14">
        <div class="max-w-2xl">
          <p class="eyebrow">Focused system briefs</p>
          <h2 id="briefs-heading" class="mt-2 text-2xl font-semibold">Routing, reporting, and operational visibility</h2>
          <p class="mt-3 text-muted">Shorter writeups of the constraints and implementation choices behind specific business workflows.</p>
        </div>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {briefs.map((project) => (
            <article id={project.slug} class="surface flex flex-col p-6">
              <h3 class="text-xl font-semibold">{project.data.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{project.data.summary}</p>
              <a href={projectHref(project)} class="focus-ring mt-5 inline-flex self-start text-sm font-semibold text-accent hover:text-accent-dark" aria-label={`Read the ${project.data.title} brief`}>Read the system brief →</a>
            </article>
          ))}
        </div>
      </section>

      <div class="mt-12 grid gap-5 md:grid-cols-2">
        <article class="surface-muted p-6 sm:p-8">
          <p class="eyebrow">Business and field operations</p>
          <h2 class="mt-2 text-xl font-semibold">Kansas Electric and delivery programs</h2>
          <p class="mt-3 text-muted">Commercial results, field coordination, and the systems that supported the work.</p>
          <a class="focus-ring mt-4 inline-flex text-sm font-semibold text-accent hover:text-accent-dark" href="/work">Explore experience & case studies →</a>
        </article>
        <article class="surface-muted p-6 sm:p-8">
          <p class="eyebrow">Long-running engineering work</p>
          <h2 class="mt-2 text-xl font-semibold">Eden</h2>
          <p class="mt-3 text-muted">C# server work, game systems, diagnostics, and community operations in a live multiplayer environment.</p>
          <a class="focus-ring mt-4 inline-flex text-sm font-semibold text-accent hover:text-accent-dark" href="/eden">Explore Eden engineering →</a>
        </article>
      </div>
    </div>
  </section>
</Base>
