---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const technicalProjects = (await getCollection("technical-projects")).sort(
  (a, b) => a.data.order - b.data.order
);
const atlasConsoleProject = technicalProjects.find(
  (project) => project.slug === "atlas-beren-console"
);
const freightFlowProject = technicalProjects.find(
  (project) => project.slug === "freight-flow-ai"
);
const kansasCaseStudy = (await getCollection("case-studies")).find(
  (c) => c.slug === "kansas-electric"
);

const headshotUrl = "/eric%202026%20headshot.png";

const proofPoints = [
  {
    label: "$100M+ presented opportunities",
    detail: "Business development work supported by cleaner pipeline, workflow, and reporting systems."
  },
  {
    label: "$200M+ forward pipeline",
    detail: "Operating visibility built around quoting, readiness, and leadership reporting."
  },
  {
    label: "Startup to ~$4M annual scale",
    detail: "Operating structure across planning, QA, vendor coordination, and field execution."
  }
];

const commandSignals = [
  "Revenue and operations gaps surfaced before they become tribal knowledge",
  "Pipeline visibility that operators and leadership can both trust",
  "Internal tooling shaped around how operators already work",
  "Human-reviewed queues for outreach, CRM updates, and sensitive actions",
  "Readiness gates before live runs"
];

const focusAreas = [
  {
    title: "Find revenue",
    body: "Customer acquisition systems, prospecting workflows, account research, bid/RFP visibility, and approved outbound queues."
  },
  {
    title: "Recover revenue",
    body: "Stale quotes, dormant leads, CRM rows with no next step, and follow-up drafts surfaced where ownership is clear."
  },
  {
    title: "Control operations",
    body: "Front office, back office, field status, documents, and reporting loops kept visible instead of rebuilt from memory."
  },
  {
    title: "Govern AI work",
    body: "Agent-assisted research, drafts, enrichment, and alerts with human review, clear logs, and no destructive actions by default."
  }
];

const skillPreview = [
  "Revenue Operations",
  "Strategic Operations",
  "Customer Acquisition",
  "Revenue Recovery",
  "Managed Workflow Systems",
  "Pipeline Visibility",
  "Forecasting",
  "Business Process Architecture",
  "CRM Workflow Design",
  "Internal Tooling",
  "Owner Visibility"
];
---

<Base title="Eric Martin - Revenue Operations and Managed Workflow Systems">
  <section class="py-16 sm:py-20">
    <div class="page-container">
      <div class="section-dark relative overflow-hidden rounded-[32px] border border-slate-800 px-6 py-8 text-white sm:px-8 sm:py-10 lg:px-10 lg:py-12">
        <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(148,163,184,0.06)_1px,transparent_1px),linear-gradient(90deg,rgba(148,163,184,0.05)_1px,transparent_1px)] bg-[size:32px_32px] opacity-30"></div>
        <div class="relative grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
          <div>
            <p class="eyebrow mb-4 text-slate-300">RevOps / strategic operations / managed workflow systems</p>
            <h1 class="max-w-3xl text-4xl font-semibold leading-tight text-white sm:text-5xl">
              I build the systems that keep revenue and operations under control.
            </h1>
            <p class="mt-4 max-w-2xl text-lg text-slate-300">
              Revenue operations and systems builder focused on the places work tends
              to slip: weak follow-up, stale quotes, unreliable CRM stages, missed
              prospects, field updates, manual reporting, and handoffs nobody owns. I
              build the queues, dashboards, approval paths, and internal tools that
              make the next action clear.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a
                class="focus-ring inline-flex w-full items-center justify-center rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-accent-dark sm:w-auto"
                href="/resume"
              >
                View Resume
              </a>
              <a
                class="focus-ring inline-flex w-full items-center justify-center rounded-lg border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white transition hover:border-white/25 hover:bg-white/10 sm:w-auto"
                href="/technical-projects"
              >
                Browse Projects
              </a>
            </div>

            <div class="mt-10 grid gap-4 sm:grid-cols-3">
              {proofPoints.map((item) => (
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)] backdrop-blur-sm">
                  <p class="text-sm font-semibold text-white">{item.label}</p>
                  <p class="mt-2 text-sm text-slate-300">{item.detail}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="grid gap-5">
            <div class="flex justify-center lg:justify-end">
              <img
                src={headshotUrl}
                alt="Eric Martin"
                width="560"
                height="700"
                class="aspect-[4/5] w-full max-w-[300px] rounded-2xl border border-white/10 bg-slate-900/40 object-cover shadow-[0_18px_50px_rgba(15,23,42,0.35)]"
                decoding="async"
              />
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm">
              <p class="eyebrow text-slate-400">Command layer</p>
              <h2 class="mt-2 text-xl font-semibold text-white">What I keep in view</h2>
              <ul class="mt-4 space-y-3 text-sm text-slate-300">
                {commandSignals.map((item) => (
                  <li class="flex gap-3">
                    <span class="mt-1 h-2 w-2 rounded-full bg-accent"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>

      <div class="surface-muted mt-12 p-6 sm:p-8">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-semibold text-ink">What I help build</h2>
          <p class="mt-3 text-muted">
            Practical systems for customer acquisition, revenue recovery, operational
            control, and leadership visibility.
          </p>
        </div>
        <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {focusAreas.map((area) => (
            <div class="surface border-t-4 border-t-accent p-5">
              <h3 class="text-lg font-semibold text-ink">{area.title}</h3>
              <p class="mt-2 text-sm text-muted">{area.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="page-container">
      <div class="section-dark rounded-[32px] border border-slate-800 px-6 py-8 text-white sm:px-8 sm:py-10">
        <div class="max-w-2xl">
          <p class="eyebrow text-slate-300">Selected work</p>
          <h2 class="mt-2 text-3xl font-semibold text-white">Workflow systems with real operators behind them.</h2>
          <p class="mt-3 text-slate-300">
            Acquisition coverage, recovery queues, field visibility, owner briefings,
            and internal control planes built around day-to-day execution.
          </p>
        </div>
        <div class="mt-8 grid gap-6 xl:grid-cols-3">
          {kansasCaseStudy ? (
            <article class="rounded-2xl border border-white/10 bg-white/5 p-6 sm:p-8">
              <p class="eyebrow text-slate-400">Case study</p>
              <h3 class="mt-2 text-xl font-semibold text-white">Kansas Electric</h3>
              <p class="mt-3 text-slate-300">{kansasCaseStudy.data.summary}</p>
              <p class="mt-4 text-sm text-slate-400">Outcome: {kansasCaseStudy.data.impact}</p>
              <a
                class="focus-ring mt-6 inline-flex text-sm font-semibold text-sky-300 hover:text-white"
                href="/work/kansas-electric"
              >
                Read case study ->
              </a>
            </article>
          ) : null}

          {atlasConsoleProject ? (
            <article class="rounded-2xl border border-white/10 bg-white/5 p-6 sm:p-8">
              <p class="eyebrow text-slate-400">Internal platform</p>
              <h3 class="mt-2 text-xl font-semibold text-white">Atlas-Beren Console</h3>
              <p class="mt-1 text-sm text-slate-400">Internal operator control plane for managed AI workflow systems</p>
              <p class="mt-3 text-slate-300">
                Client workspaces, agent catalog, evidence gates, approvals, integration health,
                prospecting, and value/risk visibility. Built to turn AI-assisted work from
                scattered experiments into a governed execution loop.
              </p>
              <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-slate-300">
                <li>Client workspaces with evidence gates and readiness checks before live runs</li>
                <li>30+ agent catalog with runbooks, KPIs, failure modes, and operating limits</li>
                <li>Prospecting, integration health, approvals, and Today queue in one governed loop</li>
              </ul>
              <a
                class="focus-ring mt-6 inline-flex text-sm font-semibold text-sky-300 hover:text-white"
                href={`/technical-projects#${atlasConsoleProject.slug}`}
              >
                System overview ->
              </a>
            </article>
          ) : null}

          {freightFlowProject ? (
            <article class="rounded-2xl border border-white/10 bg-white/5 p-6 sm:p-8">
              <p class="eyebrow text-slate-400">Product system</p>
              <h3 class="mt-2 text-xl font-semibold text-white">{freightFlowProject.data.title}</h3>
              <p class="mt-3 text-slate-300">{freightFlowProject.data.summary}</p>
              <p class="mt-4 text-sm text-slate-400">Stack: {freightFlowProject.data.stack.join(", ")}</p>
              <a
                class="focus-ring mt-6 inline-flex text-sm font-semibold text-sky-300 hover:text-white"
                href={`/technical-projects#${freightFlowProject.slug}`}
              >
                Product breakdown ->
              </a>
            </article>
          ) : null}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="page-container grid gap-8 lg:grid-cols-[1fr_0.95fr]">
      <div>
        <h2 class="text-3xl font-semibold text-ink">Systems I build</h2>
        <p class="mt-3 max-w-2xl text-muted">
          RevOps, customer acquisition, revenue recovery, workflow design, owner
          visibility, and the technical stack I use to turn scattered spreadsheets,
          handoffs, and dashboards into systems people actually use.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {skillPreview.map((skill) => (
            <span class="inline-flex rounded-lg border border-border bg-panel px-3 py-1.5 text-sm text-ink shadow-[0_8px_18px_rgba(15,23,42,0.05)]">
              {skill}
            </span>
          ))}
        </div>
        <a
          class="mt-6 inline-flex text-sm font-semibold text-accent hover:text-accent-dark"
          href="/skills"
        >
          Full skills page ->
        </a>
      </div>
      <div class="surface p-6 sm:p-8">
        <h3 class="text-lg font-semibold text-ink">How I work</h3>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-muted">
          <li>Start from the signal flow, not the tool category</li>
          <li>Model ownership and handoffs before scaling headcount</li>
          <li>Ship in increments and keep the build close to the operators</li>
          <li>Stay accountable through rollout and adoption</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-panel py-16">
    <div class="page-container">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold text-ink">About</h2>
        <p class="mt-3 text-muted">
          My background sits in operator-led environments where customer acquisition,
          pipeline, field work, and owner visibility all have to line up.
        </p>
      </div>
      <a
        class="mt-4 inline-flex text-sm font-semibold text-accent hover:text-accent-dark"
        href="/about"
      >
        More background ->
      </a>
    </div>
  </section>

  <section class="py-16">
    <div class="page-container">
      <div class="mx-auto grid max-w-4xl gap-6 rounded-2xl bg-ink px-6 py-10 text-white shadow-[0_18px_50px_rgba(15,23,42,0.25)] sm:px-8 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <h2 class="text-3xl font-semibold">Let's talk</h2>
          <p class="mt-2 max-w-xl text-white/75">
            If you need someone who can find the operational gaps, design the queue,
            and ship the system operators actually use, reach out.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 md:justify-end">
          <a
            class="focus-ring inline-flex w-full items-center justify-center rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-ink sm:w-auto"
            href="mailto:ericm93.2023@outlook.com"
          >
            ericm93.2023@outlook.com
          </a>
          <a
            class="focus-ring inline-flex w-full items-center justify-center rounded-lg border border-white/30 px-5 py-2.5 text-sm font-semibold text-white sm:w-auto"
            href="/resume"
          >
            Resume
          </a>
          <a
            class="focus-ring inline-flex w-full items-center justify-center rounded-lg border border-white/30 px-5 py-2.5 text-sm font-semibold text-white sm:w-auto"
            href="https://www.linkedin.com/in/eric-m-53b374174/"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
