---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const featuredTechProject = (await getCollection("technical-projects")).sort(
  (a, b) => a.data.order - b.data.order
)[0];
const kansasCaseStudy = (await getCollection("case-studies")).find(
  (c) => c.slug === "kansas-electric"
);

const headshotUrl = "/eric%202026%20headshot.png";

const proofPoints = [
  {
    label: "$100M+ presented opportunities",
    detail: "Kansas Electric commercial motion supported by cleaner pipeline, workflow, and reporting systems."
  },
  {
    label: "$200M+ forward pipeline",
    detail: "Visibility and process design built to support quoting, readiness, and leadership reporting."
  },
  {
    label: "Startup to ~$4M annual scale",
    detail: "Vale operating structure designed across planning, QA, vendor coordination, and field execution."
  }
];

const focusAreas = [
  {
    title: "Revenue systems",
    body: "Pipeline visibility, forecasting, CRM workflow design, reporting logic, and the systems that help teams trust what they are seeing."
  },
  {
    title: "Process architecture",
    body: "Handoffs between commercial, ops, and field teams made explicit so work moves with less friction and fewer surprises."
  },
  {
    title: "AI-assisted workflows",
    body: "Practical AI where it sharpens research, outreach, and process speed without forcing a disruptive change in how the team works."
  }
];

const skillPreview = [
  "Revenue Operations",
  "Strategic Operations",
  "Pipeline Visibility",
  "Forecasting",
  "Business Process Architecture",
  "GTM Execution",
  "CRM Workflow Design",
  "Internal Tooling"
];
---

<Base title="Eric Martin - Revenue Operations and Strategic Systems">
  <section class="py-16 sm:py-20">
    <div class="page-container">
      <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
        <div>
          <p class="eyebrow mb-4">RevOps / strategic operations / revenue systems</p>
          <h1 class="text-4xl font-semibold leading-tight text-ink sm:text-5xl">
            I build the systems behind revenue motion.
          </h1>
          <p class="mt-4 max-w-2xl text-lg text-muted">
            Revenue operations and strategic systems leader focused on the infrastructure
            that connects pipeline, planning, execution, and reporting. I build practical
            operating models, tighten handoffs, and design internal workflows that help
            teams move with less manual friction.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              class="focus-ring inline-flex w-full items-center justify-center rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-accent-dark sm:w-auto"
              href="/resume"
            >
              View Resume
            </a>
            <a
              class="focus-ring inline-flex w-full items-center justify-center rounded-lg border border-border px-5 py-2.5 text-sm font-semibold text-ink transition hover:border-ink sm:w-auto"
              href="/technical-projects"
            >
              Browse Projects
            </a>
          </div>

          <div class="mt-10 grid gap-4 sm:grid-cols-3">
            {proofPoints.map((item) => (
              <div class="surface p-4">
                <p class="text-sm font-semibold text-ink">{item.label}</p>
                <p class="mt-2 text-sm text-muted">{item.detail}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="flex justify-center lg:justify-end lg:pt-1">
          <img
            src={headshotUrl}
            alt="Eric Martin"
            width="560"
            height="700"
            class="aspect-[4/5] w-full max-w-[300px] rounded-2xl border border-border bg-panel object-cover shadow-[0_12px_30px_rgba(15,23,42,0.12)]"
            decoding="async"
          />
        </div>
      </div>

      <div class="surface-muted mt-12 p-6 sm:p-8">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-semibold text-ink">What I help build</h2>
          <p class="mt-3 text-muted">
            The connective tissue between commercial activity, operational readiness,
            and leadership visibility.
          </p>
        </div>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {focusAreas.map((area) => (
            <div class="surface p-5">
              <h3 class="text-lg font-semibold text-ink">{area.title}</h3>
              <p class="mt-2 text-sm text-muted">{area.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-panel py-16">
    <div class="page-container">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold text-ink">Selected work</h2>
        <p class="mt-3 text-muted">
          A mix of internal revenue infrastructure and product-style systems thinking.
        </p>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {kansasCaseStudy ? (
          <article class="surface flex h-full flex-col p-6 sm:p-8">
            <p class="eyebrow">Case study</p>
            <h3 class="mt-2 text-xl font-semibold text-ink">Kansas Electric</h3>
            <p class="mt-3 text-muted">{kansasCaseStudy.data.summary}</p>
            <p class="mt-4 text-sm text-muted">Outcome: {kansasCaseStudy.data.impact}</p>
            <a
              class="focus-ring mt-6 inline-flex text-sm font-semibold text-accent hover:text-accent-dark"
              href="/work/kansas-electric"
            >
              Read case study ->
            </a>
          </article>
        ) : null}

        {featuredTechProject ? (
          <article class="surface flex h-full flex-col p-6 sm:p-8">
            <p class="eyebrow">Product concept</p>
            <h3 class="mt-2 text-xl font-semibold text-ink">{featuredTechProject.data.title}</h3>
            <p class="mt-3 text-muted">{featuredTechProject.data.summary}</p>
            <p class="mt-4 text-sm text-muted">Stack: {featuredTechProject.data.stack.join(", ")}</p>
            <div class="mt-6 flex flex-wrap gap-4">
              <a
                class="focus-ring inline-flex text-sm font-semibold text-accent hover:text-accent-dark"
                href={`/technical-projects#${featuredTechProject.slug}`}
              >
                See breakdown ->
              </a>
              {featuredTechProject.data.demoUrl ? (
                <a
                  class="focus-ring inline-flex text-sm font-semibold text-muted hover:text-ink"
                  href={featuredTechProject.data.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Open demo ->
                </a>
              ) : null}
            </div>
          </article>
        ) : null}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="page-container grid gap-8 lg:grid-cols-[1fr_0.95fr]">
      <div>
        <h2 class="text-3xl font-semibold text-ink">Resume-aligned skills</h2>
        <p class="mt-3 max-w-2xl text-muted">
          RevOps, workflow design, pipeline visibility, and the technical stack I use
          to turn spreadsheets and handoffs into systems people actually run.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {skillPreview.map((skill) => (
            <span class="inline-flex rounded-lg border border-border bg-panel px-3 py-1.5 text-sm text-ink">
              {skill}
            </span>
          ))}
        </div>
        <a
          class="mt-6 inline-flex text-sm font-semibold text-accent hover:text-accent-dark"
          href="/skills"
        >
          Full skills page ->
        </a>
      </div>
      <div class="surface p-6 sm:p-8">
        <h3 class="text-lg font-semibold text-ink">How I work</h3>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-muted">
          <li>Start from the signal flow, not the tool category</li>
          <li>Model ownership and handoffs before scaling headcount</li>
          <li>Ship in increments and keep the build close to the operators</li>
          <li>Stay accountable through rollout and adoption</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-panel py-16">
    <div class="page-container">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold text-ink">About</h2>
        <p class="mt-3 text-muted">
          Growth-stage and customer-facing environments where pipeline, delivery, and
          real-world execution all have to line up.
        </p>
      </div>
      <a
        class="mt-4 inline-flex text-sm font-semibold text-accent hover:text-accent-dark"
        href="/about"
      >
        More background ->
      </a>
    </div>
  </section>

  <section class="py-16">
    <div class="page-container">
      <div class="mx-auto grid max-w-4xl gap-6 rounded-2xl bg-ink px-6 py-10 text-white shadow-[0_18px_50px_rgba(15,23,42,0.25)] sm:px-8 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <h2 class="text-3xl font-semibold">Let's talk</h2>
          <p class="mt-2 max-w-xl text-white/75">
            If you need someone who can connect revenue systems, process design, and
            day-to-day execution, reach out.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 md:justify-end">
          <a
            class="focus-ring inline-flex w-full items-center justify-center rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-ink sm:w-auto"
            href="mailto:ericm93.2023@outlook.com"
          >
            ericm93.2023@outlook.com
          </a>
          <a
            class="focus-ring inline-flex w-full items-center justify-center rounded-lg border border-white/30 px-5 py-2.5 text-sm font-semibold text-white sm:w-auto"
            href="/resume"
          >
            Resume
          </a>
          <a
            class="focus-ring inline-flex w-full items-center justify-center rounded-lg border border-white/30 px-5 py-2.5 text-sm font-semibold text-white sm:w-auto"
            href="https://www.linkedin.com/in/eric-m-53b374174/"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
