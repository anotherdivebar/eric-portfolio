---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const featuredTechProject = (await getCollection("technical-projects")).sort(
  (a, b) => a.data.order - b.data.order
)[0];
const kansasCaseStudy = (await getCollection("case-studies")).find(
  (c) => c.slug === "kansas-electric"
);

const headshotUrl = "/eric%202026%20headshot.png";
---

<Base title="Eric Martin — Revenue & Strategic Operations">
  <section class="py-16 sm:py-20">
    <div class="page-container">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-start">
        <div>
          <p class="eyebrow mb-4">
            Revenue &amp; strategic operations · AI enablement
          </p>
          <h1 class="text-4xl font-semibold leading-tight text-ink sm:text-5xl">
            Revenue &amp; Strategic Operations Leader
          </h1>
          <p class="mt-4 max-w-xl text-lg text-muted">
            I build the infrastructure that connects pipeline, planning, execution,
            and reporting — and I look for high-value ways to add AI into workflows
            without blowing up what already works. Practical operating models,
            visibility, less manual work, stronger decisions — plus hands-on systems
            and process architecture.
          </p>
          <ul class="mt-6 grid gap-3 text-sm text-muted">
            <li>
              $100M+ in presented opportunities (2025) and $200M+ forward pipeline
              context at Kansas Electric — systems aligned to that motion
            </li>
            <li>
              AI and automation where they improve efficiency and insight without
              sacrificing stability or adoption
            </li>
            <li>
              Scaled ops infrastructure from startup to ~$4M annually (Vale)
            </li>
            <li>
              Build and refine the tools — not just the slide deck
            </li>
          </ul>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              class="focus-ring inline-flex w-full items-center justify-center rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-accent-dark sm:w-auto"
              href="/resume"
            >
              Resume &amp; full story
            </a>
            <a
              class="focus-ring inline-flex w-full items-center justify-center rounded-lg border border-border px-5 py-2.5 text-sm font-semibold text-ink transition hover:border-ink sm:w-auto"
              href="/technical-projects"
            >
              Projects &amp; systems depth
            </a>
          </div>
        </div>
        <div class="flex justify-center lg:justify-end lg:pt-1">
          <img
            src={headshotUrl}
            alt="Eric Martin"
            width="560"
            height="700"
            class="aspect-[4/5] w-full max-w-[280px] rounded-2xl border border-border bg-panel object-cover shadow-[0_12px_30px_rgba(15,23,42,0.12)]"
            decoding="async"
          />
        </div>
      </div>

      <div class="surface-muted mt-10 p-6 sm:p-8 lg:mt-12">
        <h2 class="text-xl font-semibold text-ink">How I help</h2>
        <p class="mt-2 max-w-3xl text-muted">
          I build the connective tissue between pipeline, field execution, and
          leadership reporting — so teams spend less time reconciling reality and more
          time moving work forward.
        </p>
        <div class="mt-6 grid gap-3 text-sm text-muted md:grid-cols-3">
          <div class="surface p-4">
            <p class="font-semibold text-ink">Pipeline &amp; visibility</p>
            <p class="mt-1">
              Forecasting, opportunity modeling, CRM and dashboarding so signal matches
              the business.
            </p>
          </div>
          <div class="surface p-4">
            <p class="font-semibold text-ink">Workflows &amp; handoffs</p>
            <p class="mt-1">
              Standardize how work moves from intake through delivery — fewer gaps,
              fewer surprises.
            </p>
          </div>
          <div class="surface p-4">
            <p class="font-semibold text-ink">AI &amp; automation (practical)</p>
            <p class="mt-1">
              Non-disruptive workflow integration — better insight and less manual
              work without destabilizing how teams already operate.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-panel py-16">
    <div class="page-container">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold text-ink">Projects</h2>
        <p class="mt-3 text-muted">
          Revenue and operations infrastructure in the field, plus a freight product
          concept you can explore in depth.
        </p>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {featuredTechProject ? (
          <article class="surface p-6">
            <h3 class="text-lg font-semibold">{featuredTechProject.data.title}</h3>
            <p class="mt-2 text-muted">{featuredTechProject.data.summary}</p>
            <p class="mt-4 text-sm text-muted">
              Focus: {featuredTechProject.data.decisions[0]}
            </p>
            <div class="mt-4 flex flex-wrap gap-4">
              <a
                class="focus-ring inline-flex text-sm font-semibold text-accent hover:text-accent-dark"
                href={`/technical-projects#${featuredTechProject.slug}`}
              >
                Concept &amp; technical breakdown
              </a>
              {featuredTechProject.data.demoUrl ? (
                <a
                  class="focus-ring inline-flex text-sm font-semibold text-muted hover:text-ink"
                  href={featuredTechProject.data.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Interactive demo ↗
                </a>
              ) : null}
            </div>
          </article>
        ) : null}
        {kansasCaseStudy ? (
          <article class="surface p-6">
            <h3 class="text-lg font-semibold">
              {kansasCaseStudy.data.title} · Revenue &amp; ops infrastructure
            </h3>
            <p class="mt-2 text-muted">{kansasCaseStudy.data.summary}</p>
            <p class="mt-4 text-sm text-muted">
              Outcome: {kansasCaseStudy.data.impact}
            </p>
            <a
              class="focus-ring mt-4 inline-flex text-sm font-semibold text-accent hover:text-accent-dark"
              href="/work/kansas-electric"
            >
              Full case study
            </a>
          </article>
        ) : null}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="page-container grid gap-8 lg:grid-cols-[1fr_0.9fr]">
      <div>
        <h2 class="text-3xl font-semibold text-ink">Core competencies &amp; skills</h2>
        <p class="mt-3 text-muted">
          Key skills + technical stack from the resume — including AI workflow
          integration and what I ship in CRM, dashboards, and internal tooling.
        </p>
        <a
          class="mt-4 inline-flex text-sm font-semibold text-accent hover:text-accent-dark"
          href="/skills"
        >
          Full skills page
        </a>
      </div>
      <div class="surface p-6">
        <h3 class="text-lg font-semibold">Operating style</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-muted">
          <li>Start from pipeline, planning, and where decisions actually get made</li>
          <li>Design handoffs and rhythms before bolting on tools</li>
          <li>Ship in increments with measurable adoption</li>
          <li>Stay accountable through rollout — not just launch day</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-panel py-16">
    <div class="page-container">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold text-ink">About</h2>
        <p class="mt-3 text-muted">
          Growth-stage and customer-facing environments — BD, ops, and systems in the
          same thread of work.
        </p>
      </div>
      <a
        class="mt-4 inline-flex text-sm font-semibold text-accent hover:text-accent-dark"
        href="/about"
      >
        Background &amp; how I work
      </a>
    </div>
  </section>

  <section class="py-16">
    <div class="page-container">
      <div class="mx-auto grid max-w-4xl gap-6 rounded-2xl bg-ink px-6 py-10 text-white shadow-[0_18px_50px_rgba(15,23,42,0.25)] sm:px-8 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <h2 class="text-3xl font-semibold">Let's talk</h2>
          <p class="mt-2 max-w-xl text-white/75">
            If you need someone who can align commercial motion with execution
            systems — and actually build what the org runs on — reach out.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 md:justify-end">
          <a
            class="focus-ring inline-flex w-full items-center justify-center rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-ink sm:w-auto"
            href="mailto:ericm93.2023@outlook.com"
          >
            ericm93.2023@outlook.com
          </a>
          <a
            class="focus-ring inline-flex w-full items-center justify-center rounded-lg border border-white/30 px-5 py-2.5 text-sm font-semibold text-white sm:w-auto"
            href="/resume"
          >
            Resume
          </a>
          <a
            class="focus-ring inline-flex w-full items-center justify-center rounded-lg border border-white/30 px-5 py-2.5 text-sm font-semibold text-white sm:w-auto"
            href="https://www.linkedin.com/in/eric-m-53b374174/"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
