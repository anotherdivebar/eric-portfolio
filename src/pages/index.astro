---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const technicalProjects = (await getCollection("technical-projects")).sort(
  (a, b) => a.data.order - b.data.order
);
const atlasConsoleProject = technicalProjects.find(
  (project) => project.slug === "atlas-beren-console"
);
const freightFlowProject = technicalProjects.find(
  (project) => project.slug === "freight-flow-ai"
);
const kansasCaseStudy = (await getCollection("case-studies")).find(
  (c) => c.slug === "kansas-electric"
);

const headshotUrl = "/eric%202026%20headshot.png";

const proofPoints = [
  {
    value: "$2M",
    label: "closed in 60 days",
    context: "Kansas Electric"
  },
  {
    value: "$100M+",
    label: "presented opportunities",
    context: "Kansas Electric, 2025"
  },
  {
    value: "$200M+",
    label: "forward pipeline",
    context: "24-month outlook"
  },
  {
    value: "~$4M",
    label: "annual scale",
    context: "Vale Field Services"
  }
];

const commandSignals = [
  "Growth bottlenecks surfaced before they live in spreadsheets or memory",
  "Pipeline, field work, and owner visibility tied to the same operating picture",
  "Internal apps and automations shaped around how operators already work",
  "Approval-gated execution for sensitive or customer-facing actions",
  "Production systems with tests, auditability, and rollout discipline"
];

const focusAreas = [
  {
    title: "Find revenue",
    body: "Prospecting workflows, account research, bid and RFP visibility, lead capture, and approved outbound queues that turn interest into accountable follow-up."
  },
  {
    title: "Recover revenue",
    body: "Stale quotes, dormant leads, CRM rows with no next step, and weak follow-up surfaced in queues where ownership and next action are clear."
  },
  {
    title: "Control operations",
    body: "Front office, back office, field status, scheduling, documents, and reporting loops kept visible instead of rebuilt from memory every week."
  },
  {
    title: "Govern AI-assisted work",
    body: "Agent catalogs, readiness gates, evidence review, human approval, and audit trails so AI accelerates operators without bypassing the operating model."
  }
];

const skillPreview = [
  "Revenue Operations",
  "Technical Systems",
  "Business Development",
  "Field Operations",
  "Execution Infrastructure",
  "Pipeline & Forecasting",
  "Internal Apps",
  "Approval-Gated Automation",
  "Operating Visibility",
  "AI-Enabled Workflows"
];
---

<Base title="Eric Martin - Revenue Operations & Technical Systems Leader">
  <section class="py-16 sm:py-20">
    <div class="page-container">
      <div class="section-dark relative overflow-hidden rounded-[32px] border border-slate-800 px-6 py-8 text-white sm:px-8 sm:py-10 lg:px-10 lg:py-12">
        <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(148,163,184,0.06)_1px,transparent_1px),linear-gradient(90deg,rgba(148,163,184,0.05)_1px,transparent_1px)] bg-[size:32px_32px] opacity-30"></div>
        <div class="relative grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
          <div>
            <p class="eyebrow mb-4 text-slate-300">Revenue operations / technical systems / execution infrastructure</p>
            <h1 class="max-w-3xl text-4xl font-semibold leading-tight text-white sm:text-5xl">
              I build the operating systems behind sustainable growth.
            </h1>
            <p class="mt-4 max-w-2xl text-lg text-slate-300">
              I am a systems builder who understands operations and how to generate
              sustainable growth. I work across revenue operations, technical systems,
              field and service operations, and scalable execution — turning messy
              handoffs into dashboards, internal apps, automations, approvals, and
              production systems operators can actually run.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a
                class="focus-ring inline-flex w-full items-center justify-center rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-accent-dark sm:w-auto"
                href="/resume"
              >
                View Resume
              </a>
              <a
                class="focus-ring inline-flex w-full items-center justify-center rounded-lg border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white transition hover:border-white/25 hover:bg-white/10 sm:w-auto"
                href="/technical-projects"
              >
                Browse Projects
              </a>
            </div>

            <div class="mt-8 max-w-xl overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04]">
              <div class="grid grid-cols-2 divide-x divide-y divide-white/10">
                {proofPoints.map((item) => (
                  <div class="flex min-h-[5.5rem] flex-col justify-center px-4 py-4 sm:px-5">
                    <p class="text-2xl font-semibold tabular-nums tracking-tight text-white">{item.value}</p>
                    <p class="mt-1 text-sm leading-snug text-slate-200">{item.label}</p>
                    <p class="mt-0.5 text-xs text-slate-500">{item.context}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="grid gap-5">
            <div class="flex justify-center lg:justify-end">
              <img
                src={headshotUrl}
                alt="Eric Martin"
                width="560"
                height="700"
                class="aspect-[4/5] w-full max-w-[300px] rounded-2xl border border-white/10 bg-slate-900/40 object-cover shadow-[0_18px_50px_rgba(15,23,42,0.35)]"
                decoding="async"
              />
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm">
              <p class="eyebrow text-slate-400">Operating model</p>
              <h2 class="mt-2 text-xl font-semibold text-white">What I keep in view</h2>
              <ul class="mt-4 space-y-3 text-sm text-slate-300">
                {commandSignals.map((item) => (
                  <li class="flex gap-3">
                    <span class="mt-1 h-2 w-2 rounded-full bg-accent"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>

      <div class="surface-muted mt-12 p-6 sm:p-8">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-semibold text-ink">How I think about the work</h2>
          <p class="mt-3 text-muted">
            Growth is not just a funnel problem or a software problem. It is an
            execution problem. I build practical operating systems across four
            layers: find revenue, recover revenue, control operations, and govern
            AI-assisted work.
          </p>
        </div>
        <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {focusAreas.map((area) => (
            <div class="surface border-t-4 border-t-accent p-5">
              <h3 class="text-lg font-semibold text-ink">{area.title}</h3>
              <p class="mt-2 text-sm text-muted">{area.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="page-container">
      <div class="section-dark rounded-[32px] border border-slate-800 px-6 py-8 text-white sm:px-8 sm:py-10">
        <div class="max-w-2xl">
          <p class="eyebrow text-slate-300">Selected work</p>
          <h2 class="mt-2 text-3xl font-semibold text-white">Systems built for operators, not slide decks.</h2>
          <p class="mt-3 text-slate-300">
            Current platform work, commercial systems, field operations infrastructure,
            and product builds tied to real growth, delivery, and visibility outcomes.
          </p>
        </div>
        <div class="mt-8 grid gap-6 xl:grid-cols-3">
          {atlasConsoleProject ? (
            <article class="rounded-2xl border border-white/10 bg-white/5 p-6 sm:p-8">
              <p class="eyebrow text-slate-400">Current platform</p>
              <h3 class="mt-2 text-xl font-semibold text-white">Atlas-Beren Console</h3>
              <p class="mt-1 text-sm text-slate-400">Multi-tenant operations platform for Atlas-Beren Systems</p>
              <p class="mt-3 text-slate-300">
                Prospect acquisition, client workspaces, specialized business agents,
                approval-gated execution, and operator visibility in one production
                control plane.
              </p>
              <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-slate-300">
                <li>Org-scoped RBAC, Supabase Postgres, RLS, and 30+ database migrations</li>
                <li>Agent framework with readiness guards, approval queues, and Vercel Cron</li>
                <li>200+ unit tests validating core platform and agent logic</li>
              </ul>
              <a
                class="focus-ring mt-6 inline-flex text-sm font-semibold text-sky-300 hover:text-white"
                href={`/technical-projects#${atlasConsoleProject.slug}`}
              >
                System overview ->
              </a>
            </article>
          ) : null}

          {kansasCaseStudy ? (
            <article class="rounded-2xl border border-white/10 bg-white/5 p-6 sm:p-8">
              <p class="eyebrow text-slate-400">Case study</p>
              <h3 class="mt-2 text-xl font-semibold text-white">Kansas Electric</h3>
              <p class="mt-3 text-slate-300">{kansasCaseStudy.data.summary}</p>
              <p class="mt-4 text-sm text-slate-400">Outcome: {kansasCaseStudy.data.impact}</p>
              <a
                class="focus-ring mt-6 inline-flex text-sm font-semibold text-sky-300 hover:text-white"
                href="/work/kansas-electric"
              >
                Read case study ->
              </a>
            </article>
          ) : null}

          {freightFlowProject ? (
            <article class="rounded-2xl border border-white/10 bg-white/5 p-6 sm:p-8">
              <p class="eyebrow text-slate-400">Product system</p>
              <h3 class="mt-2 text-xl font-semibold text-white">{freightFlowProject.data.title}</h3>
              <p class="mt-3 text-slate-300">{freightFlowProject.data.summary}</p>
              <p class="mt-4 text-sm text-slate-400">Built around real freight-sales behavior, not generic CRM patterns.</p>
              <a
                class="focus-ring mt-6 inline-flex text-sm font-semibold text-sky-300 hover:text-white"
                href={`/technical-projects#${freightFlowProject.slug}`}
              >
                Product breakdown ->
              </a>
            </article>
          ) : null}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="page-container grid gap-8 lg:grid-cols-[1fr_0.95fr]">
      <div>
        <h2 class="text-3xl font-semibold text-ink">What I build</h2>
        <p class="mt-3 max-w-2xl text-muted">
          I bridge business development, operations, and software architecture. That
          means CRM and pipeline systems, field and delivery tooling, internal apps,
          approval-gated automation, dashboards, and production software tied to
          sustainable growth.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {skillPreview.map((skill) => (
            <span class="inline-flex rounded-lg border border-border bg-panel px-3 py-1.5 text-sm text-ink shadow-[0_8px_18px_rgba(15,23,42,0.05)]">
              {skill}
            </span>
          ))}
        </div>
        <a
          class="mt-6 inline-flex text-sm font-semibold text-accent hover:text-accent-dark"
          href="/skills"
        >
          Full skills page ->
        </a>
      </div>
      <div class="surface p-6 sm:p-8">
        <h3 class="text-lg font-semibold text-ink">How I work</h3>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-muted">
          <li>Start from how work actually moves, not from tool categories</li>
          <li>Make ownership, handoffs, and review points explicit before scaling</li>
          <li>Ship in increments and stay close to the operators using the system</li>
          <li>Tie technical decisions back to growth, delivery, and visibility outcomes</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-panel py-16">
    <div class="page-container">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold text-ink">About</h2>
        <p class="mt-3 text-muted">
          I have built across industrial services, distributed field programs, and
          software — usually in environments where growth, delivery, and visibility
          all have to line up at once.
        </p>
      </div>
      <a
        class="mt-4 inline-flex text-sm font-semibold text-accent hover:text-accent-dark"
        href="/about"
      >
        More background ->
      </a>
    </div>
  </section>

  <section class="py-16">
    <div class="page-container">
      <div class="mx-auto grid max-w-4xl gap-6 rounded-2xl bg-ink px-6 py-10 text-white shadow-[0_18px_50px_rgba(15,23,42,0.25)] sm:px-8 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <h2 class="text-3xl font-semibold">Let's talk</h2>
          <p class="mt-2 max-w-xl text-white/75">
            If you need someone who can understand how the business actually works,
            find the growth bottlenecks, and build the systems to make growth
            repeatable, reach out.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 md:justify-end">
          <a
            class="focus-ring inline-flex w-full items-center justify-center rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-ink sm:w-auto"
            href="mailto:ericm93.2023@outlook.com"
          >
            ericm93.2023@outlook.com
          </a>
          <a
            class="focus-ring inline-flex w-full items-center justify-center rounded-lg border border-white/30 px-5 py-2.5 text-sm font-semibold text-white sm:w-auto"
            href="/resume"
          >
            Resume
          </a>
          <a
            class="focus-ring inline-flex w-full items-center justify-center rounded-lg border border-white/30 px-5 py-2.5 text-sm font-semibold text-white sm:w-auto"
            href="https://www.linkedin.com/in/eric-m-53b374174/"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
