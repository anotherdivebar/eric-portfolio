---
import Base from "../layouts/Base.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import ConsolePreview from "../components/ConsolePreview.astro";

const results = [
  { value: "~$2M", label: "in new work I closed in my first 60 days", source: "Kansas Electric", href: "/work/kansas-electric" },
  { value: "~$4M", label: "in annual revenue at Vale Field Services", source: "I helped grow Vale to 35 employees", href: "/work/program-delivery-at-scale" },
  { value: "$200M+", label: "in the sales pipeline for the next 24 months", source: "Kansas Electric", href: "/work/kansas-electric" }
];
const stories = [
  {
    company: "Kansas Electric", years: "2024–2025", title: "Emergency lighting and relay work for Walmart.",
    body: "A relationship I’d built at Vale helped me win the job. I stayed on to oversee the project managers doing the work in the Midwest and Southeast.",
    href: "/work/kansas-electric"
  },
  {
    company: "Vale Field Services", years: "2019–2024", title: "From first employee to head of operations.",
    body: "I managed four field supervisors and worked with vendors to install restaurant technology. A typical rollout covered hundreds of locations.",
    href: "/work/program-delivery-at-scale"
  }
];
---
<Base title="Eric Martin | Sales Leadership & Business Development" description="Eric Martin built the sales function at Kansas Electric, led field operations at Vale, and founded Atlas-Beren Systems.">
  <section class="hero section-dark" aria-labelledby="hero-heading">
    <div class="home-hero page-container">
      <div class="hero-copy">
        <p class="eyebrow ruled-label">Business development &amp; sales leadership</p>
        <h1 id="hero-heading">I built the sales program at <em>Kansas Electric.</em></h1>
        <p class="hero-intro">When I joined, the project managers were also handling sales. I took over the contractor accounts, followed up on bids, and kept the sales forecast up to date.</p>
        <div class="hero-actions">
          <a class="button-primary" href="#growth-results">See my results</a>
          <a class="quiet-link" href="/resume">View my resume</a>
        </div>
      </div>
      <figure class="portrait">
        <div class="portrait-photo">
          <OptimizedImage src="/eric%202026%20headshot.png" alt="Eric Martin" width="800" height="1200" sizes="(max-width: 640px) 66px, (max-width: 1000px) 33vw, 354px" loading="eager" decoding="sync" fetchpriority="high" />
        </div>
        <figcaption>
          <span class="portrait-name">Eric Martin</span>
          <span>Founder, <a href="/abs-tooling">Atlas-Beren Systems</a></span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section id="growth-results" class="results" aria-label="Sales and growth highlights">
    <div class="page-container proof-band">
      {results.map((item) => (
        <a class="proof-item" href={item.href}>
          <span class="proof-value">{item.value}</span>
          <span class="proof-copy"><span class="proof-label">{item.label}</span><span class="proof-source">{item.source}</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="page-container section-space story-section" aria-labelledby="growth-heading">
    <div class="section-aside">
      <h2 id="growth-heading" class="section-title">Sales and<br /><em>field operations.</em></h2>
      <a class="inline-link" href="/work">All sales &amp; growth stories</a>
    </div>
    <div class="story-list">
      {stories.map((story) => (
        <article class="story">
          <header><p class="story-company">{story.company}</p><p class="story-dates">{story.years}</p></header>
          <h3><a href={story.href}>{story.title}</a></h3>
          <p class="story-body">{story.body}</p>
          <a class="inline-link" href={story.href} aria-label={`Read the ${story.company} case study`}>Read the case study</a>
        </article>
      ))}
    </div>
  </section>

  <section id="selected-work" class="product" aria-labelledby="console-heading">
    <div class="page-container section-space product-inner">
      <div class="product-copy">
        <p class="eyebrow ruled-label">My current work</p>
        <h2 id="console-heading">ABS Console<span>.</span></h2>
        <p class="product-body">A contractor can turn an accepted estimate into a job, track labor and materials, and invoice the customer from the job record.</p>
        <a class="button-primary" href="/abs-tooling">Explore ABS Console</a>
      </div>
      <ConsolePreview />
    </div>
  </section>

  <nav id="more-work-heading" class="page-container more-work" aria-label="More about Eric and his work">
    <a id="approach-heading" href="/skills"><span class="more-title">Skills</span></a>
    <a href="/technical-projects"><span class="more-title">Projects &amp; engineering</span></a>
    <a href="/about"><span class="more-title">About Eric</span></a>
  </nav>
</Base>

<style>
  .hero {
    background: var(--night) url("/images/portfolio-contours.webp") center / cover no-repeat;
    overflow: hidden;
  }
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, .85fr);
    align-items: center;
    column-gap: clamp(2.5rem, 5vw, 5rem);
    padding-block: clamp(3.25rem, 5.1vw, 5.3rem);
  }
  .ruled-label { display: flex; align-items: center; gap: .85rem; font-size: .78rem; letter-spacing: .13em; }
  .ruled-label::before { content: ""; width: 2.4rem; height: 1px; background: currentColor; flex-shrink: 0; }
  .hero-copy h1 { margin-top: 1.4rem; font: 400 clamp(4.8rem, 6.9vw, 6.65rem)/.89 var(--display); letter-spacing: -.025em; }
  .hero-copy h1 em { color: var(--mint); }
  .hero-intro { max-width: 49ch; margin-top: 1.6rem; font-size: clamp(1rem, 1.15vw, 1.08rem); line-height: 1.65; color: #ccdadc; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.6rem; margin-top: 1.65rem; }
  .quiet-link, .inline-link { display: inline-flex; align-items: center; width: fit-content; min-height: 44px; font-size: .9rem; font-weight: 600; text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .quiet-link { color: #e3eeed; text-decoration-color: #688785; }
  .quiet-link:hover { color: var(--mint); text-decoration-color: currentColor; }
  .portrait { width: clamp(248px, 28vw, 354px); max-width: 100%; position: relative; justify-self: center; isolation: isolate; margin-top: .6rem; }
  .portrait::before { content: ""; position: absolute; z-index: -1; inset: -13px -13px 14px 13px; border: 1px solid #86ada6; }
  .portrait-photo { position: relative; background: #29444b; }
  .portrait-photo::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 58%, rgb(10 24 31 / 50%) 81%, rgb(10 24 31 / 96%)); }
  .portrait-photo :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 32%; filter: saturate(.84); }
  .portrait figcaption { display: grid; gap: .12rem; position: absolute; bottom: 1.2rem; left: 1.5rem; right: 1rem; color: #e0e8e6; font-size: .875rem; line-height: 1.6; }
  .portrait-name { color: white; font: italic 2.1rem/1.15 var(--display); }
  .portrait figcaption a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .results { background: #eff2eb; border-bottom: 1px solid var(--line); }
  .proof-band { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding-block: clamp(1.8rem, 3vw, 2.8rem); }
  .proof-item { display: grid; align-content: start; gap: .7rem; padding-inline: clamp(1.5rem, 3.3vw, 3.4rem); border-left: 1px solid #c7d2ca; }
  .proof-item:first-child { padding-left: 0; border: 0; }
  .proof-item:last-child { padding-right: 0; }
  .proof-value { color: var(--ink); font: 400 clamp(3.45rem, 4.6vw, 4.9rem)/.95 var(--display); letter-spacing: -.035em; transition: color .18s; }
  .proof-item:hover .proof-value { color: var(--accent); }
  .proof-copy { display: grid; gap: .3rem; }
  .proof-label { font-size: .975rem; line-height: 1.4; font-weight: 550; }
  .proof-source, .story-dates { font-size: .8125rem; color: var(--muted); }
  .story-section { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 6rem); }
  .section-title em { color: var(--accent); }
  .inline-link { color: var(--accent); text-decoration-color: #8baea4; }
  .inline-link:hover { text-decoration-color: currentColor; }
  .section-aside > a { margin-top: 1.3rem; }
  .story { border-top: 1px solid #c2cec7; padding: 1.45rem 0 1.8rem; }
  .story:last-child { padding-bottom: 0; }
  .story header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .5rem; }
  .story-company { font-size: .9rem; font-weight: 650; color: var(--accent); }
  .story h3 { margin-top: .8rem; font: 400 clamp(2rem, 2.5vw, 2.75rem)/1.12 var(--display); letter-spacing: -.015em; }
  .story h3 a:hover { color: var(--accent); }
  .story-body, .product-body { margin-top: .85rem; font-size: 1rem; line-height: 1.7; color: var(--muted); }
  .story > .inline-link { margin-top: .5rem; }
  .product { border-block: 1px solid #c6d9d0; background: #deebe3; }
  .product-inner { display: grid; grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); }
  .product h2 { margin-top: 1rem; font: 400 clamp(3.6rem, 6vw, 6rem)/1 var(--display); letter-spacing: -.035em; }
  .product h2 span { color: var(--accent); }
  .product-body { max-width: 45ch; }
  .product-copy > a { margin-top: 1.5rem; }
  .more-work { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 3rem; border-block: 1px solid var(--line); }
  .more-work a { display: block; padding: 1.8rem 0; }
  .more-work a + a { border-left: 1px solid var(--line); padding-left: 2.5rem; }
  .more-title { font: 400 clamp(1.75rem, 2.7vw, 2.6rem)/1.15 var(--display); }
  .more-work a:hover .more-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .16em; color: var(--accent); }
  @media (max-width: 900px) {
    .home-hero { grid-template-columns: minmax(0, 1.25fr) minmax(0, .85fr); gap: 2rem; }
    .hero-copy h1 { font-size: clamp(4.15rem, 8.1vw, 4.8rem); }
    .story-section { grid-template-columns: minmax(0, .72fr) minmax(0, 1.28fr); gap: 2.5rem; }
  }
  @media (max-width: 800px) {
    .product-inner { grid-template-columns: 1fr; gap: 2rem; }
    .product-body { max-width: 62ch; }
    .proof-item { padding-inline: 1.25rem; }
    .proof-label { font-size: .9rem; }
  }
  @media (max-width: 640px) {
    .hero { background-position: 37% center; }
    .home-hero { grid-template-columns: 1fr; gap: 1.85rem; padding-block: 2.6rem 2rem; }
    .ruled-label { gap: .65rem; font-size: .75rem; letter-spacing: .085em; }
    .ruled-label::before { width: 1.5rem; }
    .hero-copy h1 { margin-top: 1.2rem; font-size: clamp(3.8rem, 13vw, 5rem); line-height: .96; }
    .hero-intro { max-width: 46ch; margin-top: 1.15rem; }
    .hero-actions { gap: 1.3rem; margin-top: 1.35rem; }
    .portrait { display: flex; align-items: center; gap: .95rem; justify-self: start; width: auto; margin: 0; }
    .portrait::before, .portrait-photo::after { display: none; }
    .portrait-photo { width: 66px; border: 1px solid #64827e; padding: 3px; }
    .portrait-photo :global(img) { aspect-ratio: 1; object-position: 50% 27%; }
    .portrait figcaption { position: static; font-size: .8125rem; }
    .portrait-name { font-size: 1.65rem; }
    .proof-band { grid-template-columns: 1fr; padding-block: .35rem; }
    .proof-item, .proof-item:first-child, .proof-item:last-child { grid-template-columns: minmax(6.5rem, .72fr) 1.6fr; align-items: center; gap: .9rem; border: 0; padding: 1rem 0; }
    .proof-item + .proof-item { border-top: 1px solid #c7d2ca; }
    .proof-value { font-size: clamp(2.8rem, 9vw, 3.4rem); }
    .proof-copy { gap: .25rem; }
    .proof-source { font-size: .75rem; }
    .story-section { grid-template-columns: 1fr; gap: 1.5rem; }
    .section-aside > a { margin-top: .55rem; }
    .more-work { grid-template-columns: 1fr; }
    .more-work a + a { border-left: 0; border-top: 1px solid var(--line); padding-left: 0; }
    .more-work a { padding-block: 1.3rem; }
  }
</style>
