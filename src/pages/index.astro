---
import Base from "../layouts/Base.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
const proof = [
  { value: "~$2M", label: "New work closed in my first 60 days", note: "Kansas Electric · 2024–25", href: "/work/kansas-electric" },
  { value: "~$4M", label: "Annual revenue at a company I helped grow", note: "Vale Field Services · From startup to 35 employees", href: "/work/program-delivery-at-scale" },
  { value: "$200M+", label: "Forward pipeline over 24 months", note: "Kansas Electric · Pipeline, separate from closed work", href: "/work/kansas-electric" }
];
const approach = [
  { title: "Earn the conversation.", body: "Build trust through curiosity, preparation, and consistent follow-up. Learn what matters to the person across the table." },
  { title: "Understand the need.", body: "Get clear on the problem, its cost to the business, and what a better outcome would look like." },
  { title: "Connect the right solution.", body: "Show how a service or capability solves that specific problem. Make the value and next step clear." },
  { title: "Follow through and grow.", body: "Stay close through delivery. Keep commitments visible and find the next opportunity as the relationship develops." }
];
---
<Base title="Eric Martin — Sales Leadership & Business Development" description="Sales leadership built on customer understanding. Explore Eric Martin's revenue results, operational experience, and current work as founder of Atlas-Beren Systems.">
  <section class="home-hero page-container" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow"><span aria-hidden="true"></span> Business development & sales leadership</p>
      <h1 id="hero-heading">I turn customer<br /><em>relationships</em><br />into revenue.</h1>
      <p class="hero-intro">I build trust, close new work, and stay accountable through delivery. My experience spans sales leadership, national field operations, and the software that connects them.</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="button-primary" href="#growth-results">See my results <span aria-hidden="true">↓</span></a>
        <a class="button-secondary" href="/resume">View my resume <span aria-hidden="true">→</span></a>
      </div>
      <p class="hero-current">Currently building <a href="/abs-tooling">ABS Console</a> · Founder, Atlas-Beren Systems</p>
    </div>
    <div class="portrait-composition">
      <div class="portrait-frame">
        <OptimizedImage src="/eric%202026%20headshot.png" alt="Eric Martin" width="560" height="700" sizes="(max-width: 700px) 120px, 310px" loading="eager" fetchpriority="high" />
      </div>
      <div class="portrait-caption"><span class="eyebrow">Eric Martin</span><p>Commercial instinct.<br />Operational experience.<br />Technical depth.</p></div>
    </div>
  </section>

  <section class="page-container" aria-label="Sales and growth highlights">
    <div class="proof-band">
      {proof.map((item) => <a href={item.href} class="proof-item"><span class="proof-value">{item.value}</span><span class="proof-label">{item.label}</span><span class="proof-note">{item.note}</span><span class="proof-arrow" aria-hidden="true">↗</span></a>)}
    </div>
  </section>

  <section id="growth-results" class="section-space page-container" aria-labelledby="growth-heading">
    <div class="section-heading-row">
      <div><p class="eyebrow">Relationships into results</p><h2 id="growth-heading" class="section-title mt-4 max-w-2xl">Win the work.<br />Build the ability to deliver.</h2></div>
      <a class="text-link" href="/work">All sales & growth stories <span aria-hidden="true">↗</span></a>
    </div>
    <div class="growth-grid">
      <article class="growth-story growth-story-current">
        <div class="story-top"><span class="eyebrow">Atlas-Beren Systems</span><span class="story-year story-year-current">Founder · 2026—Present</span></div>
        <h3>Built a platform around the customer journey.</h3>
        <p>I founded Atlas-Beren Systems and built ABS Console to connect sales, delivery, and finance for trade and field-service businesses.</p>
        <div class="story-detail"><span>Product ownership, end to end</span><p>Seven connected modules. Product direction, design, and full-stack engineering.</p></div>
        <a class="text-link" href="/abs-tooling">Explore ABS Console <span aria-hidden="true">→</span></a>
      </article>
      <article class="growth-story">
        <div class="story-top"><span class="eyebrow">Kansas Electric</span><span class="story-year">2024—2025</span></div>
        <h3>Built a sales function. Closed ~$2M in 60 days.</h3>
        <p>I developed contractor and business-owner relationships, then built the sales process and marketing function to support them.</p>
        <div class="story-detail"><span>From discovery through delivery</span><p>Account development, brand and campaigns, and continued ownership of customer commitments.</p></div>
        <a class="text-link" href="/work/kansas-electric">Read the Kansas Electric story <span aria-hidden="true">→</span></a>
      </article>
      <article class="growth-story growth-story-tint">
        <div class="story-top"><span class="eyebrow">Vale Field Services</span><span class="story-year">2019—2024</span></div>
        <h3>From employee one to leading a 35-person operation.</h3>
        <p>I joined as employee one, building customer relationships in the field, then led operations as the business grew to 35 employees.</p>
        <div class="story-detail"><span>Built the capacity to keep growing</span><p>I connected customer needs to staffing, vendor networks, and delivery standards for restaurant technology rollouts across the U.S. and Canada.</p></div>
        <a class="text-link" href="/work/program-delivery-at-scale">Read the Vale story <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <section id="selected-work" class="console-feature section-dark" aria-labelledby="console-heading">
    <div class="page-container section-space">
      <div class="console-feature-heading">
        <div><p class="eyebrow">My current work · Atlas-Beren Systems</p><h2 id="console-heading">ABS Console<span>.</span></h2><p class="console-subtitle">From the first conversation<br />to the final invoice.</p></div>
        <div class="console-feature-intro"><p>Customer commitments often get scattered across a CRM, spreadsheets, and field notes. I built ABS Console to keep sales, delivery, and financial records connected, so each team can pick up where the last one left off.</p><a class="button-primary mt-6" href="/abs-tooling">Explore the product & engineering <span aria-hidden="true">→</span></a></div>
      </div>
      <a href="/abs-tooling" class="console-preview-link" aria-label="Explore the updated ABS Console and its seven modules">
        <div class="preview-toolbar"><span><i></i><i></i><i></i></span><span>ABS Console / Your business, connected</span><span aria-hidden="true">↗</span></div>
        <div class="console-preview"><OptimizedImage src="/assets/abs-console/today-desktop.png" alt="ABS Console demo workspace with daily priorities and connected sales, delivery, and finance navigation" width="1265" height="1189" sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1264px) calc(100vw - 64px), 1200px" /></div>
      </a>
      <div class="console-feature-bottom"><p>7 connected modules <span aria-hidden="true">/</span> Product, architecture & implementation</p><p>Next.js · React · TypeScript · Supabase</p></div>
      <p class="mt-3 text-xs text-[#aebfb3]">Current interface, October 2026. Screenshots show a demo workspace with sample data.</p>
    </div>
  </section>

  <section class="section-space page-container" aria-labelledby="approach-heading">
    <div class="section-heading-row"><div><p class="eyebrow">How I work</p><h2 id="approach-heading" class="section-title mt-4 max-w-2xl">Understand the need.<br />Earn the next step.</h2></div><p class="max-w-sm leading-relaxed text-muted">A practical approach to moving a relationship from first conversation to delivered work.</p></div>
    <ol class="approach-grid">
      {approach.map((step) => <li><h3>{step.title}</h3><p>{step.body}</p></li>)}
    </ol>
    <a class="text-link mt-8" href="/skills">Explore the capabilities behind the work <span aria-hidden="true">↗</span></a>
  </section>

  <section class="page-container pb-12" aria-labelledby="more-work-heading">
    <div class="more-work-header"><p class="eyebrow">A broader perspective</p><h2 id="more-work-heading" class="section-title mt-4">Business experience.<br />Hands-on engineering.</h2><p class="mt-5 max-w-2xl leading-relaxed text-muted">I have developed relationships, closed new work, led national field delivery, and built software. That range helps me connect what a customer needs with what a business can deliver.</p></div>
    <div class="more-work-grid">
      <a href="/technical-projects" class="work-link"><span class="eyebrow">Builds & systems</span><span class="work-link-title">Explore the engineering.</span><span class="text-sm text-muted">Product websites, internal applications, and live systems.</span><span class="work-link-arrow" aria-hidden="true">↗</span></a>
      <a href="/about" class="work-link"><span class="eyebrow">The person behind the work</span><span class="work-link-title">Get to know me.</span><span class="text-sm text-muted">My background, principles, and what I bring to a team.</span><span class="work-link-arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>
<style>
  .home-hero { display: grid; grid-template-columns: 1.45fr .75fr; gap: clamp(36px, 6vw, 80px); align-items: center; padding-block: 40px; }
  .hero-eyebrow { display: flex; align-items: center; gap: 10px; }
  .hero-eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: #176958; flex-shrink: 0; }
  h1 { margin-top: 18px; font-size: clamp(2.65rem, 4.7vw, 4.25rem); line-height: 1.06; font-weight: 550; letter-spacing: -.055em; }
  h1 em { color: #176958; font-style: normal; }
  .hero-intro { margin-top: 20px; max-width: 530px; font-size: 1rem; line-height: 1.75; color: #5d6a63; }
  .hero-current { margin-top: 20px; font-size: .75rem; line-height: 1.7; color: #5d6a63; }
  .hero-current a { color: #176958; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .portrait-composition { position: relative; width: 100%; max-width: 310px; justify-self: end; padding-left: 18px; }
  .portrait-frame { overflow: hidden; border-radius: 160px 160px 20px 20px; background: #dae2d5; }
  .portrait-frame :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4/4.5; object-fit: cover; object-position: center top; }
  .portrait-caption { position: relative; margin: -72px 20px 0 -18px; width: fit-content; background: #eaf2df; border: 1px solid #dce6d3; border-radius: 12px; padding: 16px 20px; box-shadow: 0 10px 30px rgb(23 35 31 / 5%); }
  .portrait-caption p { font-size: .88rem; line-height: 1.55; font-weight: 500; margin-top: 6px; }
  .proof-band { border-block: 1px solid #cfd9cf; display: grid; grid-template-columns: repeat(3, 1fr); padding: 24px 0; }
  .proof-item { position: relative; display: flex; flex-direction: column; padding: 0 32px; border-left: 1px solid #dce3dc; }
  .proof-item:first-child { padding-left: 0; border: 0; }
  .proof-item:last-child { padding-right: 0; }
  .proof-value { font-size: clamp(2.3rem, 3.8vw, 3.4rem); line-height: 1; letter-spacing: -.06em; font-weight: 550; }
  .proof-label { font-size: .88rem; line-height: 1.5; margin-top: 12px; max-width: 250px; }
  .proof-note { font-size: .68rem; line-height: 1.6; color: #5d6a63; margin-top: 8px; }
  .proof-arrow { position: absolute; top: 0; right: 32px; color: #176958; font-size: 22px; transition: transform .2s; }
  .proof-item:hover .proof-arrow { transform: translate(3px,-3px); }
  .section-heading-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 36px; }
  .growth-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24px; margin-top: 40px; }
  .growth-story { display: flex; flex-direction: column; padding: clamp(24px,2.3vw,32px); border: 1px solid #dce3dc; background: #fff; border-radius: 18px; }
  .growth-story-current { background: #eaf2df; border-color: #c8d9bf; }
  .growth-story-tint { background: #edf1e9; }
  .story-top { display: grid; gap: 8px; }
  .story-top .eyebrow { font-size: .78rem; letter-spacing: .1em; }
  .story-year { font-size: .82rem; color: #5d6a63; }
  .story-year-current { color: #176958; font-weight: 650; }
  .growth-story h3 { font-size: clamp(1.45rem,2vw,1.75rem); line-height: 1.25; font-weight: 550; margin-top: 22px; }
  .growth-story > p { margin-top: 18px; font-size: .94rem; line-height: 1.7; color: #5d6a63; }
  .growth-story > a { align-self: flex-start; margin-top: auto; padding-top: 26px; }
  .story-detail { margin-top: 22px; border-top: 1px solid #dce3dc; padding-top: 18px; }
  .story-detail > span { font-size: .75rem; font-weight: 600; color: #176958; }
  .story-detail p { margin-top: 10px; font-size: .85rem; line-height: 1.7; color: #5d6a63; }
  .console-feature { overflow: hidden; }
  .console-feature-heading { display: grid; grid-template-columns: 1.2fr 1fr; gap: 70px; align-items: end; }
  .console-feature h2 { margin-top: 22px; font-size: clamp(2.8rem, 5vw, 4.6rem); line-height: 1; font-weight: 550; letter-spacing: -.055em; }
  .console-feature h2 span { color: #ccebb8; }
  .console-subtitle { margin-top: 18px; font-size: clamp(1.1rem,2vw,1.5rem); color: #d8e3da; }
  .console-feature-intro > p { color: #bdcec4; font-size: .95rem; line-height: 1.8; }
  .console-preview-link { display: block; margin-top: 46px; overflow: hidden; border: 1px solid #60786c; border-radius: 14px; background: #0b1b18; box-shadow: 0 24px 70px rgb(0 0 0 / 12%); }
  .preview-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 13px 18px; font-size: .65rem; color: #bdcec4; }
  .preview-toolbar > span:first-child { display: flex; gap: 5px; }
  .preview-toolbar i { width: 6px; height: 6px; border-radius: 50%; background: #789287; }
  .console-preview { max-height: 560px; overflow: hidden; }
  .console-preview :global(img) { width: 100%; height: auto; display: block; }
  .console-feature-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 14px; margin-top: 24px; font-size: .77rem; color: #d8e3da; }
  .console-feature-bottom span { color: #7f9b8a; margin-inline: 10px; }
  .approach-grid { margin-top: 45px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .approach-grid li { border-top: 1px solid #bbcbbc; padding-top: 22px; }
  .approach-grid h3 { font-size: 1.2rem; line-height: 1.3; font-weight: 600; }
  .approach-grid p { margin-top: 14px; color: #5d6a63; font-size: .88rem; line-height: 1.8; }
  .more-work-header { border-top: 1px solid #dce3dc; padding-top: 40px; }
  .more-work-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 35px; }
  .work-link { display: flex; flex-direction: column; gap: 14px; position: relative; padding: 28px; border: 1px solid #dce3dc; border-radius: 14px; transition: background .2s; }
  .work-link:hover { background: #eaf0e5; }
  .work-link-title { font-size: 1.45rem; font-weight: 550; letter-spacing: -.035em; }
  .work-link-arrow { position: absolute; right: 28px; top: 24px; color: #176958; font-size: 24px; }
  @media (max-width: 1023px) { .home-hero { grid-template-columns: 1.3fr .8fr; gap: 30px; } .portrait-caption { padding: 18px; margin-right: 0; } .proof-item { padding-inline: 24px; } .proof-arrow { right: 20px; } .growth-grid { grid-template-columns: 1fr; } .console-feature-heading { gap: 35px; } .approach-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 700px) { .home-hero { grid-template-columns: 1fr; padding-block: 42px; gap: 30px; } h1 { font-size: clamp(2.75rem,8vw,3.8rem); } .hero-eyebrow { font-size: .6rem; } .portrait-composition { display: none; } .hero-intro { font-size: 1rem; } .proof-band { grid-template-columns: 1fr; padding: 0; } .proof-item, .proof-item:first-child, .proof-item:last-child { padding: 24px 0; border-left: 0; border-top: 1px solid #dce3dc; } .proof-item:first-child { border-top: 0; } .proof-value { font-size: 2.7rem; } .proof-label { max-width: none; } .proof-arrow { top: 25px; right: 0; } .growth-grid, .console-feature-heading, .more-work-grid { grid-template-columns: 1fr; } .section-heading-row { align-items: flex-start; flex-direction: column; gap: 24px; } .console-preview { max-height: 330px; } .console-preview :global(img) { min-width: 0; } .console-feature-bottom { font-size: .7rem; } .console-feature-bottom span { margin-inline: 3px; } .preview-toolbar { font-size: .55rem; gap: 10px; padding-inline: 12px; } }
  @media (max-width: 420px) { .approach-grid { grid-template-columns: 1fr; gap: 28px; } }
  @media (max-width: 700px) {
    .hero-copy .button-primary, .hero-copy .button-secondary { padding-inline: 16px; font-size: .82rem; gap: 8px; }
    .portrait-composition { display: flex; align-items: center; gap: 18px; justify-self: start; max-width: none; padding: 0; }
    .portrait-frame { width: 96px; height: 108px; flex-shrink: 0; border-radius: 50px 50px 10px 10px; }
    .portrait-caption { padding: 0; margin: 0; border: 0; background: transparent; box-shadow: none; }
    .portrait-caption p { font-size: .78rem; }
    .console-preview :global(img) { min-width: 0; }
    .proof-note { font-size: .75rem; }
  }
</style>
