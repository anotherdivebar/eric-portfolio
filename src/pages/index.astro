---
import Base from "../layouts/Base.astro";

const proofPoints = [
  { value: "~$2M", label: "closed in the first 60 days", context: "Kansas Electric · 2024–25 role", href: "/work/kansas-electric" },
  { value: "$100M+", label: "opportunities presented", context: "Kansas Electric · 2025", href: "/work/kansas-electric" },
  { value: "$200M+", label: "forward 24-month pipeline", context: "Kansas Electric · 2024–25 role", href: "/work/kansas-electric" },
  { value: "~$4M", label: "annual operating scale", context: "Vale Field Services", href: "/work/program-delivery-at-scale" }
];
const selectedWork = [
  {
    label: "Connected business platform", title: "ABS Tooling", href: "/abs-tooling",
    image: "/assets/atlas-beren/workspace-overview.png", alt: "ABS Console overview with business workflow modules", width: 1264, height: 625,
    body: "Prospect research, outreach, project delivery, cash planning, and field operations connected through one workspace.",
    detail: "Explore the workflows, engineering decisions, and estimate-to-invoice lifecycle.", cta: "Explore the full build"
  },
  {
    label: "Commercial and operational systems", title: "Kansas Electric", href: "/work/kansas-electric",
    image: "/assets/kse/CRM%20Main.png", alt: "Kansas Electric internal CRM workspace", width: 1255, height: 942,
    body: "Business development paired with CRM, estimating, and field-reporting tools for an electrical contractor.",
    detail: "See the commercial context and the applications built to support day-to-day work.", cta: "Read the case study"
  },
  {
    label: "Freight sales workspace", title: "FreightFlow AI", href: "/technical-projects/freight-flow-ai",
    image: "/assets/freightflow/finder-overview.png", alt: "FreightFlow shipper finder and account research", width: 1024, height: 512,
    body: "Shipper discovery, account briefs, public contact research, and a shared pipeline for a small brokerage team.",
    detail: "Follow an account from discovery through research and sales follow-up.", cta: "Read the project breakdown"
  }
];
const approach = [
  { number: "01", title: "Understand the work", body: "Trace how an opportunity becomes a commitment, how work reaches the field, and where people lose context or wait for a decision." },
  { number: "02", title: "Build around the handoffs", body: "Make ownership, required information, and review points explicit. Then build the application, integration, or automation that supports them." },
  { number: "03", title: "Stay through delivery", body: "Test the difficult cases, work through rollout, and keep the reporting useful to both the person doing the work and the person accountable for it." }
];
---

<Base title="Eric Martin - Revenue Operations & Technical Systems Leader" description="Eric Martin connects business development, field operations, and software. Explore ABS Tooling, Kansas Electric, FreightFlow AI, and the systems behind the work.">
  <section class="pb-12 pt-10 sm:pt-14">
    <div class="page-container">
      <div class="section-dark overflow-hidden rounded-[32px] border border-slate-800 px-6 py-9 text-white sm:px-10 sm:py-12">
        <div class="grid items-center gap-9 lg:grid-cols-[1.6fr_0.8fr] lg:gap-14">
          <div>
            <p class="eyebrow">Revenue operations / systems / software</p>
            <h1 class="mt-4 max-w-2xl text-4xl font-semibold leading-tight sm:text-5xl">I connect growth, operations, and software.</h1>
            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-300">I build the systems behind the work: finding opportunities, managing delivery, and giving people a clear next step. My background spans business development, national field programs, and hands-on software engineering.</p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a class="focus-ring inline-flex min-h-11 items-center justify-center rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-white hover:bg-accent-dark" href="#selected-work">Explore my work ↓</a>
              <a class="focus-ring inline-flex min-h-11 items-center justify-center rounded-lg border border-white/25 px-5 py-3 text-sm font-semibold text-white hover:bg-white/10" href="/resume">View resume →</a>
            </div>
          </div>
          <img src="/eric%202026%20headshot.png" alt="Eric Martin" width="560" height="700" class="mx-auto aspect-[4/5] w-full max-w-[250px] rounded-2xl border border-white/15 object-cover lg:max-w-[280px]" decoding="async" fetchpriority="high" />
        </div>
        <div class="mt-9 grid grid-cols-2 gap-x-5 gap-y-7 border-t border-white/15 pt-7 lg:grid-cols-4">
          {proofPoints.map((item) => (
            <a href={item.href} class="focus-ring rounded-md">
              <p class="text-2xl font-semibold tabular-nums tracking-tight text-white sm:text-3xl">{item.value}</p>
              <p class="mt-1 text-sm leading-snug text-slate-200">{item.label}</p>
              <p class="mt-2 text-xs leading-relaxed text-slate-400">{item.context}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="selected-work" class="py-8 sm:py-12" aria-labelledby="selected-work-heading">
    <div class="page-container">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div class="max-w-2xl">
          <p class="eyebrow">Selected work</p>
          <h2 id="selected-work-heading" class="mt-2 text-3xl font-semibold">The systems, and the problems behind them.</h2>
          <p class="mt-3 text-muted">Detailed examples of what I designed, built, and operated.</p>
        </div>
        <a class="focus-ring text-sm font-semibold text-accent hover:text-accent-dark" href="/technical-projects">All projects →</a>
      </div>
      <div class="mt-7 grid gap-6 lg:grid-cols-3">
        {selectedWork.map((project) => (
          <article class="surface flex flex-col overflow-hidden">
            <a class="focus-ring block border-b border-border bg-panel p-3" href={project.href} aria-label={`Explore ${project.title}`}>
              <img src={project.image} alt={project.alt} width={project.width} height={project.height} class="aspect-[16/10] w-full rounded-lg object-contain" loading="lazy" decoding="async" />
            </a>
            <div class="flex flex-1 flex-col p-6">
              <p class="eyebrow">{project.label}</p>
              <h3 class="mt-2 text-2xl font-semibold">{project.title}</h3>
              <p class="mt-3 leading-relaxed text-muted">{project.body}</p>
              <p class="mt-4 text-sm leading-relaxed text-muted">{project.detail}</p>
              <a class="focus-ring mt-6 inline-flex self-start text-sm font-semibold text-accent hover:text-accent-dark" href={project.href}>{project.cta} →</a>
            </div>
          </article>
        ))}
      </div>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold">
        <a class="focus-ring text-accent hover:text-accent-dark" href="/work">Business experience & case studies →</a>
        <a class="focus-ring text-accent hover:text-accent-dark" href="/eden">Eden engineering →</a>
      </div>
    </div>
  </section>

  <section class="py-10 sm:py-14" aria-labelledby="approach-heading">
    <div class="page-container">
      <p class="eyebrow">How I work</p>
      <h2 id="approach-heading" class="mt-2 text-3xl font-semibold">From a visible problem to a working system.</h2>
      <div class="mt-7 grid gap-6 md:grid-cols-3">
        {approach.map((step) => (
          <div class="border-t-2 border-accent pt-5">
            <p class="text-sm font-semibold tabular-nums text-accent">{step.number}</p>
            <h3 class="mt-3 text-xl font-semibold">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{step.body}</p>
          </div>
        ))}
      </div>
      <a class="focus-ring mt-7 inline-flex text-sm font-semibold text-accent hover:text-accent-dark" href="/skills">See the skills behind the work →</a>
    </div>
  </section>

  <section class="py-8 sm:py-12">
    <div class="page-container grid gap-6 md:grid-cols-2">
      <div class="surface-muted p-6 sm:p-8">
        <p class="eyebrow">Background</p>
        <h2 class="mt-2 text-2xl font-semibold">An operator who builds.</h2>
        <p class="mt-3 leading-relaxed text-muted">My work has moved across industrial services, distributed field delivery, and software. The common thread is making the commercial promise and the delivery reality line up.</p>
        <a class="focus-ring mt-5 inline-flex text-sm font-semibold text-accent hover:text-accent-dark" href="/about">More about me →</a>
      </div>
      <div class="section-dark rounded-2xl p-6 text-white sm:p-8">
        <p class="eyebrow">Start a conversation</p>
        <h2 class="mt-2 text-2xl font-semibold">What needs to work better?</h2>
        <p class="mt-3 leading-relaxed text-slate-300">If the challenge crosses growth, operations, and software, I would like to hear about it.</p>
        <a class="focus-ring mt-5 inline-flex rounded-lg bg-white px-5 py-3 text-sm font-semibold text-ink" href="/contact">Let's talk →</a>
      </div>
    </div>
  </section>
</Base>
