---
import Base from "../layouts/Base.astro";

const responsibilities = [
  { title: "Server systems & persistence", detail: "I modeled player data and maintained the checks that run when the server updates a player’s state." },
  { title: "Support & moderation tools", detail: "I built the tools that support staff used to investigate reports, maintain player data, and escalate suspected abuse." },
  { title: "Game design & balance", detail: "I designed changes to gameplay and implemented balance adjustments in the C# server." }
];

const challenges = [
  { title: "Simultaneous player actions", detail: "When players acted on the same world at once, the server had to keep their active sessions and saved data in sync." },
  { title: "Unpredictable load", detail: "During peak events, I used telemetry to find performance bottlenecks and shipped hotfixes while the game was live." },
  { title: "Existing player data", detail: "Migrations had to preserve progress for players returning after an update." }
];
---

<Base title="Eden Multiplayer Game Engineering | Eric Martin" description="Eric Martin’s engineering and design work on Eden, a multiplayer game with a community of about 30,000 players. Built with C#, .NET, and PostgreSQL.">
  <section class="page-heading">
    <div class="page-container-mid">
      <a href="/technical-projects" class="text-link">← All projects</a>
      <div class="mt-10 sm:mt-12">
        <h1 class="page-title">Eden</h1>
        <p class="mt-5 max-w-2xl text-2xl font-medium leading-snug text-ink sm:text-3xl">A multiplayer game that saved each player’s progress between sessions.</p>
        <dl class="surface-muted mt-10 grid gap-8 p-7 sm:mt-12 sm:grid-cols-2 sm:p-9">
          <div><dt class="eyebrow">Community grew to</dt><dd class="mt-4"><span class="block text-4xl font-medium tracking-tight text-accent">~30,000</span><span class="mt-2 block text-sm text-muted">players</span></dd></div>
          <div class="border-t border-border pt-6 sm:border-l sm:border-t-0 sm:pl-7 sm:pt-0"><dt class="eyebrow">Core stack</dt><dd class="mt-4 text-lg font-medium leading-relaxed">C# / .NET game server<br />PostgreSQL player data<br />JavaScript support tools</dd></div>
        </dl>
      </div>

      <section class="section-space" aria-labelledby="ownership-heading">
        <h2 id="ownership-heading" class="text-3xl font-semibold text-ink sm:text-4xl">Game server and staff tools</h2>
        <div class="mt-9 grid gap-x-12 gap-y-8 md:grid-cols-3">
          {responsibilities.map((item) => (
            <article class="border-t border-border pt-6">
              <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{item.detail}</p>
            </article>
          ))}
        </div>
      </section>

      <section aria-labelledby="challenges-heading">
        <h2 id="challenges-heading" class="text-3xl font-semibold text-ink sm:text-4xl">Keeping the world running</h2>
        <div class="mt-8 space-y-4">
          {challenges.map((item) => (
            <article class="surface p-6 sm:p-8">
              <div><h3 class="text-lg font-semibold text-ink">{item.title}</h3><p class="mt-3 text-sm leading-relaxed text-muted">{item.detail}</p></div>
            </article>
          ))}
        </div>
      </section>

      <section class="section-space grid gap-8 md:grid-cols-2 md:gap-12" aria-labelledby="operations-heading">
        <div>
          <h2 id="operations-heading" class="text-3xl font-semibold text-ink">Release and recovery</h2>
        </div>
        <div class="border-t border-border pt-6">
          <ul class="list-disc space-y-4 pl-5 text-sm leading-relaxed text-muted marker:text-accent">
            <li>Structured logging, metrics, and audit trails for investigation</li>
            <li>GitHub-based build and release automation</li>
            <li>Versioned releases, recovery playbooks, and rollback planning</li>
          </ul>
        </div>
      </section>

      <div class="surface-muted p-7 sm:p-10">
        <h2 class="text-2xl font-semibold text-ink">From Eden to ABS Console</h2>
        <p class="mt-4 max-w-3xl leading-relaxed text-muted">I drew on my experience operating Eden when building permission checks, audit histories, and recovery tools for ABS Console.</p>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
          <a href="/abs-tooling" class="text-link">Explore ABS Console <span aria-hidden="true">↗</span></a>
          <a href="/contact" class="text-link">Contact Eric</a>
        </div>
      </div>
    </div>
  </section>
</Base>
