---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("technical-projects");
  return projects.filter((project) => !project.data.detailUrl).map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const { Content, headings } = await project.render();
const sections = headings.filter((heading) => heading.depth === 2);
const isBrief = !project.body?.trim();
const facts = [
  { title: "Constraints", items: project.data.constraints },
  { title: "Technology", items: project.data.stack },
  { title: "Key decisions", items: project.data.decisions },
  { title: "Tradeoffs", items: project.data.tradeoffs }
];
---

<Base title={`${project.data.title} - Eric Martin`} description={project.data.summary}>
  <section class="page-heading">
    <div class="page-container-mid">
      <a class="text-link" href={`/technical-projects#${project.slug}`}>← All projects</a>
      <header class="mt-10 sm:mt-12">
        <p class="eyebrow">{isBrief ? "System brief" : "Project breakdown"}</p>
        <h1 class="page-title mt-5">{project.data.title}</h1>
        <p class="page-intro mt-7">{project.data.summary}</p>
      </header>
      <div class="mt-10 grid gap-8 border-y border-border py-8 md:grid-cols-2 md:gap-12 sm:mt-12 sm:py-10">
        <section aria-labelledby="project-problem"><h2 id="project-problem" class="eyebrow">The problem</h2><p class="mt-4 leading-relaxed text-muted">{project.data.why}</p></section>
        <section class="md:border-l md:border-border md:pl-12" aria-labelledby="project-result"><h2 id="project-result" class="eyebrow">What the build provides</h2><p class="mt-4 leading-relaxed text-ink">{project.data.outcome}</p></section>
      </div>
      {sections.length > 1 && (
        <nav aria-label="Project sections" class="surface-muted mt-8 p-6 sm:p-7">
          <p class="eyebrow">In this project</p>
          <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-3">
            {sections.map((section) => (<li><a class="focus-ring text-sm font-medium text-accent hover:text-accent-dark" href={`#${section.slug}`}>{section.text}</a></li>))}
            <li><a class="focus-ring text-sm font-medium text-accent hover:text-accent-dark" href="#implementation">Build details</a></li>
          </ul>
        </nav>
      )}
      {!isBrief && <article class="prose mt-12 max-w-none"><Content /></article>}
      <section id="implementation" class="section-space" aria-labelledby="implementation-heading">
        <p class="eyebrow">Behind the interface</p>
        <h2 id="implementation-heading" class="mt-4 text-3xl font-semibold sm:text-4xl">Build details</h2>
        <div class="mt-9 grid gap-x-12 gap-y-9 md:grid-cols-2">
          {facts.map((fact) => (
            <div class="border-t border-border pt-6"><h3 class="text-lg font-semibold">{fact.title}</h3><ul class="mt-4 list-disc space-y-3 pl-5 text-sm leading-relaxed text-muted marker:text-accent">{fact.items.map((item) => (<li>{item}</li>))}</ul></div>
          ))}
        </div>
      </section>
      <div class="flex flex-wrap items-center justify-between gap-5 border-t border-border pt-8">
        <a class="text-link" href="/technical-projects">← Explore more projects</a>
        <a class="button-primary" href="/contact">Talk about a similar challenge <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>
