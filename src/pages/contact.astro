---
import Base from "../layouts/Base.astro";

const conversationStarters = [
  "A sales or follow-up process that needs clearer ownership",
  "A handoff between the office, field, and delivery team",
  "An internal tool or AI workflow that needs to become dependable"
];
---

<Base title="Contact Eric Martin" description="Contact Eric Martin about revenue operations, field and service workflows, internal applications, or software engineering. Reach him by email, phone, or LinkedIn.">
  <section class="py-14 sm:py-16">
    <div class="page-container-mid">
      <div class="max-w-2xl">
        <p class="eyebrow">Contact</p>
        <h1 class="mt-3 text-4xl font-semibold leading-tight text-ink sm:text-5xl">Let’s talk about the work.</h1>
        <p class="mt-5 text-lg leading-relaxed text-muted">Whether the challenge is growth, field operations, or software, start with what the team is trying to do and where the process gets stuck.</p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-[1.2fr_1fr]">
        <div class="section-dark rounded-2xl p-6 text-white sm:p-8">
          <p class="eyebrow">Reach me directly</p>
          <h2 class="mt-3 text-2xl font-semibold">Send me a note.</h2>
          <p class="mt-3 leading-relaxed text-slate-300">A little context is useful: what you are building, who uses it, and what needs to work better.</p>
          <a
            class="focus-ring mt-6 inline-flex max-w-full items-center justify-center break-all rounded-lg bg-white px-4 py-3 text-sm font-semibold text-ink transition hover:bg-slate-100 sm:px-5"
            href="mailto:ericm93.2023@outlook.com"
          >
            ericm93.2023@outlook.com
          </a>
          <div class="mt-8 border-t border-white/15 pt-6">
            <h3 class="text-sm font-semibold text-white">A few places to start</h3>
            <ul class="mt-4 list-disc space-y-3 pl-5 text-sm leading-relaxed text-slate-300">
              {conversationStarters.map((starter) => <li>{starter}</li>)}
            </ul>
          </div>
        </div>

        <div class="grid gap-6">
          <div class="surface p-6 sm:p-8">
            <h2 class="text-xl font-semibold text-ink">Phone</h2>
            <p class="mt-2 text-muted">Call or text if that is easier.</p>
            <a
              class="focus-ring mt-5 inline-flex text-lg font-semibold text-accent hover:text-accent-dark"
              href="tel:+13162149102"
            >
              (316) 214-9102
            </a>
          </div>
          <div class="surface p-6 sm:p-8">
            <h2 class="text-xl font-semibold text-ink">LinkedIn</h2>
            <p class="mt-2 text-muted">Connect or continue the conversation there.</p>
            <a
              class="focus-ring mt-5 inline-flex text-sm font-semibold text-accent hover:text-accent-dark"
              href="https://www.linkedin.com/in/eric-m-53b374174/"
            >
              Connect on LinkedIn <span class="ml-2" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>

      <div class="mt-10 flex flex-col justify-between gap-5 border-t border-border pt-7 sm:flex-row sm:items-center">
        <p class="text-muted">Want more context before reaching out?</p>
        <div class="flex flex-wrap gap-x-6 gap-y-3">
          <a class="focus-ring text-sm font-semibold text-accent hover:text-accent-dark" href="/technical-projects">Explore the projects <span aria-hidden="true">→</span></a>
          <a class="focus-ring text-sm font-semibold text-accent hover:text-accent-dark" href="/resume">View my resume <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>
