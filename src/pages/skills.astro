---
import Base from "../layouts/Base.astro";

const capabilities = [
  {
    title: "Contractor accounts",
    description: "After I won Walmart’s emergency lighting work for Kansas Electric, I stayed on as Walmart’s contact and oversaw the project managers in the Midwest and Southeast.",
    evidence: "How I won the Walmart project at Kansas Electric",
    href: "/work/kansas-electric"
  },
  {
    title: "Sales and marketing",
    description: "I led Kansas Electric’s rebrand, designed signs and billboards, and ran its digital ads on about $5,000 a month.",
    evidence: "Marketing at Kansas Electric",
    href: "/work/kansas-electric#taking-ownership-of-marketing"
  },
  {
    title: "Multi-site installations",
    description: "At Vale, I checked which restaurants were ready for installation and scheduled crews with our four field supervisors and subcontractors.",
    evidence: "How I led field operations at Vale",
    href: "/work/program-delivery-at-scale"
  },
  {
    title: "Job costing",
    description: "In ABS Console, a contractor can open the margin report for a job and see the invoices, labor entries, and material costs behind the total.",
    evidence: "How ABS Console calculates job profit",
    href: "/abs-tooling#connected-profit-and-costs"
  },
  {
    title: "Testing workflow changes",
    description: "I built a way to test a rule change against up to 50 past inputs in ABS Console. The owner can see what happened on each run and which actions the current and proposed rules would take.",
    evidence: "Explore automation in ABS Console",
    href: "/abs-tooling#automation"
  },
  {
    title: "Backup and recovery",
    description: "I restored an encrypted ABS Console backup in a separate test environment to check that I could recover the sample records.",
    evidence: "How I tested migration and recovery",
    href: "/abs-tooling#migration-and-recovery"
  }
];

const toolGroups = [
  {
    title: "Applications and interfaces",
    tools: ["JavaScript / TypeScript", "React / Next.js", "Node.js", "PWAs", "React Query / Zod"]
  },
  {
    title: "Data and integrations",
    tools: ["SQL / PostgreSQL", "Supabase / RLS", "REST APIs / OAuth", "Stripe / QuickBooks / Xero", "Gmail / Microsoft Graph", "Python"]
  },
  {
    title: "AI and automation",
    tools: ["OpenAI API", "Vercel AI Gateway", "Google Cloud / Vertex AI", "OCR / vision", "MCP tools", "Scheduled workflows"]
  },
  {
    title: "Testing and deployment",
    tools: ["Vitest / Playwright", "PostgreSQL policy tests", "GitHub CI/CD", "Vercel", "C# / .NET"]
  }
];
---

<Base title="Sales, Growth & Technical Skills | Eric Martin" description="Examples from Eric Martin’s work on Kansas Electric’s sales and marketing, Vale’s restaurant installations, and ABS Console’s job costing and recovery tools.">
  <section class="page-heading">
    <div class="page-container">
      <div class="max-w-4xl">
        <h1 class="page-title">Sales, operations,<br />and software.</h1>
      </div>

      <div class="mt-12 grid gap-x-12 gap-y-0 border-b border-border md:grid-cols-2 lg:mt-16 lg:gap-x-16">
        {capabilities.map((capability) => (
          <article class="capability flex flex-col border-t border-border py-8 sm:py-10">
            <h2 class="max-w-sm text-2xl font-semibold text-ink">{capability.title}</h2>
            <p class="mb-5 mt-5 leading-relaxed text-muted">{capability.description}</p>
            <a class="text-link mt-auto text-sm leading-relaxed" href={capability.href}>
              {capability.evidence} <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-16 sm:pb-24">
    <div class="page-container">
      <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
        <div>
          <h2 class="text-3xl font-semibold text-ink sm:text-4xl">Tools I use</h2>
        </div>
        <div class="grid gap-8 sm:grid-cols-2">
          {toolGroups.map((group) => (
            <div class="border-t border-border pt-5">
              <h3 class="text-lg font-semibold text-ink">{group.title}</h3>
              <ul class="mt-4 flex flex-wrap gap-2" aria-label={group.title}>
                {group.tools.map((tool) => (
                  <li class="rounded-md border border-border bg-white/70 px-2.5 py-1.5 text-xs font-medium text-ink">{tool}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</Base>
