---
import Base from "../layouts/Base.astro";

const capabilities = [
  {
    number: "01",
    title: "Revenue and growth systems",
    description: "Connect account research, lead capture, opportunity stages, forecasting, and follow-up so a team can see where work stands and who owns the next step.",
    examples: ["CRM and pipeline design", "Account research and qualification", "Commercial reporting and forecasting"],
    evidence: "Kansas Electric: CRM, forecasting, and lead capture",
    href: "/work/kansas-electric"
  },
  {
    number: "02",
    title: "Operations and delivery",
    description: "Turn the handoff from a sold job to completed work into a defined workflow, with scope, owners, schedules, field updates, and billing context kept together.",
    examples: ["Project handoffs and capacity planning", "Field reporting and estimating", "Job costs, invoices, and operational history"],
    evidence: "ABS Tooling: projects, finance, and operations",
    href: "/abs-tooling#projects-and-delivery"
  },
  {
    number: "03",
    title: "Practical AI workflows",
    description: "Give AI a specific role in research, extraction, or drafting. Keep its sources, uncertainty, and proposed actions visible to the person reviewing the work.",
    examples: ["Evidence-backed account research", "OCR and structured document extraction", "Readiness checks and approval paths"],
    evidence: "FreightFlow AI: research and prospecting in context",
    href: "/technical-projects/freight-flow-ai"
  },
  {
    number: "04",
    title: "Reliable software and live systems",
    description: "Work through the details behind a usable interface: permissions, validation, persistent state, failure handling, testing, and the tools needed to support a live service.",
    examples: ["API design and data modeling", "Access controls and audit history", "Release discipline and incident response"],
    evidence: "Eden: engineering for a live multiplayer service",
    href: "/eden"
  }
];

const toolGroups = [
  {
    title: "Applications and interfaces",
    context: "Internal tools, responsive workspaces, and offline field applications.",
    tools: ["JavaScript / TypeScript", "React / Next.js", "Node.js", "PWAs", "React Query / Zod"]
  },
  {
    title: "Data and integrations",
    context: "Business records, access boundaries, and connected workflows.",
    tools: ["SQL / PostgreSQL", "Supabase / RLS", "REST APIs", "Apps Script / Sheets", "Python"]
  },
  {
    title: "AI and automation",
    context: "Research, structured extraction, and reviewed business actions.",
    tools: ["Vercel AI Gateway", "Google Cloud / Vertex AI", "OCR / vision", "MCP tools", "Scheduled workflows"]
  },
  {
    title: "Quality and operations",
    context: "Verification, deployment, and ongoing service reliability.",
    tools: ["Vitest / Playwright", "PostgreSQL policy tests", "GitHub CI/CD", "Vercel", "C# / .NET"]
  }
];
---

<Base title="Skills & Tooling - Eric Martin" description="Explore Eric Martin’s skills in revenue operations, delivery workflows, AI-assisted tools, and production engineering, with examples from ABS Tooling, Kansas Electric, FreightFlow AI, and Eden.">
  <section class="py-14 sm:py-16">
    <div class="page-container">
      <div class="max-w-3xl">
        <p class="eyebrow">Skills & tooling</p>
        <h1 class="mt-3 text-4xl font-semibold leading-tight text-ink sm:text-5xl">From business process to working software.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
          I connect commercial goals, day-to-day operations, and hands-on engineering.
          These are the capabilities I bring to that work, with examples of where
          I have applied them.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {capabilities.map((capability) => (
          <article class="surface flex flex-col p-6 sm:p-8">
            <p class="text-sm font-semibold tabular-nums text-accent" aria-hidden="true">{capability.number}</p>
            <h2 class="mt-3 text-2xl font-semibold text-ink">{capability.title}</h2>
            <p class="mt-3 leading-relaxed text-muted">{capability.description}</p>
            <ul class="mb-6 mt-5 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted">
              {capability.examples.map((example) => <li>{example}</li>)}
            </ul>
            <a class="focus-ring mt-auto border-t border-border pt-5 text-sm font-semibold leading-relaxed text-accent hover:text-accent-dark" href={capability.href}>
              {capability.evidence} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-16">
    <div class="page-container">
      <div class="surface-muted p-6 sm:p-8">
        <div class="max-w-2xl">
          <p class="eyebrow">Technical toolkit</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink">Tools chosen for the workflow.</h2>
          <p class="mt-3 leading-relaxed text-muted">The stack varies with the work: a field app needs offline capture, a shared workspace needs enforced permissions, and a live service needs dependable state and recovery.</p>
        </div>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {toolGroups.map((group) => (
            <div class="border-t border-border pt-5">
              <h3 class="text-lg font-semibold text-ink">{group.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{group.context}</p>
              <ul class="mt-4 flex flex-wrap gap-2" aria-label={group.title}>
                {group.tools.map((tool) => (
                  <li class="rounded-lg border border-border bg-white px-3 py-1.5 text-sm text-ink">{tool}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <div class="section-dark mt-10 rounded-2xl p-6 text-white sm:p-8">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-center">
          <div class="max-w-2xl">
            <h2 class="text-2xl font-semibold">See how the pieces fit together.</h2>
            <p class="mt-3 leading-relaxed text-slate-300">The ABS Tooling case study follows the full workflow from prospect research to delivery and billing, including the engineering decisions behind it.</p>
          </div>
          <a class="focus-ring inline-flex shrink-0 items-center justify-center rounded-lg bg-white px-5 py-3 text-sm font-semibold text-ink hover:bg-slate-100" href="/abs-tooling">Explore ABS Tooling <span class="ml-2" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>
