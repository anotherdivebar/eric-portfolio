---
import Base from "../layouts/Base.astro";

const competencies = [
  "Strategic Operations",
  "Revenue Operations",
  "Forecasting",
  "Pipeline Visibility",
  "Process Design",
  "Cross-Functional Leadership",
  "GTM Support",
  "Workflow Standardization",
  "Opportunity Modeling",
  "Implementation Planning",
  "Vendor Coordination",
  "Executive Reporting",
];

const techLine =
  "CRM Workflow Design · Dashboarding · Forecasting Systems · SQL · C# · JavaScript · Node.js · React · PostgreSQL · Data Flow Design · Internal Tooling · Reporting Workflows · Process Automation";
---

<Base title="Skills - Eric">
  <section class="py-16">
    <div class="page-container">
      <div class="max-w-2xl">
        <p class="eyebrow mb-2">Strategic Operations / RevOps / BizOps</p>
        <h1 class="text-4xl font-semibold text-ink">Skills &amp; tooling</h1>
        <p class="mt-3 text-muted">
          What I actually run — from pipeline and forecasting to the systems that
          make reporting and handoffs stick.
        </p>
      </div>

      <div class="mt-10 surface p-6 sm:p-8">
        <h2 class="text-lg font-semibold text-ink">Core competencies</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">{competencies.join(" · ")}</p>
        <h2 class="mt-8 text-lg font-semibold text-ink">Technical &amp; systems skills</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">{techLine}</p>
      </div>

      <div class="mt-10 grid gap-6">
        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Strategic operations &amp; RevOps</h2>
          <p class="mt-2 text-muted">
            I connect pipeline, planning, and execution so leadership sees the same
            reality the field is living. That means forecasting discipline, clean
            opportunity modeling, and reporting people actually trust.
          </p>
        </article>

        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">BizOps &amp; workflow design</h2>
          <p class="mt-2 text-muted">
            Standardize how work moves: intake, quoting, delivery readiness, vendor
            coordination, and handoffs between commercial and ops — fewer ad hoc
            threads, clearer ownership.
          </p>
        </article>

        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Leadership &amp; GTM support</h2>
          <p class="mt-2 text-muted">
            Cross-functional alignment without theater: executive-ready reporting,
            implementation planning, and staying close enough to unblock teams.
          </p>
        </article>

        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Engineering &amp; internal systems</h2>
          <p class="mt-2 text-muted">
            Hands-on build when the answer is tooling: CRM workflows, dashboards,
            internal apps, SQL and data flow — C#, JavaScript, Node, React, Postgres
            in real delivery contexts.
          </p>
        </article>
      </div>
    </div>
  </section>
</Base>
