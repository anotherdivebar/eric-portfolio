---
import Base from "../layouts/Base.astro";

const competencies = [
  "Strategic Operations",
  "Revenue Operations",
  "AI Workflow Integration",
  "Business Process Architecture",
  "Cross-Functional Leadership",
  "GTM Execution",
  "Forecasting & Pipeline Visibility",
  "Process Optimization",
  "Root Cause Analysis",
  "Systems-Led Growth",
  "Pre-Deployment Planning",
  "Systems Thinking",
  "Operational Workflow Modeling",
];

const techLine =
  "CRM & Workflow Systems · Dashboarding & Reporting Logic · Internal Tooling · Process Automation · Log Analysis / Debugging · Event-Driven Logic · C#, JavaScript, TypeScript, Python, SQL · Node.js, React, Playwright, Recharts · API Route Handlers";
---

<Base title="Skills - Eric">
  <section class="py-16">
    <div class="page-container">
      <div class="max-w-2xl">
        <p class="eyebrow mb-2">Revenue &amp; strategic operations · AI enablement</p>
        <h1 class="text-4xl font-semibold text-ink">Skills &amp; tooling</h1>
        <p class="mt-3 text-muted">
          Same buckets as the resume — what I actually run in the field and in the
          build.
        </p>
      </div>

      <div class="mt-10 surface p-6 sm:p-8">
        <h2 class="text-lg font-semibold text-ink">Key skills</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">{competencies.join(" · ")}</p>
        <h2 class="mt-8 text-lg font-semibold text-ink">Technical skills</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">{techLine}</p>
      </div>

      <div class="mt-10 grid gap-6">
        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Strategic operations &amp; RevOps</h2>
          <p class="mt-2 text-muted">
            Pipeline, forecasting, and visibility — so leadership and the field are
            looking at the same reality.
          </p>
        </article>

        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">AI workflow integration</h2>
          <p class="mt-2 text-muted">
            Finding where AI and automation actually earn their keep: less manual
            work, better insight, without a disruptive re-platform every quarter.
          </p>
        </article>

        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">BizOps &amp; process architecture</h2>
          <p class="mt-2 text-muted">
            Handoffs, quoting, delivery readiness, vendor coordination — modeled so
            teams can execute consistently.
          </p>
        </article>

        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Engineering &amp; internal systems</h2>
          <p class="mt-2 text-muted">
            CRM workflows, dashboards, tooling, and the stack from the resume: C#,
            JS/TS, Python, SQL, Node, React, and shipping what people use daily.
          </p>
        </article>
      </div>
    </div>
  </section>
</Base>
