---
import Base from "../layouts/Base.astro";

const competencies = [
  "Revenue Operations",
  "Technical Systems",
  "Business Development",
  "GTM Systems",
  "Pipeline & Forecasting",
  "Field Operations",
  "Process Architecture",
  "Implementation & Rollout",
  "Cross-Functional Leadership",
  "Product Operations",
  "Operating Visibility",
  "Approval-Gated Automation",
  "AI-Enabled Workflows",
  "Executive Reporting",
  "Vendor Management",
  "Execution Infrastructure"
];

const technicalSkills = [
  "JavaScript and TypeScript",
  "React and Next.js",
  "Node.js",
  "Python",
  "C# and .NET",
  "SQL and PostgreSQL",
  "Supabase and row-level security",
  "CRM and workflow systems",
  "Dashboarding and reporting logic",
  "Internal apps and tooling",
  "Process automation",
  "React Query and Zod",
  "Vitest and Playwright",
  "Vercel and AI Gateway",
  "Google Cloud and Vertex AI",
  "OCR and vision workflows",
  "API design and integration architecture"
];
---

<Base title="Skills - Eric Martin">
  <section class="py-16">
    <div class="page-container">
      <div class="max-w-2xl">
        <p class="eyebrow mb-2">Revenue operations / technical systems / execution infrastructure</p>
        <h1 class="text-4xl font-semibold text-ink">Skills and tooling</h1>
        <p class="mt-3 text-muted">
          I bridge business development, operations, and software architecture.
          The mix below reflects how I build practical systems for growth,
          delivery, operating visibility, and production execution.
        </p>
      </div>

      <div class="mt-10 surface p-6 sm:p-8">
        <h2 class="text-lg font-semibold text-ink">Core strengths</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {competencies.map((skill) => (
            <span class="inline-flex rounded-lg border border-border bg-panel px-3 py-1.5 text-sm text-ink">
              {skill}
            </span>
          ))}
        </div>

        <h2 class="mt-8 text-lg font-semibold text-ink">Technical stack</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {technicalSkills.map((skill) => (
            <span class="inline-flex rounded-lg border border-border bg-panel px-3 py-1.5 text-sm text-ink">
              {skill}
            </span>
          ))}
        </div>
      </div>

      <div class="mt-10 grid gap-6">
        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Revenue and growth systems</h2>
          <p class="mt-2 text-muted">
            Pipeline design, forecasting, lead capture, account research, bid and
            RFP visibility, and commercial reporting so growth work is visible and
            accountable.
          </p>
        </article>

        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Operations and field execution</h2>
          <p class="mt-2 text-muted">
            Scheduling, dispatch, subcontractor coordination, field reporting,
            customer onboarding, QA, and delivery infrastructure for distributed
            teams and multi-site work.
          </p>
        </article>

        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Internal apps and execution infrastructure</h2>
          <p class="mt-2 text-muted">
            CRM consoles, estimating tools, dashboards, workflow helpers, and
            reporting surfaces built around the people expected to use them every
            day.
          </p>
        </article>

        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Approval-gated automation</h2>
          <p class="mt-2 text-muted">
            Agent catalogs, readiness gates, evidence review, role-aware controls,
            activity trails, and human approval paths so AI-assisted work can ship
            into production without bypassing judgment.
          </p>
        </article>

        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Operating visibility</h2>
          <p class="mt-2 text-muted">
            Dashboards, executive reporting, queue design, and review layers that
            help leaders and operators steer from the same picture.
          </p>
        </article>

        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Production software discipline</h2>
          <p class="mt-2 text-muted">
            Typed APIs, validation, testing, CI/CD, integration architecture, and
            rollout patterns that keep systems reliable once they leave the prototype
            stage.
          </p>
        </article>
      </div>
    </div>
  </section>
</Base>
