---
import Base from "../layouts/Base.astro";

const capabilities = [
  {
    title: "Relationship-based, consultative sales",
    description: "Build trust, understand the problem a prospect is facing, and connect it to a solution with clear business value. Carry that understanding into the next conversation and through delivery.",
    examples: ["Relationship and account development", "Discovery around needs, constraints, and desired outcomes", "Solution fit, value communication, and consistent follow-up"],
    evidence: "Kansas Electric: relationships, new business, and the Walmart engagement",
    href: "/work/kansas-electric"
  },
  {
    title: "Business development & growth strategy",
    description: "Build a commercial function around the right opportunities: clear positioning, account development, marketing, and a repeatable process for moving prospects toward a decision.",
    examples: ["Sales strategy and process development", "Brand positioning and campaign ownership", "Pipeline reviews, forecasting, and leadership reporting"],
    evidence: "Kansas Electric: approximately $2M closed in my first 60 days",
    href: "/work/kansas-electric#building-a-dedicated-sales-function"
  },
  {
    title: "Operations and delivery",
    description: "Connect what the customer was promised to the people, capacity, and processes needed to deliver it. Keep communication and issue resolution part of the relationship.",
    examples: ["Customer onboarding and delivery planning", "Distributed teams, vendor networks, and quality standards", "Issue resolution, closeout, and customer follow-through"],
    evidence: "Vale Field Services: helped grow to 35 employees and ~$4M in annual revenue",
    href: "/work/program-delivery-at-scale"
  },
  {
    title: "Revenue and customer systems",
    description: "Give the team a shared view of customer needs, account history, next steps, and delivery commitments so follow-through can scale with the business.",
    examples: ["Account research, CRM, and opportunity tracking", "Sales-to-delivery handoffs and customer self-service", "Connected billing and customer profit reporting"],
    evidence: "ABS Tooling: customer context from opportunity to payment",
    href: "/abs-tooling"
  },
  {
    title: "Practical AI workflows",
    description: "Give AI a specific role in research, extraction, or drafting. Keep its sources, uncertainty, and proposed actions visible to the person reviewing the work.",
    examples: ["Evidence-backed research and structured outreach drafts", "Private workspace answers with verified sources", "Permission checks, review gates, and AI usage budgets"],
    evidence: "ABS Tooling: evidence-backed research and governed AI",
    href: "/abs-tooling#workspace-ai-helper"
  },
  {
    title: "Reliable software and live systems",
    description: "Work through the details behind a usable interface: permissions, validation, persistent state, failure handling, testing, and the tools needed to support a live service.",
    examples: ["Provider reconciliation and uncertain-result recovery", "Reviewed data migration and permission boundaries", "Encrypted restore drills and database concurrency checks"],
    evidence: "ABS Tooling: migration, recovery, and verification",
    href: "/abs-tooling#migration-and-recovery"
  }
];

const toolGroups = [
  {
    title: "Applications and interfaces",
    context: "Internal tools, responsive workspaces, and offline field applications.",
    tools: ["JavaScript / TypeScript", "React / Next.js", "Node.js", "PWAs", "React Query / Zod"]
  },
  {
    title: "Data and integrations",
    context: "Business records, access boundaries, and connected workflows.",
    tools: ["SQL / PostgreSQL", "Supabase / RLS", "REST APIs / OAuth", "Stripe / QuickBooks / Xero", "Gmail / Microsoft Graph", "Python"]
  },
  {
    title: "AI and automation",
    context: "Research, structured extraction, and reviewed business actions.",
    tools: ["OpenAI API", "Vercel AI Gateway", "Google Cloud / Vertex AI", "OCR / vision", "MCP tools", "Scheduled workflows"]
  },
  {
    title: "Quality and operations",
    context: "Verification, deployment, concurrency checks, and isolated recovery drills.",
    tools: ["Vitest / Playwright", "PostgreSQL policy tests", "GitHub CI/CD", "Vercel", "C# / .NET"]
  }
];
---

<Base title="Sales, Growth & Technical Skills - Eric Martin" description="Eric Martin's capabilities in consultative sales, relationship development, growth strategy, operational delivery, and the software that supports them.">
  <section class="page-heading">
    <div class="page-container">
      <div class="max-w-4xl">
        <p class="eyebrow">Sales, growth & technical skills</p>
        <h1 class="page-title mt-5">Understand the customer. Win the work. Support the growth.</h1>
        <p class="page-intro mt-7">
          I bring relationship-based sales and business development together with
          the operational experience to deliver and the technical skills to build
          what the team needs. Each capability connects to examples from my work.
        </p>
      </div>

      <div class="mt-12 grid gap-x-12 gap-y-0 border-b border-border md:grid-cols-2 lg:mt-16 lg:gap-x-16">
        {capabilities.map((capability) => (
          <article class="capability flex flex-col border-t border-border py-8 sm:py-10">
            <h2 class="max-w-sm text-2xl font-semibold text-ink">{capability.title}</h2>
            <p class="mt-5 leading-relaxed text-muted">{capability.description}</p>
            <ul class="capability-examples mb-7 mt-5 space-y-2 text-sm leading-relaxed text-muted">
              {capability.examples.map((example) => <li>{example}</li>)}
            </ul>
            <a class="text-link mt-auto text-sm leading-relaxed" href={capability.href}>
              {capability.evidence.replace("ABS Tooling", "ABS Console")} <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-16 sm:pb-24">
    <div class="page-container">
      <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
        <div>
          <p class="eyebrow">Technical toolkit</p>
          <h2 class="mt-4 text-3xl font-semibold text-ink sm:text-4xl">Tools chosen for the workflow.</h2>
          <p class="mt-5 leading-relaxed text-muted">The stack varies with the work: a field app needs offline capture, a shared workspace needs enforced permissions, and a live service needs dependable state and recovery.</p>
        </div>
        <div class="grid gap-8 sm:grid-cols-2">
          {toolGroups.map((group) => (
            <div class="border-t border-border pt-5">
              <h3 class="text-lg font-semibold text-ink">{group.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{group.context}</p>
              <ul class="mt-4 flex flex-wrap gap-2" aria-label={group.title}>
                {group.tools.map((tool) => (
                  <li class="rounded-md border border-border bg-white/70 px-2.5 py-1.5 text-xs font-medium text-ink">{tool}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <div class="surface-muted mt-16 p-7 sm:p-10">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-center">
          <div class="max-w-xl">
            <p class="eyebrow">A working example</p>
            <h2 class="mt-3 text-2xl font-semibold">See how the pieces fit together.</h2>
            <p class="mt-3 leading-relaxed text-muted">The ABS Console case study follows the full workflow from prospect research to delivery and billing, including the engineering decisions behind it.</p>
          </div>
          <a class="button-primary shrink-0" href="/abs-tooling">Explore ABS Console <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .capability-examples li { display: flex; gap: 10px; }
  .capability-examples li::before { content: ""; flex-shrink: 0; width: 4px; height: 4px; margin-top: 9px; border-radius: 50%; background: #176958; }
</style>
