---
import Base from "../layouts/Base.astro";

const competencies = [
  "Revenue Operations",
  "Strategic Operations",
  "Customer Acquisition",
  "Revenue Recovery",
  "Forecasting and Pipeline Visibility",
  "Business Process Architecture",
  "Cross-Functional Leadership",
  "GTM Execution",
  "Workflow Standardization",
  "Opportunity Modeling",
  "Implementation Planning",
  "Executive Reporting",
  "Owner Visibility",
  "Human-in-the-Loop AI Workflows"
];

const technicalSkills = [
  "CRM and Workflow Systems",
  "Dashboarding and Reporting Logic",
  "Internal Tooling",
  "Process Automation",
  "Public-source research workflows",
  "Queue and approval design",
  "SQL",
  "C#",
  "JavaScript and TypeScript",
  "Python",
  "Node.js",
  "React",
  "PostgreSQL",
  "API Route Handlers"
];
---

<Base title="Skills - Eric">
  <section class="py-16">
    <div class="page-container">
      <div class="max-w-2xl">
        <p class="eyebrow mb-2">RevOps / strategic operations / revenue systems</p>
        <h1 class="text-4xl font-semibold text-ink">Skills and tooling</h1>
        <p class="mt-3 text-muted">
          The mix of revenue systems, customer acquisition workflows, operator-facing
          tooling, and technical execution that shows up across the resume and project work.
        </p>
      </div>

      <div class="mt-10 surface p-6 sm:p-8">
        <h2 class="text-lg font-semibold text-ink">Core strengths</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {competencies.map((skill) => (
            <span class="inline-flex rounded-lg border border-border bg-panel px-3 py-1.5 text-sm text-ink">
              {skill}
            </span>
          ))}
        </div>

        <h2 class="mt-8 text-lg font-semibold text-ink">Technical stack</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {technicalSkills.map((skill) => (
            <span class="inline-flex rounded-lg border border-border bg-panel px-3 py-1.5 text-sm text-ink">
              {skill}
            </span>
          ))}
        </div>
      </div>

      <div class="mt-10 grid gap-6">
        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Revenue systems and visibility</h2>
          <p class="mt-2 text-muted">
            Forecasting, CRM workflow design, pipeline modeling, and reporting logic so leadership and operators are looking at the same numbers.
          </p>
        </article>

        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Customer acquisition systems</h2>
          <p class="mt-2 text-muted">
            Prospecting workflows, public-source research, account qualification, and
            shared pipeline movement for teams that need more than a generic CRM.
          </p>
        </article>

        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Workflow and process architecture</h2>
          <p class="mt-2 text-muted">
            Design how work moves between commercial, ops, vendors, and field execution. Clear ownership, fewer handoff gaps, better throughput.
          </p>
        </article>

        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Internal tooling</h2>
          <p class="mt-2 text-muted">
            When the right answer is software, I build it: dashboards, quoting support, internal apps, workflow helpers, and reporting surfaces people actually use.
          </p>
        </article>

        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">AI-assisted workflows</h2>
          <p class="mt-2 text-muted">
            I use AI where it improves research, drafting, enrichment, queue work, or
            process speed without turning the whole operating model upside down.
          </p>
        </article>

        <article class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Owner visibility and review layers</h2>
          <p class="mt-2 text-muted">
            Dashboards, summaries, and approval-style workflow design so managers can
            steer the system without living inside every task.
          </p>
        </article>
      </div>
    </div>
  </section>
</Base>
