---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<Base title="Insights - Eric Martin" description="Notes from Eric Martin on ownership, operating cadence, reliable data, and building systems that support growth and delivery.">
  <section class="page-heading">
    <div class="page-container">
      <div class="max-w-2xl">
        <p class="eyebrow">Notes from the work</p>
        <h1 class="page-title mt-5">Insights</h1>
        <p class="page-intro mt-7">
          How I think about ownership, useful reporting, and the systems that
          keep growth and delivery connected.
        </p>
      </div>
      <div class="mt-12 border-b border-border sm:mt-16">
        {posts.map((post) => (
          <article class="grid gap-5 border-t border-border py-8 sm:grid-cols-[180px_minmax(0,1fr)] sm:gap-10 sm:py-10">
            <time class="block text-xs font-medium text-muted sm:pt-2" datetime={post.data.publishDate.toISOString()}>
              {post.data.publishDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
                timeZone: "UTC"
              })}
            </time>
            <div>
              <h2 class="max-w-3xl text-2xl font-semibold sm:text-3xl"><a class="focus-ring hover:text-accent" href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
              <p class="mt-4 max-w-2xl leading-relaxed text-muted">{post.data.description}</p>
              <a class="text-link mt-6" href={`/blog/${post.slug}`} aria-label={`Read the essay: ${post.data.title}`}>
                Read the essay <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
