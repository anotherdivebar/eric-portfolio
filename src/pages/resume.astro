---
import Base from "../layouts/Base.astro";

const resumeUrl = "/Eric%20Martin%20-%20RevOps%20Resume.pdf";

const headline = "Revenue Operations and Strategic Systems Leader";

const summary =
  "Revenue operations and systems builder focused on the infrastructure that keeps customer acquisition, follow-up, field work, CRM, and owner reporting visible. I build managed workflow systems: queues, dashboards, approvals, and internal tools that help operators act before work slips into memory.";

const keySkills = [
  "Revenue Operations",
  "Strategic Operations",
  "Customer Acquisition",
  "Revenue Recovery",
  "Managed Workflow Systems",
  "Forecasting and Pipeline Visibility",
  "Business Process Architecture",
  "Cross-Functional Leadership",
  "GTM Execution",
  "Workflow Standardization",
  "Opportunity Modeling",
  "Executive Reporting",
  "Implementation Planning",
  "Vendor Coordination",
  "Systems Thinking",
  "Owner Visibility",
  "Human-in-the-Loop AI Workflows",
  "Operator-facing AI / agent orchestration"
];

const technicalSkills = [
  "CRM and Workflow Systems",
  "Dashboarding and Reporting Logic",
  "Internal Tooling",
  "Process Automation",
  "Public-source research workflows",
  "Queue and approval design",
  "AI-assisted enrichment",
  "Supabase / Postgres / RLS",
  "Integration architecture",
  "SQL",
  "C#",
  "JavaScript and TypeScript",
  "Python",
  "Node.js",
  "React",
  "PostgreSQL",
  "API Route Handlers"
];

const projectKansasBullets = [
  "Designed internal workflow systems for quoting, reporting, forecasting, and execution visibility.",
  "Improved business signal flow from intake through delivery by tightening operational handoffs.",
  "Connected commercial activity to field execution and leadership reporting with clearer ownership.",
  "Built public web, internal tooling, and automation around how the business actually operated."
];

const projectFreightBullets = [
  "Built a freight-focused shipper prospecting and SRM platform for a small brokerage sales team.",
  "Combined a live Shipper Finder, AI-assisted account briefs, public contact research, and a shared shipper relationship pipeline in one workflow.",
  "Tailored the app to real freight sales behavior: strong freight signals, area-based prospecting, public contact paths, and shared pipeline stages.",
  "Stack: Next.js, React, TypeScript, Supabase, server-side API routes, and AI-assisted enrichment and workflow tooling."
];

const projectAtlasBullets = [
  "Built an internal operator control plane for client workspaces, agent catalog, approvals, integrations, and prospecting.",
  "Unified the operator loop: intake, profile, readiness, run, approval, and action.",
  "Used evidence gates before live LLM runs and human approval for customer-facing or sensitive actions.",
  "Stack: Next.js 16, React 19, TypeScript, Supabase, Vercel, AI Gateway, optional GCP services, Places/Hunter, and Vitest."
];
---

<Base title="Resume - Eric">
  <section class="py-16">
    <div class="page-container">
      <div class="max-w-2xl">
        <p class="eyebrow mb-2">Resume</p>
        <h1 class="text-4xl font-semibold text-ink">Resume and narrative</h1>
        <p class="mt-3 text-muted">
          Download uses the latest PDF in <code class="rounded bg-panel px-1.5 py-0.5 text-sm text-ink">public/</code> and the sections below expand the same story for quick scanning.
        </p>
      </div>

      <div class="mt-8 grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="surface p-6">
          <h2 class="text-xl font-semibold text-ink">Resume PDF</h2>
          <p class="mt-2 text-muted">If the embed does not load, use download.</p>
          <a
            class="focus-ring mt-4 inline-flex items-center justify-center rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white transition hover:bg-accent-dark"
            href={resumeUrl}
          >
            Download Resume
          </a>
          <div class="mt-4 aspect-[4/5] w-full rounded-xl border border-border bg-panel">
            <object data={resumeUrl} type="application/pdf" class="h-full w-full">
              <p class="p-4 text-sm text-muted">
                PDF not loading. <a class="focus-ring text-accent" href={resumeUrl}>Download</a>
              </p>
            </object>
          </div>
        </div>

        <div class="surface p-6 sm:p-8">
          <p class="text-sm font-semibold text-ink leading-snug">{headline}</p>
          <h2 class="mt-4 text-xl font-semibold text-ink">Professional summary</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">{summary}</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            The same themes run through the portfolio: find revenue, recover revenue,
            control operations, and govern AI-assisted work with review points where
            judgment still matters.
          </p>

          <div class="mt-8">
            <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-muted">Key skills</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {keySkills.map((skill) => (
                <span class="inline-flex rounded-lg border border-border bg-panel px-3 py-1.5 text-sm text-ink">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <div class="mt-8">
            <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-muted">Technical skills</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {technicalSkills.map((skill) => (
                <span class="inline-flex rounded-lg border border-border bg-panel px-3 py-1.5 text-sm text-ink">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="surface-muted mt-10 p-6 sm:p-8">
        <h2 class="text-xl font-semibold text-ink">Professional experience</h2>
        <p class="mt-2 max-w-3xl text-sm text-muted">
          Same roles as the resume, expanded here around acquisition, workflow design,
          and visibility.
        </p>

        <div class="mt-8">
          <p class="font-semibold text-ink">Director of Business Development and Technical Systems</p>
          <p class="mt-1 text-sm text-muted">Kansas Electric, Inc. - Newton, KS - Oct 2024 to Dec 2025</p>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-muted">
            <li>Supported business development efforts tied to more than $100M in presented opportunities in 2025 and a forward-looking pipeline exceeding $200M over the following 24 months.</li>
            <li>Built internal systems across CRM, estimating, field reporting, dashboards, and forecasting to improve visibility across commercial activity, delivery readiness, and operational decision-making.</li>
            <li>Standardized workflows connecting customer needs, quoting, execution feasibility, and reporting, reducing fragmentation and improving handoffs across teams.</li>
            <li>Partnered across leadership, field teams, and customer stakeholders to align growth efforts with execution reality and build systems that could support scale.</li>
            <li>Built reporting and operating structure that gave leaders clearer visibility into pipeline, readiness, and where commercial motion was likely to stall.</li>
          </ul>
        </div>

        <div class="mt-10 border-t border-border pt-10">
          <p class="font-semibold text-ink">Head of Strategic Operations</p>
          <p class="mt-1 text-sm text-muted">Vale Field Services - Remote - Jul 2019 to Oct 2024</p>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-muted">
            <li>Helped scale the company from startup stage to approximately $4M annually by designing and implementing the processes, standards, and execution infrastructure required for growth.</li>
            <li>Built operational frameworks spanning planning, training, QA, customer coordination, vendor management, and field execution across distributed teams and customer environments.</li>
            <li>Acted as a strategic partner during pre-deployment planning, helping customers identify best-fit approaches, execution risks, and feasibility constraints before launch.</li>
            <li>Created repeatable operating rhythms and support structures that improved clarity, responsiveness, and delivery consistency across complex work.</li>
            <li>Applied systems thinking and targeted automation to reduce operational friction, improve consistency, and strengthen execution without forcing disruptive process change.</li>
            <li>Kept leadership visibility close to the work through clearer operating cadences, status signals, and follow-through expectations.</li>
          </ul>
        </div>
      </div>

      <div class="mt-10">
        <h2 class="text-xl font-semibold text-ink">Selected systems</h2>
        <div class="mt-6 grid gap-6 xl:grid-cols-3 xl:items-stretch">
          <article class="surface flex h-full flex-col p-6 sm:p-8">
            <h3 class="text-lg font-semibold text-ink">Atlas-Beren Console</h3>
            <p class="mt-1 text-sm text-muted">Internal operator control plane</p>
            <ul class="mt-4 flex-1 list-disc space-y-2 pl-5 text-sm text-muted">
              {projectAtlasBullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
            <a
              class="focus-ring mt-6 inline-flex text-sm font-semibold text-accent hover:text-accent-dark"
              href="/technical-projects#atlas-beren-console"
            >
              System overview ->
            </a>
          </article>

          <article class="surface flex h-full flex-col p-6 sm:p-8">
            <h3 class="text-lg font-semibold text-ink">Kansas Electric</h3>
            <p class="mt-1 text-sm text-muted">Revenue and operations infrastructure</p>
            <ul class="mt-4 flex-1 list-disc space-y-2 pl-5 text-sm text-muted">
              {projectKansasBullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
            <a
              class="focus-ring mt-6 inline-flex text-sm font-semibold text-accent hover:text-accent-dark"
              href="/work/kansas-electric"
            >
              Full case study ->
            </a>
          </article>

          <article class="surface flex h-full flex-col p-6 sm:p-8">
            <h3 class="text-lg font-semibold text-ink">FreightFlow AI</h3>
            <p class="mt-1 text-sm text-muted">Freight prospecting and SRM workspace</p>
            <ul class="mt-4 flex-1 list-disc space-y-2 pl-5 text-sm text-muted">
              {projectFreightBullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
            <p class="mt-4 text-sm text-muted">
              Built around customer acquisition behavior, shared pipeline movement,
              and useful operator-facing AI outputs instead of generic CRM patterns.
            </p>
            <a
              class="focus-ring mt-6 inline-flex text-sm font-semibold text-accent hover:text-accent-dark"
              href="/technical-projects#freight-flow-ai"
            >
              Product breakdown ->
            </a>
          </article>
        </div>
      </div>
    </div>
  </section>
</Base>
