---
import Base from "../layouts/Base.astro";

const resumeUrl = "/Eric%20Martin%20Resume%20-%20October.pdf";

const experience = [
  {
    role: "Founder & Principal Systems Architect",
    company: "Atlas-Beren Systems",
    location: "Newton, KS / Remote",
    dates: "Jan 2026 – Present",
    bullets: [
      "Founded an AI systems consultancy for trade and field-service businesses and built its modular platform for prospecting, CRM, marketing, project delivery, finance, connected operations, and governed automation.",
      "Architected the platform in Next.js, React, TypeScript, and Supabase Postgres with organization-scoped roles, row-level security, normalized data, and source-agnostic ingestion.",
      "Built Overture Maps discovery, source-backed company research, CRM, and OpenAI-assisted outreach campaigns with structured draft validation, review gates, authorized delivery, and reply triage.",
      "Connected CRM, estimates, projects, Marketing, and Financial through durable customer/project relationships, automatic handoffs, contextual autofill, and focused exception reviews.",
      "Built shared project, customer, and campaign profit reporting from issued invoices, inventory usage, approved labor, and reviewed expenses, with explicit duplicate and coverage controls.",
      "Extended contract billing with approved changes, deposits, discounts, reviewed tax, credits/refunds, and recurring service, plus QuickBooks/Xero and customer-authorized Stripe workflows awaiting live provider acceptance.",
      "Extended operations with versioned offline field forms, crew routing and arrival commitments, consolidated material demand, supplier pricebooks, inventory, production, and reviewed payroll-period exports.",
      "Built a 13-week business simulator that compares proposed jobs against cash, qualified labor, and materials, with scenario alternatives, frozen predictions, and evidence-linked actuals.",
      "Built an invitation-based customer portal for quote approval, requests, appointments, invoices, and history; added Gmail/Outlook mail and calendar adapters and an authorized field commercial workflow.",
      "Implemented reviewed business migration, encrypted backup tooling, and isolated PostgreSQL restore/concurrency drills; the October 25 release records 2,330 passing regression tests, with live provider acceptance and production disaster recovery still pending.",
      "Designed a permission-aware AI Helper with private history, verified source links, and budget controls, alongside auditable automation recipes, scoped MCP tools, and custom member permissions."
    ],
    href: "/abs-tooling",
    linkLabel: "Explore the ABS Tooling case study"
  },
  {
    role: "Director, Business Development & Technical Systems",
    company: "Kansas Electric, Inc.",
    location: "Newton, KS",
    dates: "Oct 2024 – Dec 2025",
    bullets: [
      "Built the company's dedicated sales function, developing the strategy, process, and program to take sales responsibilities off project managers.",
      "Assumed Director of Marketing responsibilities, led the rebrand, created digital and offline materials including signage and billboards, and owned campaigns with approximately $5,000 in monthly ad spend. Also supported hiring and recruiting.",
      "Closed approximately $2M in new work within the first 60 days. Built a commercial motion tied to $100M+ in 2025 presented opportunities and a forward pipeline exceeding $200M over the following 24 months.",
      "Won a Walmart emergency lighting and relay project across the Midwest and Southeast through relationships developed at Vale Field Services; owned the relationship and oversaw the project managers delivering the work.",
      "Designed and shipped connected systems across CRM, estimating, field reporting, scheduling, forecasting, customer intelligence, labor planning, and leadership visibility.",
      "Rebuilt the company website, service positioning, lead capture, and account-research workflows, and standardized pipeline reviews, forecasting, activity capture, and executive reporting.",
      "Built an estimating app that reduced estimating time by approximately 50–60% and improved estimating accuracy by approximately 25%, alongside offline-capable field tools with structured capture and AI-assisted reporting."
    ],
    href: "/work/kansas-electric",
    linkLabel: "Explore sales, marketing, and systems at Kansas Electric"
  },
  {
    role: "Head of Strategic Operations",
    company: "Vale Field Services",
    location: "Remote",
    dates: "Jul 2019 – Oct 2024",
    bullets: [
      "Joined as employee one, performing field work and developing customer relationships, then grew into leading business operations outside finance as the company reached 35 employees and approximately $4M in annual revenue.",
      "Managed four field supervisors within a team that included 29 field technicians and admin/support staff; built processes, vendor networks, training, quality assurance, and delivery infrastructure.",
      "Led POS and technology rollouts across the U.S. and Canada, typically covering hundreds of stores. Restaurant work included Taco Bell, Dairy Queen, Scooter's, McDonald's, and KFC locations.",
      "Owned operating frameworks across onboarding, project planning, dispatch, subcontractor management, field execution, issue resolution, invoicing readiness, and post-work quality follow-through.",
      "Identified feasibility constraints, site-readiness gaps, and installation risks before rollout; created SOPs, escalation paths, training materials, and operating cadences for distributed work."
    ],
    href: "/work/program-delivery-at-scale",
    linkLabel: "Explore the growth of Vale's operations"
  }
];

const skillGroups = [
  { title: "Commercial & operations", skills: "Revenue operations, business development, GTM systems, pipeline and forecasting, customer success, field operations, vendor management, and executive reporting." },
  { title: "Delivery & systems", skills: "Process architecture, cross-functional leadership, implementation and rollout, product operations, approval workflows, and AI-enabled automation." },
  { title: "Engineering", skills: "JavaScript, TypeScript, React, Next.js, Node.js, Python, C# / .NET, SQL, PostgreSQL, Supabase, REST APIs, React Query, and Zod." },
  { title: "Quality & infrastructure", skills: "Vitest, Playwright, GitHub CI/CD, Vercel, Vercel AI Gateway, Google Cloud, Vertex AI, row-level security, OCR, and vision workflows." }
];

const systems = [
  { title: "ABS Tooling / Atlas-Beren Console", description: "Connected CRM-to-payment workflows, customer self-service, shared profit reporting, business simulation, reviewed migration, and recovery tooling.", href: "/abs-tooling", label: "Read the full build" },
  { title: "Atlas-Beren Systems Website", description: "Product positioning, interactive workflow demonstrations, inclusive pricing, and validated inquiries for software and services.", href: "/technical-projects/atlas-beren-website", label: "Explore the website build" },
  { title: "Kansas Electric", description: "A sales and marketing function built from the ground up, supported by CRM, estimating, field reporting, and planning tools.", href: "/work/kansas-electric", label: "Read the case study" },
];
---

<Base title="Resume - Eric Martin" description="Eric Martin’s experience in revenue operations, technical systems, business development, and national field delivery. Read the career overview or download the October 2026 resume.">
  <section class="py-12 sm:py-16">
    <div class="page-container">
      <div class="max-w-3xl">
        <p class="eyebrow mb-3">Resume / Eric Martin</p>
        <h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Revenue operations & technical systems leader.</h1>
        <p class="mt-5 text-lg leading-relaxed text-muted">I build the commercial processes, delivery infrastructure, and software that help teams turn growth into work they can reliably deliver. My background spans industrial services, national field programs, and hands-on application development.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="focus-ring inline-flex items-center justify-center rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-white transition hover:bg-accent-dark" href={resumeUrl} download="Eric Martin Resume - October.pdf">Download resume (PDF)</a>
          <a class="focus-ring inline-flex items-center justify-center rounded-lg border border-border bg-white px-5 py-3 text-sm font-semibold text-ink transition hover:border-accent" href="/contact">Get in touch</a>
        </div>
        <p class="mt-3 text-sm text-muted">Web overview updated October 25, 2026. The download is the supplied October resume PDF. See <a class="focus-ring font-semibold text-accent hover:text-accent-dark" href="/abs-tooling">ABS Tooling</a> for the latest platform detail.</p>
      </div>

      <nav aria-label="Resume sections" class="mt-9 flex flex-wrap gap-x-6 gap-y-3 border-y border-border py-4 text-sm font-semibold text-accent">
        <a class="focus-ring hover:text-accent-dark" href="#experience">Experience</a>
        <a class="focus-ring hover:text-accent-dark" href="#skills">Skills</a>
        <a class="focus-ring hover:text-accent-dark" href="#selected-systems">Selected systems</a>
        <a class="focus-ring hover:text-accent-dark" href="#resume-pdf">PDF preview</a>
      </nav>

      <section id="experience" class="mt-12" aria-labelledby="experience-heading">
        <h2 id="experience-heading" class="text-2xl font-semibold text-ink">Professional experience</h2>
        <div class="mt-6 space-y-6">
          {experience.map((job) => (
            <article class="surface grid gap-5 p-6 sm:p-8 lg:grid-cols-[250px_minmax(0,1fr)] lg:gap-8">
              <div>
                <p class="eyebrow">{job.dates}</p>
                <h3 class="mt-3 text-xl font-semibold text-ink">{job.role}</h3>
                <p class="mt-2 font-semibold text-ink">{job.company}</p>
                <p class="mt-1 text-sm text-muted">{job.location}</p>
              </div>
              <div>
                <ul class="list-disc space-y-3 pl-5 text-sm leading-relaxed text-muted">
                  {job.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
                {job.href && <a class="focus-ring mt-5 inline-flex text-sm font-semibold text-accent hover:text-accent-dark" href={job.href}>{job.linkLabel} →</a>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="skills" class="mt-12" aria-labelledby="skills-heading">
        <h2 id="skills-heading" class="text-2xl font-semibold text-ink">Skills in practice</h2>
        <div class="mt-6 grid gap-5 md:grid-cols-2">
          {skillGroups.map((group) => (
            <div class="surface-muted p-6">
              <h3 class="text-lg font-semibold text-ink">{group.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{group.skills}</p>
            </div>
          ))}
        </div>
        <a class="focus-ring mt-5 inline-flex text-sm font-semibold text-accent hover:text-accent-dark" href="/skills">See how these skills connect to the work →</a>
      </section>

      <section id="selected-systems" class="mt-12" aria-labelledby="systems-heading">
        <h2 id="systems-heading" class="text-2xl font-semibold text-ink">Selected systems</h2>
        <p class="mt-3 max-w-2xl text-muted">The implementation detail behind the experience: workflows, technical decisions, and what each build is designed to do.</p>
        <div class="mt-6 grid gap-5 md:grid-cols-2">
          {systems.map((system) => (
            <article class="surface flex flex-col p-6">
              <h3 class="text-lg font-semibold text-ink">{system.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{system.description}</p>
              <a class="focus-ring mt-5 inline-flex text-sm font-semibold text-accent hover:text-accent-dark" href={system.href} aria-label={`${system.label}: ${system.title}`}>{system.label} →</a>
            </article>
          ))}
        </div>
      </section>

      <section id="resume-pdf" class="mt-12" aria-labelledby="pdf-heading">
        <h2 id="pdf-heading" class="text-2xl font-semibold text-ink">Resume PDF</h2>
        <details class="surface mt-5 p-5 sm:p-6">
          <summary class="focus-ring cursor-pointer font-semibold text-accent">Preview the October 2026 resume</summary>
          <p class="mt-4 text-sm text-muted">You can also <a class="focus-ring font-semibold text-accent hover:text-accent-dark" href={resumeUrl}>open the PDF directly</a> or use the download link above.</p>
          <object data={resumeUrl} type="application/pdf" title="Eric Martin resume, October 2026" class="mt-5 h-[65vh] min-h-[360px] w-full rounded-xl border border-border bg-panel">
            <p class="p-5 text-sm text-muted">Your browser cannot display this PDF. <a class="focus-ring font-semibold text-accent" href={resumeUrl}>Open the resume PDF</a>.</p>
          </object>
        </details>
      </section>
    </div>
  </section>
</Base>
