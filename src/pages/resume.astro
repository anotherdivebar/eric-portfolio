---
import Base from "../layouts/Base.astro";

const resumeUrl = "/Resume%20-%20Eric%20Martin.pdf";

const experience = [
  {
    role: "Founder & Principal Systems Architect",
    company: "Atlas-Beren Systems",
    location: "Newton, KS / Remote",
    dates: "Jan 2026 – Present",
    bullets: [
      "Founded Atlas-Beren Systems for trade and field-service businesses. Own product direction, design, and full-stack engineering for ABS Console and its seven connected modules.",
      "Built the customer workflow from prospect research and CRM through estimates, projects, field delivery, invoicing, and shared profit reporting.",
      "Developed offline field tools, a customer portal, and a 13-week simulator that compares proposed jobs against cash, qualified labor, and materials.",
      "Architected the platform with Next.js, React, TypeScript, and Supabase Postgres, with organization-scoped access, reviewed AI actions, source-linked answers, and usage controls.",
      "Built migration, encrypted backup, and isolated restore tooling. Provider integrations and production disaster recovery remain subject to live acceptance; the full case study documents the current scope."
    ],
    href: "/abs-tooling",
    linkLabel: "Explore the ABS Console case study"
  },
  {
    role: "Director, Business Development & Technical Systems",
    company: "Kansas Electric, Inc.",
    location: "Newton, KS",
    dates: "Oct 2024 – Dec 2025",
    bullets: [
      "Built the company's dedicated sales function, taking commercial responsibilities off project managers and establishing account development, follow-up, pipeline reviews, and forecasting.",
      "Closed approximately $2M in new work in my first 60 days. Separately, developed a commercial motion tied to $100M+ in presented 2025 opportunities and $200M+ in forward pipeline over 24 months; those figures are distinct from closed work.",
      "Won a Walmart emergency lighting and relay engagement across the Midwest and Southeast through relationships developed at Vale. Owned the customer relationship and oversaw the project managers delivering the work.",
      "Assumed Director of Marketing responsibilities: led the rebrand, website, signage, billboards, and campaigns with approximately $5,000 in monthly ad spend. Also supported recruiting.",
      "Built CRM, estimating, offline field reporting, and planning tools. The estimating app reduced estimating time by approximately 50–60% and improved accuracy by approximately 25%."
    ],
    href: "/work/kansas-electric",
    linkLabel: "Explore sales, marketing, and systems at Kansas Electric"
  },
  {
    role: "Head of Strategic Operations",
    company: "Vale Field Services",
    location: "Remote",
    dates: "Jul 2019 – Oct 2024",
    bullets: [
      "Joined as employee one, performing field work and developing customer relationships, then grew into leading business operations outside finance as the company reached 35 employees and approximately $4M in annual revenue.",
      "Managed four field supervisors within a team that included 29 field technicians and admin/support staff; built processes, vendor networks, training, quality assurance, and delivery infrastructure.",
      "Led POS and technology rollouts across the U.S. and Canada, typically covering hundreds of stores. Restaurant work included Taco Bell, Dairy Queen, Scooter's, McDonald's, and KFC locations.",
      "Owned operating frameworks across onboarding, project planning, dispatch, subcontractor management, field execution, issue resolution, invoicing readiness, and post-work quality follow-through.",
      "Identified feasibility constraints, site-readiness gaps, and installation risks before rollout; created SOPs, escalation paths, training materials, and operating cadences for distributed work."
    ],
    href: "/work/program-delivery-at-scale",
    linkLabel: "Explore the growth of Vale's operations"
  }
];

const skillGroups = [
  { title: "Sales & sustainable growth", skills: "Relationship-based sales, consultative discovery, solution positioning, account development, sales strategy, marketing, pipeline and forecasting, and customer follow-through." },
  { title: "Delivery & systems", skills: "Process architecture, cross-functional leadership, implementation and rollout, product operations, approval workflows, and AI-enabled automation." },
  { title: "Engineering", skills: "JavaScript, TypeScript, React, Next.js, Node.js, Python, C# / .NET, SQL, PostgreSQL, Supabase, REST APIs, React Query, and Zod." },
  { title: "Quality & infrastructure", skills: "Vitest, Playwright, GitHub CI/CD, Vercel, Vercel AI Gateway, Google Cloud, Vertex AI, row-level security, OCR, and vision workflows." }
];

const systems = [
  { title: "ABS Console", description: "Connected CRM-to-payment workflows, customer self-service, shared profit reporting, business simulation, reviewed migration, and recovery tooling.", href: "/abs-tooling", label: "Read the full build" },
  { title: "Atlas-Beren Systems Website", description: "Product positioning, interactive workflow demonstrations, inclusive pricing, and validated inquiries for software and services.", href: "/technical-projects/atlas-beren-website", label: "Explore the website build" },
  { title: "Kansas Electric", description: "Contractor and business-owner relationship development, supported by a dedicated sales and marketing function and tools for consistent follow-through.", href: "/work/kansas-electric", label: "Read the case study" },
];
---

<Base title="Resume - Eric Martin" description="Eric Martin's experience in relationship-based sales, business development, operational leadership, and technical systems. Read the career overview or download the latest resume.">
  <section class="page-heading">
    <div class="page-container">
      <div class="max-w-4xl">
        <p class="eyebrow">Resume / Eric Martin</p>
        <h1 class="page-title mt-5">Business development & growth leader.</h1>
        <p class="page-intro mt-7">I grow revenue through relationship-based sales: understand the customer's problem, connect it to the right solution, and follow through into delivery. My background combines commercial ownership, national field operations, and hands-on software engineering.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="button-primary" href={resumeUrl} download="Resume - Eric Martin.pdf">Download resume <span class="text-white/70">PDF ↓</span></a>
          <a class="button-secondary" href="/contact">Get in touch <span aria-hidden="true">↗</span></a>
        </div>
          <p class="mt-4 max-w-2xl text-xs leading-relaxed text-muted">Web overview updated November 3, 2026. The PDF is a separate downloadable version. See <a class="focus-ring font-semibold text-accent hover:text-accent-dark" href="/abs-tooling">ABS Console</a> for detailed product and engineering work.</p>
      </div>

      <section class="resume-evidence mt-12 grid gap-8 rounded-xl p-7 sm:mt-16 sm:p-10 md:grid-cols-2 md:gap-12" aria-label="Selected sales and growth results">
        <div>
          <p class="eyebrow">Kansas Electric</p>
          <p class="mt-5 text-5xl font-medium tracking-tight text-accent sm:text-6xl">~$2M</p>
          <p class="mt-3 font-semibold">closed in my first 60 days.</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">Developed relationships with industrial and commercial contractors and business owners, supported by a dedicated sales function and ongoing account development.</p>
          <a class="text-link mt-5" href="/work/kansas-electric">Read the sales story <span aria-hidden="true">↗</span></a>
        </div>
        <div class="border-t border-border pt-8 md:border-l md:border-t-0 md:pl-12 md:pt-0">
          <p class="eyebrow">Vale Field Services</p>
          <p class="mt-5 text-5xl font-medium tracking-tight text-accent sm:text-6xl">~$4M</p>
          <p class="mt-3 font-semibold">in annual revenue at a company I helped grow.</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">Progressed from employee one to leading operations for 35 employees, connecting customer relationships with delivery at national scale.</p>
          <a class="text-link mt-5" href="/work/program-delivery-at-scale">Read the growth story <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <nav aria-label="Resume sections" class="section-nav mt-10">
        <a class="focus-ring hover:text-accent-dark" href="#experience">Experience</a>
        <a class="focus-ring hover:text-accent-dark" href="#skills">Skills</a>
        <a class="focus-ring hover:text-accent-dark" href="#selected-systems">Selected systems</a>
        <a class="focus-ring hover:text-accent-dark" href="#resume-pdf">PDF preview</a>
      </nav>

      <section id="experience" class="section-space" aria-labelledby="experience-heading">
        <p class="eyebrow">Career overview</p>
        <h2 id="experience-heading" class="mt-4 text-3xl font-semibold text-ink sm:text-4xl">Professional experience</h2>
        <div class="mt-10">
          {experience.map((job) => (
            <article class="experience-entry grid gap-6 border-t border-border py-9 lg:grid-cols-[270px_minmax(0,1fr)] lg:gap-14 lg:py-10">
              <div>
                <p class="eyebrow">{job.dates}</p>
                <h3 class="mt-4 text-2xl font-semibold text-ink">{job.role}</h3>
                <p class="mt-4 font-semibold text-ink">{job.company}</p>
                <p class="mt-1 text-sm text-muted">{job.location}</p>
              </div>
              <div>
                <ul class="experience-bullets space-y-4 text-sm leading-relaxed text-muted">
                  {job.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
                {job.href && <a class="text-link mt-6" href={job.href}>{job.linkLabel} <span aria-hidden="true">↗</span></a>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="skills" aria-labelledby="skills-heading">
        <p class="eyebrow">Capabilities</p>
        <h2 id="skills-heading" class="mt-4 text-3xl font-semibold text-ink sm:text-4xl">Skills in practice</h2>
        <div class="mt-8 grid gap-x-12 gap-y-7 md:grid-cols-2">
          {skillGroups.map((group) => (
            <div class="border-t border-border pt-5">
              <h3 class="text-lg font-semibold text-ink">{group.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{group.skills}</p>
            </div>
          ))}
        </div>
        <a class="text-link mt-7" href="/skills">See how these skills connect to the work <span aria-hidden="true">↗</span></a>
      </section>

      <section id="selected-systems" class="section-space" aria-labelledby="systems-heading">
        <p class="eyebrow">From strategy to implementation</p>
        <h2 id="systems-heading" class="mt-4 text-3xl font-semibold text-ink sm:text-4xl">Selected systems</h2>
        <p class="mt-3 max-w-2xl text-muted">The implementation detail behind the experience: workflows, technical decisions, and what each build is designed to do.</p>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {systems.map((system) => (
            <article class="surface flex flex-col p-6">
              <h3 class="text-lg font-semibold text-ink">{system.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{system.description}</p>
              <a class="text-link mt-5" href={system.href} aria-label={`${system.label}: ${system.title}`}>{system.label} <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </section>

      <section id="resume-pdf" class="border-t border-border pt-8" aria-labelledby="pdf-heading">
        <h2 id="pdf-heading" class="text-2xl font-semibold text-ink">Resume PDF</h2>
        <details class="surface-muted mt-5 p-5 sm:p-7" data-resume-preview>
          <summary class="focus-ring cursor-pointer font-semibold text-accent">Preview the resume <span class="ml-2 text-xs font-normal text-muted">PDF</span></summary>
          <p class="mt-4 text-sm text-muted">You can also <a class="focus-ring font-semibold text-accent hover:text-accent-dark" href={resumeUrl}>open the PDF directly</a> or use the download link above.</p>
          <template>
            <object data={resumeUrl} type="application/pdf" title="Eric Martin resume" class="mt-5 h-[65vh] min-h-[360px] w-full rounded-xl border border-border bg-panel">
              <p class="p-5 text-sm text-muted">Your browser cannot display this PDF. <a class="focus-ring font-semibold text-accent" href={resumeUrl}>Open the resume PDF</a>.</p>
            </object>
          </template>
          <noscript><p class="mt-4 text-sm"><a class="text-link" href={resumeUrl}>Open the resume PDF</a></p></noscript>
        </details>
      </section>
    </div>
  </section>
</Base>
<script>
  const preview = document.querySelector<HTMLDetailsElement>('[data-resume-preview]');
  preview?.addEventListener('toggle', () => {
    const template = preview.querySelector('template');
    if (preview.open && template) template.replaceWith(template.content.cloneNode(true));
  });
</script>

<style>
  .resume-evidence { background: #eaf0e5; border: 1px solid #d9e3d3; }
  .experience-bullets li { display: flex; gap: 12px; }
  .experience-bullets li::before { content: ""; flex-shrink: 0; width: 4px; height: 4px; margin-top: 9px; border-radius: 50%; background: #176958; }
</style>
