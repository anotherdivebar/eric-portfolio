---
import Base from "../layouts/Base.astro";
import OptimizedImage from "../components/OptimizedImage.astro";

const headshotUrl = "/eric%202026%20headshot.png";

const principles = [
  { title: "Ask what needs to change", body: "I ask what the customer is trying to do, where the work gets stuck, and what that costs them." },
  { title: "Agree on the next step", body: "I explain how our service fits the job and agree with the customer on what each of us will do next." },
  { title: "Stay involved after the sale", body: "I make sure the delivery team knows what we promised and that the customer knows whom to call if something changes." },
  { title: "Plan around the field team", body: "Before committing to a schedule, I consider who can do the work and what they’ll need on site." }
];
---

<Base title="About Eric Martin | Sales and Business Development" description="Eric Martin’s career in field operations, business development, and software for the trades.">
  <section class="page-heading">
    <div class="page-container">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-20">
        <div>
          <p class="eyebrow">About Eric Martin</p>
          <h1 class="page-title mt-5">I started in the field.</h1>
          <p class="page-intro mt-7">
            Before I worked in sales, I installed technology in restaurants. I know what it’s like to arrive at a job and depend on details someone else agreed to.
          </p>
          <p class="mt-5 max-w-2xl leading-relaxed text-muted">
            At Vale Field Services, I went from working on site to running operations as the business grew to about $4M in annual revenue. At Kansas Electric, I built the sales and marketing function and worked directly with contractors and business owners.
          </p>
          <p class="mt-5 max-w-2xl leading-relaxed text-muted">
            In January 2026, I founded Atlas-Beren Systems to build software for trade and field-service businesses. I design and develop its main product, ABS Console.
          </p>
          <a class="text-link mt-7" href="/resume">View my experience <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="max-w-[300px] lg:self-start lg:pt-12">
          <div class="portrait-frame">
            <OptimizedImage src={headshotUrl} alt="Eric Martin" width="400" height="500" sizes="280px" loading="eager" class="aspect-[4/5] h-auto w-full rounded-lg object-cover" />
          </div>
          <figcaption class="mt-5 flex items-center justify-between gap-4 text-xs text-muted"><span>Eric Martin</span></figcaption>
        </figure>
      </div>

      <section class="section-space mt-8 border-t border-border" aria-labelledby="background-heading">
        <h2 id="background-heading" class="max-w-2xl text-3xl font-semibold text-ink sm:text-4xl">Where I’ve worked</h2>
        <div class="mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
          <article class="flex flex-col border-t border-border pt-6">
            <p class="text-sm font-semibold text-accent">Founder, Atlas-Beren Systems · 2026–Present</p>
            <h3 class="mt-4 text-xl font-semibold text-ink">Building software for the trades</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">I built seven modules around the life of a job. A team can research a prospect, record the sale, plan the work, and track what gets billed.</p>
            <a class="text-link mt-6" href="/abs-tooling">Inside ABS Console <span aria-hidden="true">↗</span></a>
          </article>
          <article class="flex flex-col border-t border-border pt-6">
            <p class="text-sm font-semibold text-accent">Kansas Electric · 2024–2025</p>
            <h3 class="mt-4 text-xl font-semibold text-ink">Winning electrical work</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">I worked with industrial and commercial customers, led the company rebrand, and stayed involved after the sale. On Walmart’s lighting project, I oversaw the project managers delivering the work.</p>
            <a class="text-link mt-6" href="/work/kansas-electric">Kansas Electric case study <span aria-hidden="true">↗</span></a>
          </article>
          <article class="flex flex-col border-t border-border pt-6">
            <p class="text-sm font-semibold text-accent">Vale Field Services · 2019–2024</p>
            <h3 class="mt-4 text-xl font-semibold text-ink">Leading restaurant installations</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">I was Vale’s first employee. By the time we had 35 people, I managed four field supervisors and led restaurant technology rollouts across the U.S. and Canada.</p>
            <a class="text-link mt-6" href="/work/program-delivery-at-scale">Vale Field Services case study <span aria-hidden="true">↗</span></a>
          </article>
        </div>
      </section>

      <section class="surface-muted p-7 sm:p-10 lg:p-12" aria-labelledby="approach-heading">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
          <div>
            <h2 id="approach-heading" class="text-3xl font-semibold text-ink sm:text-4xl">What I pay attention to</h2>
          </div>
          <div class="grid gap-7 sm:grid-cols-2">
          {principles.map((principle) => (
            <div class="border-t border-border pt-5">
              <h3 class="text-lg font-semibold text-ink">{principle.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{principle.body}</p>
            </div>
          ))}
          </div>
        </div>
      </section>

      <div class="section-space grid gap-10 md:grid-cols-2 md:gap-20">
        <div>
          <h2 class="text-2xl font-semibold text-ink">Outside of work</h2>
          <p class="mt-3 leading-relaxed text-muted">I live with my fiancée, our son, two dogs, a cat, and a ferret. I spend my free time with my family, making music, or out for a run.</p>
        </div>
        <div>
          <h2 class="text-2xl font-semibold text-ink">Where I fit</h2>
          <p class="mt-3 leading-relaxed text-muted">I’m interested in sales and business development roles where I can build customer accounts and work closely with the people who deliver the job.</p>
          <a class="text-link mt-5" href="/contact">Start a conversation <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .portrait-frame { position: relative; padding: 12px; border: 1px solid #d4ded5; border-radius: 14px; background: #e6ede2; }
  .portrait-frame::before { content: ""; position: absolute; width: 66px; height: 66px; right: -16px; top: -16px; border-top: 1px solid #176958; border-right: 1px solid #176958; border-top-right-radius: 18px; }
</style>
