---
import Base from "../layouts/Base.astro";

const headshotUrl = "/eric%202026%20headshot.png";

const principles = [
  { title: "Listen for the real problem", body: "Understand what the prospect is trying to accomplish, where the current approach falls short, and what the problem means for the business." },
  { title: "Make the connection clear", body: "Tie a service, capability, or technical solution to that specific need. Explain the value in the customer's terms and agree on a practical next step." },
  { title: "Own the follow-through", body: "Stay accountable to the relationship as the work moves from a sales conversation to delivery. Clear scope, communication, and issue resolution matter after the agreement." },
  { title: "Build for lasting growth", body: "Connect sales activity to the team's ability to execute. Build the processes and tools that keep customer context and commitments visible as the business grows." }
];
---

<Base title="About Eric Martin — Sales & Business Development Leadership" description="Meet Eric Martin: a sales and business development leader and founder of Atlas-Beren Systems, with experience growing customer relationships, revenue, and delivery capacity.">
  <section class="page-heading">
    <div class="page-container">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-20">
        <div>
          <p class="eyebrow">Eric Martin · Sales & business development leadership</p>
          <h1 class="page-title mt-5">Growth starts with understanding people and their problems.</h1>
          <p class="page-intro mt-7">
            I lead growth by understanding what a customer needs to accomplish,
            connecting that need to the right solution, and building the sales
            process and delivery capacity to follow through.
          </p>
          <p class="mt-5 max-w-2xl leading-relaxed text-muted">
            I have done that from the field, in business development, and while
            leading operations. I helped grow Vale Field Services from startup
            stage to approximately $4M in annual revenue, then built Kansas
            Electric's sales and marketing function and closed approximately $2M
            in new work in my first 60 days.
          </p>
          <p class="mt-5 max-w-2xl leading-relaxed text-muted">
            In January 2026, I founded Atlas-Beren Systems. I own the product
            direction, design, and full-stack engineering behind ABS Console,
            bringing my sales and operations experience into a platform for
            trade and field-service businesses.
          </p>
          <a class="text-link mt-7" href="/resume">View my experience <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="max-w-[300px] lg:self-start lg:pt-12">
          <div class="portrait-frame">
            <img src={headshotUrl} alt="Eric Martin" width="400" height="500" class="aspect-[4/5] w-full rounded-lg object-cover" decoding="async" />
          </div>
          <figcaption class="mt-5 flex items-center justify-between gap-4 text-xs text-muted"><span>Eric Martin</span><span>Relationships → Results</span></figcaption>
        </figure>
      </div>

      <section class="section-space mt-8 border-t border-border" aria-labelledby="background-heading">
        <p class="eyebrow">The experience behind my approach</p>
        <h2 id="background-heading" class="mt-4 max-w-2xl text-3xl font-semibold text-ink sm:text-4xl">From the first conversation to delivered work.</h2>
        <div class="mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
          <article class="flex flex-col border-t border-border pt-6">
            <p class="text-sm font-semibold text-accent">Founder, Atlas-Beren Systems · 2026–Present</p>
            <h3 class="mt-4 text-xl font-semibold text-ink">Building for the whole customer relationship</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">I founded ABS and built its seven-module Console to connect prospect research and sales with projects, operations, and finance. I own the product from business problem through working software.</p>
            <a class="text-link mt-6" href="/abs-tooling">Inside ABS Console <span aria-hidden="true">↗</span></a>
          </article>
          <article class="flex flex-col border-t border-border pt-6">
            <p class="text-sm font-semibold text-accent">Kansas Electric · 2024–2025</p>
            <h3 class="mt-4 text-xl font-semibold text-ink">Building a sales function</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">I built the sales and marketing function and won a Walmart project through relationships developed at Vale. I owned the customer relationship and oversaw the project managers delivering the work.</p>
            <a class="text-link mt-6" href="/work/kansas-electric">Kansas Electric case study <span aria-hidden="true">↗</span></a>
          </article>
          <article class="flex flex-col border-t border-border pt-6">
            <p class="text-sm font-semibold text-accent">Vale Field Services · 2019–2024</p>
            <h3 class="mt-4 text-xl font-semibold text-ink">Relationships & delivery</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">I joined Vale Field Services as employee one, doing field work and building relationships, then grew into leading operations for 35 employees and restaurant technology rollouts across the U.S. and Canada.</p>
            <a class="text-link mt-6" href="/work/program-delivery-at-scale">Vale Field Services case study <span aria-hidden="true">↗</span></a>
          </article>
        </div>
      </section>

      <section class="surface-muted p-7 sm:p-10 lg:p-12" aria-labelledby="approach-heading">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
          <div>
            <p class="eyebrow">How I work</p>
            <h2 id="approach-heading" class="mt-4 text-3xl font-semibold text-ink sm:text-4xl">Trust, relevance, and follow-through.</h2>
          </div>
          <div class="grid gap-7 sm:grid-cols-2">
          {principles.map((principle) => (
            <div class="border-t border-border pt-5">
              <h3 class="text-lg font-semibold text-ink">{principle.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{principle.body}</p>
            </div>
          ))}
          </div>
        </div>
      </section>

      <div class="section-space grid gap-10 md:grid-cols-2 md:gap-20">
        <div>
          <h2 class="text-2xl font-semibold text-ink">Outside of work</h2>
          <p class="mt-3 leading-relaxed text-muted">I share life with my fiancée, our son, two dogs, a cat, and a ferret. I spend my time making and playing music, running, and being with my family.</p>
        </div>
        <div>
          <h2 class="text-2xl font-semibold text-ink">Where I fit</h2>
          <p class="mt-3 leading-relaxed text-muted">I bring sales and business development leadership to teams that need to build customer relationships and turn the right opportunities into revenue. My operational and technical experience helps me connect the sales promise to a practical delivery plan and the systems to support it.</p>
          <a class="text-link mt-5" href="/contact">Start a conversation <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .portrait-frame { position: relative; padding: 12px; border: 1px solid #d4ded5; border-radius: 14px; background: #e6ede2; }
  .portrait-frame::before { content: ""; position: absolute; width: 66px; height: 66px; right: -16px; top: -16px; border-top: 1px solid #176958; border-right: 1px solid #176958; border-top-right-radius: 18px; }
</style>
