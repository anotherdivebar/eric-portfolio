---
import OptimizedImage from "./OptimizedImage.astro";
const steps = [
  {
    title: "Research the account.",
    description: "Save the company’s website, the source of the lead, and a question to check with the buyer.",
    href: "#prospecting",
    link: "Explore prospect research",
  },
  {
    title: "Agree on the scope.",
    description: "Write down what the customer agreed to, who will call next, and which project the sale belongs to.",
    href: "#crm",
    link: "Explore CRM & sales",
  },
  {
    title: "Turn the estimate into a job.",
    description: "Create an estimate from the project. Once the customer approves it, the crew can record progress and costs on the job.",
    href: "#projects",
    link: "Explore project delivery",
  },
  {
    title: "Compare revenue and costs.",
    description: "Invoice the job and compare what you billed with its labor, materials, and other recorded costs.",
    href: "#financial",
    link: "Explore financial visibility",
  },
];
---
<section id="customer-journey" class="section-space page-container" aria-labelledby="connected-heading">
  <h2 id="connected-heading" class="section-title">From first contact<br />to invoice.</h2>
  <ol class="workflow-steps" aria-label="From prospect research to invoiced work">
    {steps.map((step) => <li><h3>{step.title}</h3><p class="workflow-description">{step.description}</p><a href={step.href}>{step.link}<span aria-hidden="true"> ↗</span></a></li>)}
  </ol>
  <div class="workflow-screens">
    <figure>
      <a class="workflow-capture sales-capture" href="/assets/abs-console/sales-pipeline.png" aria-label="View the full-size ABS Console sales demo screenshot"><OptimizedImage src="/assets/abs-console/sales-pipeline.png" alt="Cropped ABS Console demo sales view showing forecast coverage, a follow-up queue, and opportunities arranged by stage" width="1265" height="1523" loading="lazy" decoding="async" /><span class="capture-label">Sales workspace · Demo</span></a>
      <figcaption><h3>Sales pipeline and follow-ups</h3><p>The demo has 30 open deals, all awaiting estimates. Its weighted forecast stays at $0 until a deal has a price.</p><a href="/assets/abs-console/sales-pipeline.png">View the sales screenshot <span aria-hidden="true">↗</span></a></figcaption>
    </figure>
    <figure>
      <a class="workflow-capture operations-capture" href="/assets/abs-console/operations-dashboard.png" aria-label="View the full-size ABS Console operations demo screenshot"><OptimizedImage src="/assets/abs-console/operations-dashboard.png" alt="Cropped ABS Console demo operations view showing connected estimates, field work, financials, and delivery priorities" width="1265" height="1991" loading="lazy" decoding="async" /><span class="capture-label">Operations workspace · Demo</span></a>
      <figcaption><h3>Estimates and field jobs</h3><p>The demo flags a rooftop unit due for maintenance with no open work order. The alert offers to create the missing order.</p><a href="/assets/abs-console/operations-dashboard.png">View the operations screenshot <span aria-hidden="true">↗</span></a></figcaption>
    </figure>
    <figure>
      <a class="workflow-capture mobile-capture" href="/assets/abs-console/today-mobile.png" aria-label="View the full-size ABS Console mobile demo screenshot"><OptimizedImage src="/assets/abs-console/today-mobile.png" alt="ABS Console Today view with daily priorities on a phone" width="375" height="1859" sizes="165px" /><span class="capture-label">Mobile workspace · Demo</span></a>
      <figcaption><h3>Today on mobile</h3><p>The phone view opens customer records, project tasks, and sales follow-ups. In the demo, you can also start a practice estimate.</p><a href="/assets/abs-console/today-mobile.png">View the mobile screenshot <span aria-hidden="true">↗</span></a></figcaption>
    </figure>
  </div>
</section>
<style>
  .workflow-steps { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); margin-top: 30px; border: 1px solid #dce3dc; border-radius: 16px; overflow: hidden; background: #fff; }
  .workflow-steps > li { display: flex; flex-direction: column; padding: 26px 23px; min-width: 0; }
  .workflow-steps > li + li { border-left: 1px solid #dce3dc; }
  .workflow-steps h3 { font-size: 1.2rem; font-weight: 550; line-height: 1.25; letter-spacing: -.025em; }
  .workflow-description { margin-top: 13px; color: #5d6a63; font-size: .9rem; line-height: 1.65; margin-bottom: 16px; }
  .workflow-steps a { margin-top: auto; padding-top: 12px; border-top: 1px solid #e6ebe3; color: #176958; font-size: .72rem; line-height: 1.6; font-weight: 550; }
  .workflow-steps a:hover, figcaption a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .workflow-screens { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24px; margin-top: 28px; }
  figure { min-width: 0; border: 1px solid #dce3dc; border-radius: 16px; overflow: hidden; background: #edf1e9; }
  .workflow-capture { display: block; position: relative; aspect-ratio: 1.55; overflow: hidden; border-bottom: 1px solid #dce3dc; background: #f3f7f7; }
  .workflow-capture :global(img) { position: absolute; width: 125%; max-width: none; height: auto; left: -25%; }
  .mobile-capture :global(img) { width: min(55%, 165px); left: 50%; top: 8%; transform: translateX(-50%); border: 4px solid #152e27; border-radius: 14px; }
  .sales-capture :global(img) { top: -66%; }
  .operations-capture :global(img) { top: -49%; }
  .capture-label { position: absolute; bottom: 12px; left: 12px; padding: 6px 10px; border: 1px solid #b8cdbb; border-radius: 5px; background: #f6f7f3; color: #415c4c; font-size: .6rem; line-height: 1.4; box-shadow: 0 2px 8px rgb(23 35 31 / 6%); }
  figcaption { padding: 22px 24px; }
  figcaption h3 { font-size: 1.05rem; font-weight: 550; line-height: 1.4; }
  figcaption p { margin-top: 10px; color: #5d6a63; font-size: .78rem; line-height: 1.75; }
  figcaption strong { font-weight: 600; color: #415c4c; }
  figcaption a { display: inline-block; margin-top: 15px; font-size: .72rem; color: #176958; font-weight: 550; }
  @media (max-width: 1023px) { .workflow-steps { grid-template-columns: repeat(2,minmax(0,1fr)); } .workflow-steps > li:nth-child(3) { border-left: 0; } .workflow-steps > li:nth-child(n+3) { border-top: 1px solid #dce3dc; } }
  @media (max-width: 700px) { .workflow-screens { grid-template-columns: 1fr; gap: 20px; } .workflow-steps > li { padding: 22px 20px; } .workflow-steps h3 { font-size: 1.12rem; } }
  @media (max-width: 480px) { .workflow-steps { grid-template-columns: 1fr; } .workflow-steps > li + li { border-left: 0; border-top: 1px solid #dce3dc; } figcaption { padding: 20px; } }
</style>
